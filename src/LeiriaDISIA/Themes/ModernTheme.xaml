    <!-- Label -->
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <!-- ====== BADGES DE ESTADO/CLASSIFICAÇÃO (colunas de datagrid com cor) ======
         Substituem os antigos indicadores "bolinha + texto" / "quadradinho + texto".
         BadgePillStyle: para dados que antes tinham uma bolinha (Ellipse) — cantos totalmente arredondados.
         BadgeRectStyle: para dados que antes tinham um quadradinho (Rectangle) — cantos praticamente retos.
         As legendas (Ellipse/Rectangle + texto explicativo, fora do datagrid) mantêm-se inalteradas. -->
    <Style x:Key="BadgePillStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BadgeRectStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ====== ESTILOS PARA GARANTIR TEXTO BRANCO EM FUNDOS AZUIS ====== -->

    <!-- Style para DataGridCell quando está em linha selecionada (fundo azul) -->
    <Style TargetType="DataGridCell" x:Key="DataGridCellSelectedStyle">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- (9.2) Estilo padrão para Button (ao lado de PrimaryButton). Antes usava Background=BrushCard
         (branco), o que o tornava quase invisível sobre os cards/fundo claro da aplicação — trocado
         por um tom claro da cor primária, para ficar sempre claramente identificável como botão. -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="#E1E9F4" />
        <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BorderThickness" Value="1.2" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#CBD9EE" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource BrushNeutral}" />
                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                <Setter Property="BorderBrush" Value="{StaticResource BrushNeutral}" />
            </Trigger>
        </Style.Triggers>
    </Style>

