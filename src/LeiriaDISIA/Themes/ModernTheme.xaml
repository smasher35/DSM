    <!-- TabItem - Administração -->
    <Style x:Key="AdminTabItem" TargetType="TabItem">
        <Setter Property="Background" Value="{StaticResource BrushAdminTabBackground}" />
        <Setter Property="Foreground" Value="{StaticResource BrushAdminTabText}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="BorderTab" Background="{StaticResource BrushAdminTabBackground}" BorderThickness="0" CornerRadius="4,4,0,0" Padding="16,8" TextElement.Foreground="{StaticResource BrushAdminTabText}">
                        <ContentPresenter x:Name="ContentPresenterTab" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" TextElement.Foreground="{StaticResource BrushAdminTabText}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="BorderTab" Property="Background" Value="{StaticResource BrushAdminTabSelectedBackground}" />
                            <Setter TargetName="BorderTab" Property="TextElement.Foreground" Value="{StaticResource BrushAdminTabSelectedText}" />
                            <Setter TargetName="ContentPresenterTab" Property="TextElement.Foreground" Value="{StaticResource BrushAdminTabSelectedText}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushAdminTabSelectedText}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Cursor" Value="Hand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

