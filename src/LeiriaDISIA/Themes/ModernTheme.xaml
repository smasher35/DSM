<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:services="clr-namespace:LeiriaDISIA.Services">

    <!-- ====== PALETA LIGHT MODE (Modo Claro Moderno) ====== -->
    <SolidColorBrush x:Key="BrushPrimary" Color="#1F4E79" />
    <SolidColorBrush x:Key="BrushPrimaryDark" Color="#173A56" />
    <SolidColorBrush x:Key="BrushAccent" Color="#2AB7CA" />
    <SolidColorBrush x:Key="BrushBackground" Color="#F4F6F9" />
    <SolidColorBrush x:Key="BrushCard" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#1E293B" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#64748B" />
    <SolidColorBrush x:Key="BrushSuccess" Color="#10B981" />
    <SolidColorBrush x:Key="BrushWarning" Color="#F59E0B" />
    <SolidColorBrush x:Key="BrushDanger" Color="#EF4444" />
    <!-- Item 3.1: destaque do "Nº de Vezes Intervencionado" — vermelho claro/profissional em vez
         do rosa saturado usado antes. Fundo pastel + texto vermelho escuro dá contraste suficiente
         (WCAG AA) sem parecer um erro/alerta agressivo. -->
    <SolidColorBrush x:Key="BrushDangerBackgroundLight" Color="#FDECEC" />
    <SolidColorBrush x:Key="BrushDangerTextDark" Color="#B42318" />
    <SolidColorBrush x:Key="BrushPurple" Color="#8B5CF6" />
    <SolidColorBrush x:Key="BrushNeutral" Color="#D1D5DB" />
    <SolidColorBrush x:Key="BrushBorder" Color="#E2E8F0" />
    <SolidColorBrush x:Key="BrushInputBackground" Color="#FFFFFF" />
    <!-- Borda dos campos de inserção (TextBox/ComboBox/PasswordBox/DatePicker): mais visível do
         que BrushBorder, para os campos se destacarem claramente do fundo em todas as janelas. -->
    <SolidColorBrush x:Key="BrushInputBorder" Color="#94A3B8" />
    <SolidColorBrush x:Key="BrushInputBorderFoco" Color="#1F4E79" />

    <!-- ====== SOBREPOSIÇÃO DE CORES INTERNAS DO MODERNWPFUI ======
         Os controlos TextBox/PasswordBox/ComboBox desta aplicação usam os templates do
         ModernWpfUI, que NÃO leem as propriedades normais Background/BorderBrush do controlo -
         o template lê diretamente estas chaves de recurso (padrão Fluent/WinUI). Definir um
         Style TargetType="TextBox" com Background/BorderBrush (como se fazia antes) não tinha
         qualquer efeito visível por causa disto. A correção real é sobrepor as próprias chaves. -->
    <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#F1F5F9" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#64748B" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#1F4E79" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#E2E8F0" />

    <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#F1F5F9" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#64748B" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#1F4E79" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#E2E8F0" />
    <!-- Cores adicionais para sidebar no modo claro -->
    <SolidColorBrush x:Key="BrushSeparator" Color="#4A7BA8" />
    <SolidColorBrush x:Key="BrushAvatarBackground" Color="#4A7BA8" />
    <SolidColorBrush x:Key="BrushSidebarSubtext" Color="#C7D8E8" />

    <!-- Cores para Administração -->
    <SolidColorBrush x:Key="BrushAdminTabBackground" Color="#E8ECEF" />
    <SolidColorBrush x:Key="BrushAdminTabText" Color="#000000" />
    <SolidColorBrush x:Key="BrushAdminTabSelectedBackground" Color="#2D2D2D" />
    <SolidColorBrush x:Key="BrushAdminTabSelectedText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushAdminButtonBlue" Color="#2C5AA0" />
    <SolidColorBrush x:Key="BrushAdminButtonGreenDark" Color="#1B7741" />
    <SolidColorBrush x:Key="BrushAdminButtonLightBlue" Color="#4A90E2" />
    <SolidColorBrush x:Key="BrushAdminButtonPurple" Color="#7C3AED" />
    <SolidColorBrush x:Key="BrushAdminButtonTeal" Color="#0D9488" />
    <SolidColorBrush x:Key="BrushAdminButtonOrange" Color="#EA580C" />
    <SolidColorBrush x:Key="BrushAdminButtonRose" Color="#DB2777" />
    <SolidColorBrush x:Key="BrushAdminButtonIndigo" Color="#4F46E5" />
    <!-- Cores para Relatórios -->
    <SolidColorBrush x:Key="BrushReportButton" Color="#1B7741" />

    <!-- ====== ESTILOS GLOBAIS ====== -->
    <!-- Window -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BrushBackground}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <!-- TextBlock padrão - NÃO aplicar estilo global que sobrescreve containers especiais -->
    <!-- Comentado para evitar conflito com cores em containers (botões, headers, etc) -->
    <!-- <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style> -->

    <!-- TextBlock BRANCO para usar dentro de containers azuis -->
    <Style x:Key="TextBlockWhiteStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- TextBlock PADRÃO com cor primária (aplicar explicitamente onde necessário) -->
    <Style x:Key="TextBlockDefaultStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <!-- TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BrushInputBackground}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushInputBorder}" />
        <Setter Property="CaretBrush" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="BorderThickness" Value="1.4" />
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrushInputBorderFoco}" />
                <Setter Property="BorderThickness" Value="1.8" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- PasswordBox -->
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource BrushInputBackground}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushInputBorder}" />
        <Setter Property="CaretBrush" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="BorderThickness" Value="1.4" />
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrushInputBorderFoco}" />
                <Setter Property="BorderThickness" Value="1.8" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- (9.1) Campo de pesquisa com ícone de lupa embutido. Aplicar a campos "TxtPesquisa" em
         qualquer formulário: Style="{StaticResource SearchTextBox}". Substitui totalmente o
         template (necessário porque o ModernWpfUI ignora Background/BorderBrush do controlo,
         cf. nota em App.xaml), mas mantém PART_ContentHost, exigido pelo contrato do TextBox. -->
    <Style x:Key="SearchTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BrushInputBackground}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushInputBorder}" />
        <Setter Property="CaretBrush" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Padding" Value="30,8,8,8" />
        <Setter Property="BorderThickness" Value="1.4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="PART_Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <Grid>
                            <TextBlock Text="🔍" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource BrushInputBorderFoco}" />
                            <Setter TargetName="PART_Border" Property="BorderThickness" Value="1.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource BrushInputBackground}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushInputBorder}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="BorderThickness" Value="1.4" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrushInputBorderFoco}" />
                <Setter Property="BorderThickness" Value="1.8" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- DatePicker -->
    <Style TargetType="DatePicker">
        <Setter Property="Background" Value="{StaticResource BrushInputBackground}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushInputBorder}" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="BorderThickness" Value="1.4" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrushInputBorderFoco}" />
                <Setter Property="BorderThickness" Value="1.8" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- CheckBox -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <!-- RadioButton -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <!-- Border padrão -->
    <Style TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ScrollViewer -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="{StaticResource BrushBackground}" />
    </Style>

    <!-- ====== ESTILOS PERSONALIZADOS ====== -->
    <!-- Cartão / painel KPI -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushCard}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08" Color="#000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KpiValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
    </Style>

    <!-- Variante do KpiValueStyle para cards cujo "valor" é um nome (não um número), por isso
         precisa de tamanho de letra menor e de quebra de linha — usada nos cards "Escola/Agrupamento
         mais intervencionado" do Dashboard, para ficarem visualmente alinhados com os restantes cards
         (mesma família de estilo), mas destacados a roxo/lilás em vez da cor primária. -->
    <Style x:Key="KpiValueStyleDestaque" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource BrushPurple}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- ============================================================
         RESOLUCAO UHD (2560x1440) - Dashboard
         Variantes mais compactas de CardStyle/SectionTitleStyle, usadas
         exclusivamente na disposicao UHD do Dashboard (ver DashboardView.xaml).
         Herdam tudo de CardStyle/SectionTitleStyle (cor, sombra, tipo de letra,
         identidade visual) e ajustam apenas padding/margem, para os cartoes
         ocuparem menos altura sem alterar cores, fontes ou aparencia. A
         disposicao FHD validada continua a usar CardStyle/SectionTitleStyle
         originais, sem qualquer alteracao. -->
    <Style x:Key="CardStyleCompacto" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="SectionTitleStyleCompacto" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Variante para SectionTitleStyle com fundo azul (texto branco) -->
    <Style x:Key="SectionTitleStyleWhite" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Botão de navegação lateral - GARANTE TEXTO BRANCO SOBRE AZUL -->
    <Style x:Key="NavButtonStyle" TargetType="RadioButton">
        <Setter Property="GroupName" Value="NavMenu" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- Cabeçalhos centrados em todas as grelhas da aplicação. -->
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="White" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2A5A85" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#25547D" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão Primário - GARANTE TEXTO BRANCO SOBRE AZUL -->
    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="Background" Value="{StaticResource BrushPrimary}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="TextElement.Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" TextElement.Foreground="White">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                        TextElement.Foreground="White" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGrid -->
    <!-- Faixa de arrastar (invisível) usada nas duas pontas do cabeçalho da coluna, para
         redimensionar arrastando com o rato — ver DataGridColumnHeader mais abaixo. -->
    <Style x:Key="ColumnHeaderGripperStyle" TargetType="Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource BrushCard}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeight" Value="34" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <!-- Guarda e repõe a largura das colunas entre sessões (ver ColunasGridService) —
             aplicado aqui uma única vez em vez de em cada DataGrid da aplicação. -->
        <Setter Property="services:ColunasGridService.PersistirLarguras" Value="True" />
    </Style>

    <!-- DataGridColumnHeader - TEXTO BRANCO SOBRE AZUL -->
    <!-- Cursor de "mão" + realce ao passar o rato: sinaliza ao utilizador que pode clicar
         no cabeçalho para ordenar a coluna. -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource BrushPrimary}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushPrimaryDark}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <!-- Item da lista de requisitos: apenas o TEXTO do cabeçalho é centrado (não os
             valores das células — essas usam o estilo de DataGridCell, que não é afetado). -->
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="Clique para ordenar por esta coluna" />
        <Setter Property="TextElement.Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border x:Name="HeaderBorder"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="White">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                            VerticalAlignment="Center"
                                            TextElement.Foreground="White" />
                        </Border>
                        <!-- Faixas invisíveis nas fronteiras esquerda/direita do cabeçalho: é a
                             estas duas partes, com estes nomes exatos, que o DataGrid do WPF vai
                             à procura para permitir arrastar e redimensionar a coluna com o rato.
                             Sem elas (como acontecia antes), o arrastar simplesmente não fazia nada. -->
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource ColumnHeaderGripperStyle}" />
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource ColumnHeaderGripperStyle}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource BrushPrimaryDark}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGridRow - TEXTO BRANCO QUANDO SELECIONADO SOBRE AZUL -->
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource BrushCard}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#2A5A85" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="TextElement.Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F0F4F8" />
            </Trigger>
            <!-- Linha selecionada + hover: o fundo fica claro (regra acima), por isso o texto
                 tem de passar a preto para continuar legível (em vez de branco sobre claro) -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="TextElement.Foreground" Value="Black" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- Item 7 (consistência global de cursor): linhas de DataGrid onde clicar/duplo-clicar
         tem uma ação (abrir para editar, ou selecionar para carregar no painel de edição ao
         lado) devem indicar isso ao passar o rato. Aplicar via RowStyle apenas às grids que
         realmente têm essa interação (não a grids puramente informativas/histórico), para não
         sugerir uma ação que não existe. -->
    <Style TargetType="DataGridRow" x:Key="DataGridRowClickableStyle" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="Cursor" Value="Hand" />
    </Style>


    <!-- DataGridCell - Herda cor quando linha é selecionada -->
    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="TextElement.Foreground" Value="White" />
                <Setter Property="Background" Value="Transparent" />
            </Trigger>
            <!-- (4.1) Correção: antes esta condição usava o IsMouseOver da própria célula, pelo que só
                 a coluna exata onde o rato estava é que ficava com o texto preto (as restantes colunas
                 da mesma linha continuavam com texto branco, ilegível sobre o fundo claro do hover).
                 Ao usar o IsMouseOver da LINHA (via RelativeSource), toda a linha seleccionada fica com
                 o texto preto assim que o rato passa por cima dela, seja qual for a coluna. -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Value="True">
                        <Condition.Binding>
                            <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}" Path="IsSelected" />
                        </Condition.Binding>
                    </Condition>
                    <Condition Value="True">
                        <Condition.Binding>
                            <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}" Path="IsMouseOver" />
                        </Condition.Binding>
                    </Condition>
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="TextElement.Foreground" Value="Black" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- StackPanel -->
    <Style TargetType="StackPanel">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <!-- Grid -->
    <Style TargetType="Grid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <!-- Border padrão com herança de texto -->
    <Style TargetType="Border" x:Key="BorderDefaultStyle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <!-- ListBox -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource BrushCard}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
    </Style>

    <!-- ListBoxItem - TEXTO BRANCO QUANDO SELECIONADO SOBRE AZUL -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushPrimary}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="TextElement.Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushNeutral}" />
