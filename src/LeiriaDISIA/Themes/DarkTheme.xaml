<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:services="clr-namespace:LeiriaDISIA.Services">

    <!-- ====== PALETA DARK MODE (Inspirada em VS 2026 Dark Theme) ====== -->
    <SolidColorBrush x:Key="BrushPrimary" Color="#3B6FA3" />
    <SolidColorBrush x:Key="BrushPrimaryDark" Color="#2D5580" />
    <SolidColorBrush x:Key="BrushAccent" Color="#2AB7CA" />
    <SolidColorBrush x:Key="BrushBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="BrushCard" Color="#252526" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#CCCCCC" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#858585" />
    <SolidColorBrush x:Key="BrushSuccess" Color="#4EC9B0" />
    <SolidColorBrush x:Key="BrushWarning" Color="#DCDCAA" />
    <SolidColorBrush x:Key="BrushDanger" Color="#F48771" />
    <!-- Item 3.1 — ver ModernTheme.xaml. Em modo escuro o "claro" fica invertido: fundo vermelho
         escuro amortecido (não o vermelho vivo de erro) + texto claro, para não confundir com um
         alerta de erro nem ficar ilegível sobre o fundo escuro da janela. -->
    <SolidColorBrush x:Key="BrushDangerBackgroundLight" Color="#3B2222" />
    <SolidColorBrush x:Key="BrushDangerTextDark" Color="#F2B8B5" />

    <!-- Faltava no tema escuro (só existia no ModernTheme.xaml) — usado pelo botão "Relatório do
         Módulo" em vários ecrãs (Escolas, Equipamentos, Pedidos, etc.) e pela Folha de Inventário /
         Planeamento de Rota. Sem isto, mudar para o tema escuro rebentava esses botões. Verde um
         pouco mais claro do que no tema claro, para se destacar melhor sobre o fundo escuro. -->
    <SolidColorBrush x:Key="BrushReportButton" Color="#238C4E" />
    <SolidColorBrush x:Key="BrushPurple" Color="#B18CFF" />
    <SolidColorBrush x:Key="BrushNeutral" Color="#6A6A6A" />
    <SolidColorBrush x:Key="BrushBorder" Color="#3E3E42" />
    <SolidColorBrush x:Key="BrushInputBackground" Color="#3C3C3C" />
    <!-- Cores adicionais para sidebar no modo escuro -->
    <SolidColorBrush x:Key="BrushSeparator" Color="#3E3E42" />
    <SolidColorBrush x:Key="BrushAvatarBackground" Color="#3C3C3C" />
    <SolidColorBrush x:Key="BrushSidebarSubtext" Color="#6A6A6A" />

    <!-- ====== ESTILOS GLOBAIS ====== -->
    <!-- Window -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BrushBackground}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <!-- TextBlock padrão -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <!-- TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BrushInputBackground}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="CaretBrush" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- PasswordBox -->
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource BrushInputBackground}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="CaretBrush" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- (9.1) Campo de pesquisa com ícone de lupa embutido — ver nota em ModernTheme.xaml. -->
    <Style x:Key="SearchTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BrushInputBackground}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="CaretBrush" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Padding" Value="30,8,8,8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="PART_Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <Grid>
                            <TextBlock Text="🔍" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
                            <Setter TargetName="PART_Border" Property="BorderThickness" Value="1.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource BrushInputBackground}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- CheckBox -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <!-- RadioButton -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <!-- Border padrão -->
    <Style TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ScrollViewer -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="{StaticResource BrushBackground}" />
    </Style>

    <!-- ====== BADGES DE ESTADO/CLASSIFICAÇÃO (colunas de datagrid com cor) ======
         Ver ModernTheme.xaml para explicação completa; mantidos aqui iguais para consistência
         visual entre os temas claro/escuro. -->
    <Style x:Key="BadgePillStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BadgeRectStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ====== ESTILOS PERSONALIZADOS ====== -->
    <!-- Cartão / painel KPI -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushCard}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18" ShadowDepth="1" Opacity="0.5" Color="#000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KpiValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
    </Style>

    <!-- Variante do KpiValueStyle para cards cujo "valor" é um nome (não um número), por isso
         precisa de tamanho de letra menor e de quebra de linha — usada nos cards "Escola/Agrupamento
         mais intervencionado" do Dashboard, para ficarem visualmente alinhados com os restantes cards
         (mesma família de estilo), mas destacados a roxo/lilás em vez da cor de destaque normal. -->
    <Style x:Key="KpiValueStyleDestaque" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource BrushPurple}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- ============================================================
         RESOLUCAO UHD (2560x1440) - Dashboard
         Variantes mais compactas de CardStyle/SectionTitleStyle, usadas
         exclusivamente na disposicao UHD do Dashboard (ver DashboardView.xaml).
         Herdam tudo de CardStyle/SectionTitleStyle (cor, sombra, tipo de letra,
         identidade visual) e ajustam apenas padding/margem, para os cartoes
         ocuparem menos altura sem alterar cores, fontes ou aparencia. A
         disposicao FHD validada continua a usar CardStyle/SectionTitleStyle
         originais, sem qualquer alteracao. -->
    <Style x:Key="CardStyleCompacto" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="SectionTitleStyleCompacto" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Botão de navegação lateral -->
    <Style x:Key="NavButtonStyle" TargetType="RadioButton">
        <Setter Property="GroupName" Value="NavMenu" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="White" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3E5C77" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3A5470" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão Primário -->
    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="Background" Value="{StaticResource BrushPrimary}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="TextElement.Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" TextElement.Foreground="White">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão "Relatório do Módulo" / ações de documento (Folha de Inventário, Planeamento de
         Rota) — faltava no tema escuro, ver nota junto de BrushReportButton acima. -->
    <Style x:Key="ReportButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushReportButton}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="TextElement.Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" TextElement.Foreground="White">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2FA562" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#1B6B3C" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGrid -->
    <!-- Faixa de arrastar (invisível) usada nas duas pontas do cabeçalho da coluna, para
         redimensionar arrastando com o rato — ver DataGridColumnHeader mais abaixo. -->
    <Style x:Key="ColumnHeaderGripperStyle" TargetType="Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource BrushCard}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeight" Value="34" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <!-- Guarda e repõe a largura das colunas entre sessões (ver ColunasGridService) —
             aplicado aqui uma única vez em vez de em cada DataGrid da aplicação. -->
        <Setter Property="services:ColunasGridService.PersistirLarguras" Value="True" />
    </Style>

    <!-- DataGridColumnHeader -->
    <!-- Cursor de "mão" + realce ao passar o rato: sinaliza ao utilizador que pode clicar
         no cabeçalho para ordenar a coluna. -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource BrushPrimary}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushPrimaryDark}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <!-- Item da lista de requisitos: apenas o TEXTO do cabeçalho é centrado (não os
             valores das células — essas usam o estilo de DataGridCell, que não é afetado). -->
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="Clique para ordenar por esta coluna" />
        <Setter Property="TextElement.Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border x:Name="HeaderBorder"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="White">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                            VerticalAlignment="Center"
                                            TextElement.Foreground="White" />
                        </Border>
                        <!-- Faixas invisíveis nas fronteiras esquerda/direita do cabeçalho: é a
                             estas duas partes, com estes nomes exatos, que o DataGrid do WPF vai
                             à procura para permitir arrastar e redimensionar a coluna com o rato.
                             Sem elas (como acontecia antes), o arrastar simplesmente não fazia nada. -->
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource ColumnHeaderGripperStyle}" />
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource ColumnHeaderGripperStyle}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource BrushPrimaryDark}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGridCell -->
    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="TextElement.Foreground" Value="White" />
                <Setter Property="Background" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- DataGridRow -->
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource BrushCard}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#3E5C77" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="TextElement.Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#2D3E4F" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Item 7 (consistência global de cursor) — ver ModernTheme.xaml para a explicação completa. -->
    <Style TargetType="DataGridRow" x:Key="DataGridRowClickableStyle" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="Cursor" Value="Hand" />
    </Style>


    <!-- StackPanel -->
    <Style TargetType="StackPanel">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <!-- Grid -->
    <Style TargetType="Grid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <!-- ListBox -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource BrushCard}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
    </Style>

    <!-- ListBoxItem -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushPrimary}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="TextElement.Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushBorder}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Separator -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource BrushBorder}" />
    </Style>

    <!-- Label -->
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <!-- Button padrão (para botões sem estilo específico) -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="#404040" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#555555" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#505050" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
