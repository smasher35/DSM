<Window x:Class="LeiriaDISIA.Views.AgrupamentosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agrupamentos de Escolas — Gestão DISIA" WindowState="Maximized"
        Background="{StaticResource BrushBackground}" FontFamily="Segoe UI">
    <DockPanel Margin="24">
        <!-- Barra de topo -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="🏠 Menu Principal" Style="{StaticResource MenuPrincipalButton}" Click="MenuPrincipal_Click" Margin="0,0,10,0" />
                <Button Content="➕ Inserir Agrupamento" Style="{StaticResource PrimaryButton}" Click="Inserir_Click" Margin="0,0,10,0" />
                <Button Content="📄 Relatório do Módulo" Style="{StaticResource ReportButton}" Click="Relatorio_Click" Margin="0,0,30,0" />
                <TextBox x:Name="TxtPesquisa" Style="{StaticResource SearchTextBox}" Width="280" TextChanged="Filtro_TextChanged"
                         ToolTip="Pesquisar por nome ou código do agrupamento" />
                <TextBlock Text="Agrupamentos de Escolas" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" Margin="30,0,0,0" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Grid com linhas Auto (título) + "*" (DataGrid) + Auto (botões), em vez de
                 StackPanel, para a lista de agrupamentos ocupar sempre todo o espaço livre até ao
                 fundo da janela (mesmo padrão do módulo Atividades DISIA — ver
                 Views/DisiaWindow.xaml). -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Lista de Agrupamentos" Style="{StaticResource SectionTitleStyle}" />
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <DataGrid x:Name="Grid" CanUserSortColumns="True" SelectionChanged="Grid_SelectionChanged"
                              MouseDoubleClick="Grid_MouseDoubleClick" RowStyle="{StaticResource DataGridRowClickableStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding CodAgrupamento}" Width="Auto" ElementStyle="{StaticResource CenteredCellTextStyle}" />
                            <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" />
                            <DataGridTextColumn Header="Abrev." Binding="{Binding Abreviatura}" Width="Auto" ElementStyle="{StaticResource CenteredCellTextStyle}" />
                            <DataGridTextColumn Header="Nº Escolas" Binding="{Binding TotalEscolas}" Width="Auto" ElementStyle="{StaticResource CenteredCellTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Editar Agrupamento Selecionado" Click="EditarSelecionado_Click" Margin="0,0,8,0" />
                    <Button Content="Eliminar Agrupamento" Click="Eliminar_Click" Background="#FDECEC" />
                </StackPanel>
            </Grid>

            <!-- Grid com linhas Auto (título) + "*" (DataGrid), em vez de StackPanel, para a
                 lista de escolas do agrupamento ocupar sempre todo o espaço livre até ao fundo
                 da janela (mesmo padrão do módulo Atividades DISIA — ver Views/DisiaWindow.xaml). -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock x:Name="TxtTituloEscolas" Text="Escolas do agrupamento selecionado"
                               Style="{StaticResource SectionTitleStyle}" Margin="0,0,16,0" />
                    <Button x:Name="BtnAdicionarEscola" Content="+ Adicionar escola a este agrupamento"
                            Click="AdicionarEscola_Click" IsEnabled="False" />
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="GridEscolas" Grid.Row="0" CanUserSortColumns="True" MouseDoubleClick="GridEscolas_MouseDoubleClick" RowStyle="{StaticResource DataGridRowClickableStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Escola" Binding="{Binding Nome}" Width="*" />
                                <DataGridTextColumn Header="Cod. GEPE" Binding="{Binding CodGEPE}" Width="Auto" ElementStyle="{StaticResource CenteredCellTextStyle}" />
                                <DataGridTextColumn Header="Localidade" Binding="{Binding Localidade}" Width="Auto" />
                                <DataGridTextColumn Header="Freguesia" Binding="{Binding Freguesia}" Width="Auto" />
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="Auto" />
                                <DataGridTemplateColumn Header="Estado" Width="Auto" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource BadgePillStyle}" HorizontalAlignment="Center" Background="{Binding CorEstado, Converter={StaticResource HexColorToBrushConverter}}">
                                                <TextBlock Text="{Binding Estado}" Style="{StaticResource BadgeTextStyle}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="1" Text="💡 Duplo-clique numa escola para ver/editar os seus detalhes."
                                   FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,8,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
