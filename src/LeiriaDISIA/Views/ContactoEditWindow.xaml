<Window x:Class="LeiriaDISIA.Views.ContactoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contacto" Height="712" Width="440" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}">
    <StackPanel Margin="20">
        <TextBlock x:Name="TxtTitulo" Text="Novo Contacto" Style="{StaticResource SectionTitleStyle}" FontSize="18" />

        <TextBlock Text="Nome" FontWeight="SemiBold" />
        <TextBox x:Name="TxtNome" Margin="0,4,0,10" />

        <TextBlock Text="Escola (opcional)" FontWeight="SemiBold" />
        <ComboBox x:Name="CmbEscola" DisplayMemberPath="Nome" Margin="0,4,0,10" />

        <TextBlock Text="Entidade Externa" FontWeight="SemiBold" />
        <TextBox x:Name="TxtEntidadeExterna" Margin="0,4,0,10" />

        <TextBlock Text="Função" FontWeight="SemiBold" />
        <TextBox x:Name="TxtFuncao" Margin="0,4,0,10" />

        <TextBlock Text="Telefone" FontWeight="SemiBold" />
        <TextBox x:Name="TxtTelefone" Margin="0,4,0,10" />

        <TextBlock Text="Telemóvel" FontWeight="SemiBold" />
        <TextBox x:Name="TxtTelemovel" Margin="0,4,0,10" />

        <TextBlock Text="Email" FontWeight="SemiBold" />
        <TextBox x:Name="TxtEmail" Margin="0,4,0,10" />

        <TextBlock Text="Observações" FontWeight="SemiBold" />
        <TextBox x:Name="TxtObservacoes" AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,4,0,20" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Click="Cancelar_Click" Margin="0,20,5,0" />
            <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Click="Guardar_Click" VerticalAlignment="Bottom" />
        </StackPanel>
    </StackPanel>
</Window>
