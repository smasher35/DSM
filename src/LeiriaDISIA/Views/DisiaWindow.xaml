<Window x:Class="LeiriaDISIA.Views.DisiaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atividades na DISIA — Gestão DISIA" WindowState="Maximized"
        Background="{StaticResource BrushBackground}" FontFamily="Segoe UI">
    <DockPanel Margin="24">
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="🏠 Menu Principal" Style="{StaticResource MenuPrincipalButton}" Click="MenuPrincipal_Click" Margin="0,0,10,0" />
                <Button x:Name="BtnInserir" Content="➕ Inserir Atividade" Style="{StaticResource PrimaryButton}" Click="Inserir_Click" Margin="0,0,10,0" />
                <Button Content="📄 Relatório do Módulo" Style="{StaticResource ReportButton}" Click="Relatorio_Click" Margin="0,0,30,0" />
                <TextBlock Text="Ano:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="CmbAno" Width="90" SelectionChanged="Filtro_Changed" Margin="0,0,16,0" VerticalAlignment="Center" />
                <TextBlock Text="Mês:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="CmbMes" Width="130" SelectionChanged="Filtro_Changed" Margin="0,0,30,0" VerticalAlignment="Center" />
                <TextBox x:Name="TxtPesquisa" Style="{StaticResource SearchTextBox}" Width="280" TextChanged="Filtro_TextChanged"
                         ToolTip="Pesquisar por descrição, local ou categoria" />
                <TextBlock Text="Atividades DISIA" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" Margin="30,0,0,0" />
            </StackPanel>
        </Border>

        <!-- 1.1: Grid com linhas Auto (cabeçalhos/legenda/KPIs) + "*" na linha da DataGrid, para a
             lista de intervenções DISIA ocupar sempre todo o espaço vertical disponível até ao
             fundo da janela, sem espaços vazios nem scroll desnecessário na janela principal. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Legenda de estados e categorias -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="8" Padding="10">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="12" Height="12" Fill="#22C55E" Margin="0,0,4,0" />
                        <TextBlock Text="Fechada" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Ellipse Width="12" Height="12" Fill="#EF4444" Margin="0,0,4,0" />
                        <TextBlock Text="Pendente" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Ellipse Width="12" Height="12" Fill="#F59E0B" Margin="0,0,4,0" />
                        <TextBlock Text="Em Progresso" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Ellipse Width="12" Height="12" Fill="#6366F1" Margin="0,0,4,0" />
                        <TextBlock Text="Em Espera" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Ellipse Width="12" Height="12" Fill="#9CA3AF" Margin="0,0,4,0" />
                        <TextBlock Text="Cancelada" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <!-- (5.1) Legenda dos quadrados de cor da coluna "Categoria" -->
                <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="8" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Categorias:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" />
                        <ItemsControl x:Name="LegendaCategorias">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                        <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2"
                                                   Fill="{Binding CorHex, Converter={StaticResource HexColorToBrushConverter}}" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding Nome}" VerticalAlignment="Center" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Cards KPI - Grid 3x2 para melhor visualização -->
            <UniformGrid Grid.Row="1" Columns="3" Rows="2" Margin="0,0,0,16">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock x:Name="TxtTotalAno" Text="0" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="Atividades (ano)" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock x:Name="TxtTotalMes" Text="0" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="Atividades (mês)" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="TxtTotalQuantidade" Text="0" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="Total de serviços" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock x:Name="TxtLocalMaisIntervencionadoValor" Text="0" Style="{StaticResource KpiValueStyle}" Foreground="{StaticResource BrushPurple}" />
                        <TextBlock Text="Local mais intervencionado" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock x:Name="TxtLocalMaisIntervencionado" Text="—" FontSize="11" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock x:Name="TxtCategoriaMaisUtilizadaValor" Text="0" Style="{StaticResource KpiValueStyle}" Foreground="{StaticResource BrushPurple}" />
                        <TextBlock Text="Categoria mais usada" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock x:Name="TxtCategoriaMaisUtilizada" Text="—" FontSize="11" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock x:Name="TxtAtividadesPendentes" Text="0" Style="{StaticResource KpiValueStyle}" Foreground="#FFF59E08" />
                        <TextBlock Text="Atividades DISIA pendentes" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18,18,18,18">
                <DataGrid x:Name="Grid" CanUserSortColumns="True" MouseDoubleClick="Grid_MouseDoubleClick" RowStyle="{StaticResource DataGridRowClickableStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd-MM-yyyy}" Width="Auto" />
                        <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                        <DataGridTemplateColumn Header="Categoria" Width="Auto" SortMemberPath="Categoria.Nome">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource BadgeRectStyle}"
                                            Background="{Binding Categoria.CorHex, Converter={StaticResource HexColorToBrushConverter}}">
                                        <TextBlock Text="{Binding Categoria.Nome}" Style="{StaticResource BadgeTextStyle}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="Auto" />
                        <DataGridTextColumn Header="Qtd" Binding="{Binding Quantidade}" Width="Auto" />
                        <DataGridTemplateColumn Header="Estado" Width="Auto" SortMemberPath="Estado">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource BadgePillStyle}"
                                            Background="{Binding CorEstado, Converter={StaticResource HexColorToBrushConverter}}">
                                        <TextBlock Text="{Binding Estado, Converter={StaticResource EstadoIntervencaoNomeExibicaoConverter}}" Style="{StaticResource BadgeTextStyle}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
