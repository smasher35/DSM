<Window x:Class="LeiriaDISIA.Views.PesquisaAvancadaAtividadeDisiaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pesquisa Avançada de Atividades DISIA" Width="860" Height="660"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Pesquisa Avançada de Atividades DISIA" Style="{StaticResource SectionTitleStyle}" FontSize="18" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Text="Combine um ou mais filtros (campo, comparador e valor) para encontrar exatamente as atividades que procura — ex.: Categoria = Manutenção E Ano = 2026 E Quantidade &gt; 1. Todos os filtros são combinados com E."
                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,14" />

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel x:Name="PainelFiltros" />
                <Button x:Name="BtnAdicionarFiltro" Content="➕ Adicionar Filtro" Click="AdicionarFiltro_Click"
                        HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="TxtResultado" Grid.Row="0" Text="Ainda não pesquisou — clique em &quot;Pesquisar&quot;."
                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="4,0,0,6" />
                <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat={}{0:dd/MM/yyyy}}" Width="90" />
                        <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="140" />
                        <DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="160" />
                        <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                        <DataGridTextColumn Header="Qtd." Binding="{Binding Quantidade}" Width="45" />
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnPesquisar" Content="🔍 Pesquisar" Click="Pesquisar_Click" Margin="0,0,10,0" />
            <Button x:Name="BtnGerarPdf" Content="📋 Gerar PDF" Style="{StaticResource PrimaryButton}" Click="GerarPdf_Click" IsEnabled="False" Margin="0,0,10,0" />
            <Button x:Name="BtnFechar" Content="Fechar" Click="Fechar_Click" />
        </StackPanel>
    </Grid>
</Window>
