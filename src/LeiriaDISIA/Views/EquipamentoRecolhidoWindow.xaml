<Window x:Class="LeiriaDISIA.Views.EquipamentoRecolhidoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:LeiriaDISIA.Converters"
        Title="Equipamento Recolhido — Gestão DISIA" WindowState="Maximized"
        Background="{StaticResource BrushBackground}" FontFamily="Segoe UI">
    <Window.Resources>
        <conv:HexColorToBrushConverter x:Key="HexToBrush" />
    </Window.Resources>
    <DockPanel Margin="24">
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="🏠 Menu Principal" Style="{StaticResource MenuPrincipalButton}" Click="MenuPrincipal_Click" Margin="0,0,10,0" />
                <Button Content="➕ Registar Recolha" Style="{StaticResource PrimaryButton}" Click="Inserir_Click" Margin="0,0,10,0" />
                <Button Content="📄 Relatório do Módulo" Style="{StaticResource ReportButton}" Click="Relatorio_Click" Margin="0,0,20,0" />
                <CheckBox x:Name="ChkHistorico" Content="Mostrar histórico (já entregues)" VerticalAlignment="Center"
                          Checked="ChkHistorico_Changed" Unchecked="ChkHistorico_Changed" Margin="0,0,20,0" />
                <TextBox x:Name="TxtPesquisa" Style="{StaticResource SearchTextBox}" Width="260" TextChanged="Filtro_TextChanged"
                         ToolTip="Pesquisar por nº série, escola ou estado" />
                <TextBlock Text="Equipamentos Recolhidos" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" Margin="30,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Grid com linhas Auto (legenda) + "*" (DataGrid), em vez de StackPanel, para a lista
             de equipamento recolhido ocupar sempre todo o espaço livre até ao fundo da janela
             (mesmo padrão do módulo Atividades DISIA — ver Views/DisiaWindow.xaml). -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="8" Padding="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tempo em recolha:" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Ellipse Width="12" Height="12" Fill="#22C55E" Margin="0,0,4,0" />
                        <TextBlock Text="até 7 dias" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Ellipse Width="12" Height="12" Fill="#F59E0B" Margin="0,0,4,0" />
                        <TextBlock Text="8 a 21 dias" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Ellipse Width="12" Height="12" Fill="#EF4444" Margin="0,0,4,0" />
                        <TextBlock Text="mais de 21 dias" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <!-- Legenda do badge de Estado, alinhada à direita, na mesma linha da legenda de tempo -->
                <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="8" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Estados:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" />
                        <ItemsControl x:Name="LegendaEstados">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                        <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2"
                                                   Fill="{Binding Cor, Converter={StaticResource HexToBrush}}" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding Nome}" VerticalAlignment="Center" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <DataGrid x:Name="Grid" CanUserSortColumns="True" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          MouseDoubleClick="Grid_MouseDoubleClick" RowStyle="{StaticResource DataGridRowClickableStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nº Série" Binding="{Binding Equipamento.NumeroSerie}" Width="Auto" />
                        <DataGridTextColumn Header="Cód. GEPE" Binding="{Binding Equipamento.Escola.CodGEPE}" Width="Auto" />
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Equipamento.Tipo}" Width="Auto" />
                        <DataGridTextColumn Header="Escola" Binding="{Binding Equipamento.Escola.Nome}" Width="*" />
                        <DataGridTextColumn Header="Data Recolha" Binding="{Binding DataRecolha, StringFormat=dd-MM-yyyy}" Width="Auto" />
                        <DataGridTemplateColumn Header="Estado" Width="Auto" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource BadgeRectStyle}" Background="{Binding CorEstado, Converter={StaticResource HexToBrush}}">
                                        <TextBlock Text="{Binding Estado}" Style="{StaticResource BadgeTextStyle}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Data Entrega" Binding="{Binding DataEntrega, StringFormat=dd-MM-yyyy}" Width="Auto" />
                        <DataGridTemplateColumn Header="Tempo" Width="Auto" SortMemberPath="DiasEmRecolha">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding CorTempo, Converter={StaticResource HexToBrush}}"
                                            CornerRadius="4" Padding="6,3" Margin="2" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding DiasEmRecolha, StringFormat={}{0} d}" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Entregar" Width="Auto" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✔ Entregar na Escola" Padding="6,2" Click="Entregar_Click" Tag="{Binding Id}"
                                            IsEnabled="{Binding PodeSerEntregue}"
                                            ToolTip="Só disponível quando o estado é 'Reparado'" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
