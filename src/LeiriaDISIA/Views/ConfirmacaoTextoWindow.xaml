<Window x:Class="LeiriaDISIA.Views.ConfirmacaoTextoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmação necessária" Width="460" SizeToContent="Height" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock x:Name="TxtMensagem" TextWrapping="Wrap" Margin="0,0,0,16" FontSize="14" />
        <TextBlock x:Name="TxtInstrucao" TextWrapping="Wrap" Margin="0,0,0,12" FontWeight="SemiBold" />
        <TextBox x:Name="TxtInput" Margin="0,0,0,24" Padding="8" FontSize="14" Height="34" VerticalContentAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Click="Cancelar_Click" Margin="0,0,8,0" Padding="14,8" />
            <Button x:Name="BtnConfirmar" Content="Confirmar" Click="Confirmar_Click" Padding="14,8"
                    Background="{StaticResource BrushDanger}" Foreground="White" FontWeight="Bold" BorderThickness="0" />
        </StackPanel>
    </StackPanel>
</Window>
