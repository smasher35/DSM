<Window x:Class="LeiriaDISIA.Views.EquipamentoAbatidoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registo de Abate" Height="534" Width="880" MinHeight="400" MinWidth="780"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}">
    <ScrollViewer Margin="24,20,34,20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock x:Name="TxtTitulo" Text="Registar Abate" Style="{StaticResource SectionTitleStyle}"
                       FontSize="18" Margin="0,0,0,16" />

            <!-- Layout em modo paisagem: duas colunas lado a lado para se ver tudo sem scroll -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Coluna esquerda: equipamento e onde estava -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Escola (selecione primeiro para filtrar o equipamento)" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtPesquisaEscola" Style="{StaticResource SearchTextBox}" Margin="0,4,0,4" TextChanged="TxtPesquisaEscola_TextChanged" />
                    <ComboBox x:Name="CmbEscola" Margin="0,0,0,10" DisplayMemberPath="Nome" SelectionChanged="CmbEscola_SelectionChanged" />

                    <TextBlock Text="Equipamento já cadastrado (opcional)" FontWeight="SemiBold" />
                    <Grid Margin="0,4,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtEquipamentoSelecionado" Grid.Column="0" IsReadOnly="True" Background="#F1F5F9" />
                        <Button x:Name="BtnEscolherEquipamento" Grid.Column="2" Content="Escolher..." Click="EscolherEquipamento_Click" Padding="10,4" />
                    </Grid>

                    <TextBlock Text="Escola / Local" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtEscolaOuLocal" Margin="0,4,0,10" />

                    <TextBlock Text="Descrição do Equipamento" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtDescricao" AcceptsReturn="True" Height="80" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Coluna direita: dados do abate -->
                <StackPanel Grid.Column="2">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="N.º de Série" FontWeight="SemiBold" />
                            <TextBox x:Name="TxtNumeroSerie" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="N.º de Inventário" FontWeight="SemiBold" />
                            <TextBox x:Name="TxtNumeroInventario" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Data do Abate" FontWeight="SemiBold" />
                            <DatePicker x:Name="DpAbate" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Status" FontWeight="SemiBold" />
                            <ComboBox x:Name="CmbStatus" IsEditable="True" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Observações" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtObservacoes" AcceptsReturn="True" Height="80" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancelar" Click="Cancelar_Click" Margin="0,0,8,0" VerticalAlignment="Bottom" />
                <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Click="Guardar_Click" VerticalAlignment="Bottom" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
