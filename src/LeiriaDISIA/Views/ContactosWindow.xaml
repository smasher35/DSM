<Window x:Class="LeiriaDISIA.Views.ContactosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contactos — Gestão DISIA" WindowState="Maximized"
        Background="{StaticResource BrushBackground}" FontFamily="Segoe UI">
    <DockPanel Margin="24">
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="🏠 Menu Principal" Style="{StaticResource MenuPrincipalButton}" Click="MenuPrincipal_Click" Margin="0,0,10,0" />
                <Button Content="➕ Inserir Contacto" Style="{StaticResource PrimaryButton}" Click="Inserir_Click" Margin="0,0,10,0" />
                <Button Content="📄 Relatório do Módulo" Style="{StaticResource ReportButton}" Click="Relatorio_Click" Margin="0,0,30,0" />
                <TextBox x:Name="TxtPesquisa" Style="{StaticResource SearchTextBox}" Width="280" TextChanged="Filtro_Changed"
                         ToolTip="Pesquisar por nome, escola ou função" />
                <TextBlock Text="Contactos" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" Margin="30,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Grid de uma só linha "*" em vez de StackPanel: a StackPanel dimensiona-se ao
             conteúdo e obriga a uma altura fixa na DataGrid; o Grid estica o Border/DataGrid
             para ocupar sempre todo o espaço livre até ao fundo da janela (mesmo padrão do
             módulo Atividades DISIA — ver Views/DisiaWindow.xaml). -->
        <Grid>
            <Border Style="{StaticResource CardStyle}">
                <DataGrid x:Name="Grid" CanUserSortColumns="True" MouseDoubleClick="Grid_MouseDoubleClick" RowStyle="{StaticResource DataGridRowClickableStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" />
                        <DataGridTextColumn Header="Escola" Binding="{Binding Escola.Nome}" Width="Auto" />
                        <DataGridTextColumn Header="Entidade Externa" Binding="{Binding EntidadeExterna}" Width="Auto" />
                        <DataGridTextColumn Header="Função" Binding="{Binding Funcao}" Width="Auto" />
                        <DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="Auto" ElementStyle="{StaticResource CenteredCellTextStyle}" />
                        <DataGridTextColumn Header="Telemóvel" Binding="{Binding Telemovel}" Width="Auto" ElementStyle="{StaticResource CenteredCellTextStyle}" />
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
