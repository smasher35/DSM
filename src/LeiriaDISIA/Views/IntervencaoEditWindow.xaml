<Window x:Class="LeiriaDISIA.Views.IntervencaoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Intervenção" Height="965" Width="1528" MinHeight="640" MinWidth="1100"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource BrushBackground}">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitulo" Grid.Row="0" Text="Registar Intervenção" Style="{StaticResource SectionTitleStyle}" FontSize="18" Margin="0,0,0,10" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- ===================== COLUNA 1 — Dados gerais ===================== -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Procurar Escola" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtPesquisaEscola" Style="{StaticResource SearchTextBox}" Margin="0,4,0,4" TextChanged="TxtPesquisaEscola_TextChanged" />
                    <TextBlock Text="Escreva para filtrar a lista abaixo (nome, código GEPE, localidade)." FontSize="11"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6" TextWrapping="Wrap" />

                    <TextBlock Text="Escola" FontWeight="SemiBold" />
                    <ComboBox x:Name="CmbEscola" DisplayMemberPath="Nome" Margin="0,4,0,8" SelectionChanged="CmbEscola_SelectionChanged" />

                    <TextBlock x:Name="TxtEscolaInfo" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextSecondary}" FontSize="12" />

                    <TextBlock Text="Pedido de Intervenção" FontWeight="SemiBold" />
                    <Border Style="{StaticResource CardStyleCompacto}" Margin="0,4,0,12" Padding="10">
                        <StackPanel>
                            <TextBlock x:Name="TxtPedidoAssociadoInfo" TextWrapping="Wrap" FontSize="12"
                                       Text="Esta intervenção não está associada a nenhum pedido — ao fechá-la, nenhum pedido será encerrado automaticamente."
                                       Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnAssociarPedido" Content="🔗 Associar a um Pedido..." FontSize="11"
                                        Padding="8,4" Click="AssociarPedido_Click" />
                                <Button x:Name="BtnRemoverAssociacaoPedido" Content="✖ Remover associação" FontSize="11"
                                        Padding="8,4" Margin="8,0,0,0" Click="RemoverAssociacaoPedido_Click" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Data da Intervenção" FontWeight="SemiBold" />
                    <DatePicker x:Name="DpData" Margin="0,4,0,10" />

                    <TextBlock Text="Nº Suporte SIGA" FontWeight="SemiBold" />
                    <!-- Vem pré-preenchido a partir do Pedido de origem, quando este já o tiver
                         (ver AtualizarPainelPedidoAssociado em IntervencaoEditWindow.xaml.cs) —
                         continua editável, para se poder escrever à mão quando a intervenção não
                         nasce de um pedido, ou quando o pedido ainda não tinha este nº. -->
                    <TextBox x:Name="TxtNumeroSuporteSiga" Margin="0,4,0,10" />

                    <TextBlock Text="Descrição / Tipo de Intervenção" FontWeight="SemiBold" />
                    <!-- Altura aumentada mais uma vez (100 → 170) com o espaço libertado por
                         remover "Notas gerais de material" abaixo (praticamente nunca usado) — ver
                         IntervencaoEditWindow.xaml.cs para o campo (MaterialRecolhidoAbatido) que
                         lá ficava: os dados históricos já preenchidos por essa via continuam
                         intactos na base de dados e a aparecer no relatório PDF ("Notas Adicionais
                         (registo histórico)"), só deixou de haver aqui um campo para o editar. -->
                    <TextBox x:Name="TxtDescricao" AcceptsReturn="True" Height="170" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Margin="0,4,0,10" />

                    <TextBlock Text="Categorias envolvidas" FontWeight="SemiBold" />
                    <!-- WrapPanel em vez do StackPanel vertical por omissão de um ItemsControl —
                         cada CheckBox recebe uma Width fixa em código (ver IntervencaoEditWindow.xaml.cs)
                         para ficarem lado a lado em duas colunas, em vez de uma lista vertical
                         longa — foi isto que libertou espaço para aumentar a caixa de Descrição
                         acima, que ficava demasiado baixa para se perceber bem o que lá estava
                         escrito em descrições mais longas. -->
                    <ItemsControl x:Name="ListaCategorias" Margin="0,4,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Text="Estado da Intervenção" FontWeight="SemiBold" />
                    <ComboBox x:Name="CmbEstado" Margin="0,4,0,10" />

                    <TextBlock Text="Motivo (se pendente / em espera)" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtMotivoPendente" Margin="0,4,0,10" />
                </StackPanel>
            </ScrollViewer>

            <!-- ===================== COLUNA 2 — Equipamento envolvido ===================== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Equipamento intervencionado no local -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="+ Adicionar" Padding="10,4" Click="AdicionarIntervencionado_Click" />
                            <TextBlock Text="Equipamento reparado no local" FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid x:Name="GridIntervencionados" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" RowHeight="26">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nº Série" Binding="{Binding NumeroSerie}" Width="Auto" />
                                <DataGridTextColumn Header="Nº Inventário" Binding="{Binding NumeroInventario}" Width="Auto" />
                                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                                <DataGridTemplateColumn Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Padding="4,0" Click="RemoverIntervencionado_Click" ToolTip="Remover da lista" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Equipamento a recolher -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="+ Adicionar" Padding="10,4" Click="AdicionarRecolhido_Click" />
                            <TextBlock Text="Equipamento a recolher (vai para a DISIA)" FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid x:Name="GridRecolhidos" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" RowHeight="26">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nº Série" Binding="{Binding NumeroSerie}" Width="Auto" />
                                <DataGridTextColumn Header="Nº Inventário" Binding="{Binding NumeroInventario}" Width="Auto" />
                                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                                <DataGridTemplateColumn Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Padding="4,0" Click="RemoverRecolhido_Click" ToolTip="Remover da lista" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Equipamento a abater -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="+ Adicionar" Padding="10,4" Click="AdicionarAbatido_Click" />
                            <TextBlock Text="Equipamento a abater" FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid x:Name="GridAbatidos" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" RowHeight="26">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nº Série" Binding="{Binding NumeroSerie}" Width="Auto" />
                                <DataGridTextColumn Header="Nº Inventário" Binding="{Binding NumeroInventario}" Width="Auto" />
                                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                                <DataGridTemplateColumn Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Padding="4,0" Click="RemoverAbatido_Click" ToolTip="Remover da lista" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===================== COLUNA 3 — Equipamento recolhido da escola ===================== -->
            <!-- Grid de duas linhas iguais (em vez de um único DockPanel, onde "Equipamento novo
                 entregue" ficava pequeno e fixo e "Equipamento atualmente recolhido" ocupava tudo o
                 resto) — a pedido, para nenhuma das duas dominar a outra: nenhuma delas costuma
                 ter muitos itens de cada vez, por isso meio a meio chega para as duas, com scroll
                 próprio sempre que uma tiver mais itens do que cabem na sua metade. -->
            <Grid Grid.Column="4" Margin="0,3,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <!-- Equipamento que ainda nem existe no inventário — ao contrário das outras
                         três listas (que escolhem equipamento JÁ existente, através de
                         EquipamentoPickerWindow), "+ Adicionar" aqui abre logo o formulário "Novo
                         Equipamento" (com a escola desta intervenção já pré-selecionada), para
                         registar equipamento novo (ex.: um lote de computadores comprado e
                         guardado na DISIA, nunca antes atribuído a nenhuma escola) e entregá-lo já
                         a esta escola no mesmo passo — ver AdicionarNovoEntregue_Click em
                         IntervencaoEditWindow.xaml.cs. -->
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="+ Adicionar" Padding="10,4" Click="AdicionarNovoEntregue_Click" />
                            <TextBlock Text="Equipamento novo entregue" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"
                                   Text="Equipamento que ainda não existe no inventário — abre o formulário de Novo Equipamento (com a escola já pré-selecionada) para o registar e entregar aqui, sem passar por recolha nem reparação." />
                        <DataGrid x:Name="GridNovosEntregues" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" RowHeight="26">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nº Série" Binding="{Binding NumeroSerie}" Width="Auto" />
                                <DataGridTextColumn Header="Nº Inventário" Binding="{Binding NumeroInventario}" Width="Auto" />
                                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                                <DataGridTemplateColumn Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Padding="4,0" Click="RemoverNovoEntregue_Click" ToolTip="Remover da lista" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Equipamento atualmente recolhido desta escola" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap" />
                        <TextBlock DockPanel.Dock="Top" Text="Depois de reparado, use o botão Devolver para o entregar de volta à escola."
                                   FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <TextBlock x:Name="TxtSemRecolhidos" DockPanel.Dock="Bottom" Text="Sem equipamento recolhido para esta escola."
                                   Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Visibility="Collapsed" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ListaRecolhidosEscola">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushBackground}" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding TituloLinha}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SubtituloLinha}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                                <Border Background="{Binding CorFundo}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,4,0,4">
                                                    <TextBlock Text="{Binding Estado}" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                                                </Border>
                                                <Button Content="Devolver à Escola" Click="DevolverRecolhido_Click" Tag="{Binding Id}"
                                                        IsEnabled="{Binding PodeDevolver}" HorizontalAlignment="Left" Padding="8,4"
                                                        ToolTip="Só é possível devolver depois de a Atividade DISIA de reparação ser fechada." />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="📄 Importar do PDF" Style="{StaticResource AdminButtonIndigo}" Click="ImportarPdf_Click" Padding="12,6" Margin="0,0,8,0" />
            <Button x:Name="BtnImprimirPdf" Content="🖨️ Imprimir Relatório (PDF)" Click="ImprimirPdf_Click" Padding="12,6" IsEnabled="False" Margin="0,0,8,0" />
            <Button Content="Cancelar" Click="Cancelar_Click" Margin="0,0,8,0" Padding="16,6" />
            <Button Content="Guardar Intervenção" Style="{StaticResource PrimaryButton}" Click="Guardar_Click" Padding="16,6" />
        </StackPanel>
    </Grid>
</Window>
