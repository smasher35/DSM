<Window x:Class="LeiriaDISIA.Views.AgrupamentoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agrupamento" Height="580" Width="860" MinHeight="420" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitulo" Grid.Row="0" Text="Novo Agrupamento" Style="{StaticResource SectionTitleStyle}"
                   FontSize="18" Margin="0,0,0,16" />

        <!-- Layout em modo paisagem: duas colunas lado a lado para se ver tudo sem scroll -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Coluna esquerda: identificação do agrupamento -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Código do Agrupamento" FontWeight="SemiBold" />
                <TextBox x:Name="TxtCodigo" Margin="0,4,0,10" />

                <TextBlock Text="Nome do Agrupamento" FontWeight="SemiBold" />
                <TextBox x:Name="TxtNome" Margin="0,4,0,10" />

                <TextBlock Text="Abreviatura" FontWeight="SemiBold" />
                <TextBox x:Name="TxtAbreviatura" Margin="0,4,0,2" MaxLength="12" />
                <TextBlock Text="Usada nos gráficos do Dashboard em vez do nome completo (ex.: &quot;AE Leiria&quot;)."
                           TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" />

                <TextBlock Text="Diretor do Agrupamento" FontWeight="SemiBold" />
                <TextBox x:Name="TxtDiretor" Margin="0,4,0,10" />

                <TextBlock Text="Morada" FontWeight="SemiBold" />
                <TextBox x:Name="TxtMorada" Margin="0,4,0,10" />

                <TextBlock Text="Observações" FontWeight="SemiBold" />
                <TextBox x:Name="TxtObservacoes" AcceptsReturn="True" Height="90" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Coluna direita: contactos -->
            <StackPanel Grid.Column="2">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Contacto 1" FontWeight="SemiBold" />
                        <TextBox x:Name="TxtContacto1" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Contacto 2" FontWeight="SemiBold" />
                        <TextBox x:Name="TxtContacto2" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Contacto 3" FontWeight="SemiBold" />
                <TextBox x:Name="TxtContacto3" Margin="0,4,0,10" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Email 1" FontWeight="SemiBold" />
                        <TextBox x:Name="TxtEmail1" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Email 2" FontWeight="SemiBold" />
                        <TextBox x:Name="TxtEmail2" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Site" FontWeight="SemiBold" />
                <TextBox x:Name="TxtSite" Margin="0,4,0,10" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Click="Cancelar_Click" Margin="0,0,8,0" />
            <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Click="Guardar_Click" />
        </StackPanel>
    </Grid>
</Window>
