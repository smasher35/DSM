<Window x:Class="LeiriaDISIA.Views.PesquisaAvancadaEquipamentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pesquisa Avançada de Equipamento" Width="1080" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Pesquisa Avançada de Equipamento" Style="{StaticResource SectionTitleStyle}" FontSize="18" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Text="Cada filtro começa sempre pelo Tipo de Equipamento (a escolha prioritária — Computador, Monitor, Impressora, Access Point, etc., configurados em Dados Fixos), seguido de um Subtipo/Característica opcional (Marca, Modelo, Processador, Disco, etc., consoante o tipo escolhido) — deixe o Subtipo em branco para filtrar só pelo tipo (ex.: todos os Computadores), ou escolha um para refinar (ex.: Tipo de Disco = SSD, Memória (GB) &gt; 8). Vários filtros combinam-se sempre com E."
                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,14" />

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PainelFiltros" />
                </ScrollViewer>
                <Button x:Name="BtnAdicionarFiltro" Content="➕ Adicionar Filtro" Click="AdicionarFiltro_Click"
                        HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="TxtResultado" Grid.Row="0" Text="Ainda não pesquisou — clique em &quot;Pesquisar&quot;."
                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="4,0,0,6" />
                <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="150" />
                        <DataGridTextColumn Header="Marca / Modelo" Binding="{Binding MarcaModelo}" Width="190" />
                        <DataGridTextColumn Header="Nº de Série" Binding="{Binding NumeroSerie}" Width="120" />
                        <DataGridTextColumn Header="Escola / Local" Binding="{Binding EscolaOuLocal}" Width="190" />
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnPesquisar" Content="🔍 Pesquisar" Click="Pesquisar_Click" Margin="0,0,10,0" />
            <Button x:Name="BtnGerarPdf" Content="📋 Gerar PDF" Style="{StaticResource PrimaryButton}" Click="GerarPdf_Click" IsEnabled="False" Margin="0,0,10,0" />
            <Button x:Name="BtnFechar" Content="Fechar" Click="Fechar_Click" />
        </StackPanel>
    </Grid>
</Window>
