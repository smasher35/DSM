<Window x:Class="LeiriaDISIA.Views.EquipamentoAbatidoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Equipamento Abatido — Gestão DISIA" WindowState="Maximized"
        Background="{StaticResource BrushBackground}" FontFamily="Segoe UI">
    <DockPanel Margin="24">
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="🏠 Menu Principal" Style="{StaticResource MenuPrincipalButton}" Click="MenuPrincipal_Click" Margin="0,0,10,0" />
                <Button Content="➕ Registar Abate" Style="{StaticResource PrimaryButton}" Click="Inserir_Click" Margin="0,0,10,0" />
                <Button Content="📄 Relatório do Módulo" Style="{StaticResource ReportButton}" Click="Relatorio_Click" Margin="0,0,30,0" />
                <TextBox x:Name="TxtPesquisa" Style="{StaticResource SearchTextBox}" Width="280" TextChanged="Filtro_TextChanged"
                         ToolTip="Pesquisar por nº série, descrição ou escola" />
                <TextBlock Text="Equipamento Abatido" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" Margin="30,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Grid de uma só linha "*" em vez de StackPanel, para a DataGrid ocupar sempre todo o
             espaço livre até ao fundo da janela (mesmo padrão do módulo Atividades DISIA — ver
             Views/DisiaWindow.xaml). -->
        <Grid>
            <Border Style="{StaticResource CardStyle}">
                <DataGrid x:Name="Grid" CanUserSortColumns="True" MouseDoubleClick="Grid_MouseDoubleClick" RowStyle="{StaticResource DataGridRowClickableStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data Abate" Binding="{Binding DataAbate, StringFormat=dd-MM-yyyy}" Width="Auto" ElementStyle="{StaticResource CenteredCellTextStyle}" />
                        <DataGridTextColumn Header="Equipamento (Nº Série)" Binding="{Binding Equipamento.NumeroSerie}" Width="Auto" />
                        <DataGridTextColumn Header="Descrição" Binding="{Binding DescricaoEquipamento}" Width="*" />
                        <DataGridTextColumn Header="Escola/Local" Binding="{Binding EscolaOuLocal}" Width="Auto" />
                        <!-- (7.1) Apenas o título da coluna passa a "Estado" — a propriedade
                             Status do modelo mantém-se inalterada (ver Models e base de dados). -->
                        <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="Auto" ElementStyle="{StaticResource CenteredCellTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
