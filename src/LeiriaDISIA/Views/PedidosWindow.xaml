<Window x:Class="LeiriaDISIA.Views.PedidosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pedidos de Intervenção — Gestão DISIA" WindowState="Maximized"
        Background="{StaticResource BrushBackground}" FontFamily="Segoe UI">
    <DockPanel Margin="24">
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="🏠 Menu Principal" Style="{StaticResource MenuPrincipalButton}" Click="MenuPrincipal_Click" Margin="0,0,10,0" />
                <Button x:Name="BtnInserir" Content="➕ Inserir Pedido" Style="{StaticResource PrimaryButton}" Click="Inserir_Click" Margin="0,0,10,0" />
                <Button Content="🗺️ Planear Rota" Style="{StaticResource ReportButton}" Click="PlanearRota_Click" Margin="0,0,10,0" Background="#FF6423F7" />
                <Button Content="📄 Relatório do Módulo" Style="{StaticResource ReportButton}" Click="Relatorio_Click" Margin="0,0,20,0" />
                <CheckBox x:Name="ChkMostrarConcluidos" Content="Mostrar concluídos/cancelados" VerticalAlignment="Center"
                          Checked="ChkMostrarConcluidos_Changed" Unchecked="ChkMostrarConcluidos_Changed" Margin="0,0,20,0" />
                <TextBox x:Name="TxtPesquisa" Style="{StaticResource SearchTextBox}" Width="280" TextChanged="Filtro_TextChanged"
                         ToolTip="Pesquisar por escola, agrupamento ou razão" />
                <TextBlock Text="Pedidos de Intervenção" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" Margin="30,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Grid com linhas Auto (legendas) + "*" (DataGrid) + Auto (dica), em vez de StackPanel,
             para a lista de pedidos ocupar sempre todo o espaço livre até ao fundo da janela
             (mesmo padrão do módulo Atividades DISIA — ver Views/DisiaWindow.xaml). -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Legenda primeiro, cartões de resumo a seguir (a pedido) — mesmo estilo de cartão
                 (CardStyle/KpiValueStyle/KpiLabelStyle) já usado no módulo Equipamentos, para este
                 módulo ficar visualmente consistente com os restantes. Calculados sempre sobre
                 TODOS os pedidos (_todos), não sobre a lista filtrada/pesquisada visível na grelha —
                 são estatísticas do módulo como um todo, não "o que está a ser visto agora". -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="8" Padding="10">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="12" Height="12" Fill="#22C55E" Margin="0,0,4,0" />
                        <TextBlock Text="≤ 7 dias" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Ellipse Width="12" Height="12" Fill="#F59E0B" Margin="0,0,4,0" />
                        <TextBlock Text="8 a 21 dias" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Ellipse Width="12" Height="12" Fill="#EF4444" Margin="0,0,4,0" />
                        <TextBlock Text="&gt; 21 dias em aberto" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <!-- (7.1) Legenda dos quadrados de cor da coluna "Estado" -->
                <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="8" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Estados:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" />
                        <ItemsControl x:Name="LegendaEstados">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                        <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2"
                                                   Fill="{Binding Cor, Converter={StaticResource HexColorToBrushConverter}}" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding Nome}" VerticalAlignment="Center" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,12">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="📋" FontSize="20" Margin="0,0,0,4" />
                        <TextBlock x:Name="TxtCardEmAberto" Text="0" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="Pedidos em Aberto" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"
                        ToolTip="Pedidos Pendentes ou Em Andamento há mais de 21 dias — os que estão 'Em Espera' não contam aqui, já que essa demora não depende da DISIA">
                    <StackPanel>
                        <TextBlock Text="⏰" FontSize="20" Margin="0,0,0,4" />
                        <TextBlock x:Name="TxtCardUrgentes" Text="0" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="&gt; 21 dias em Aberto" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"
                        ToolTip="Pedidos CONCLUÍDOS este ano, venham de quando vierem — inclui pedidos feitos em anos/meses anteriores que só foram fechados agora. Exclui o tempo em que cada pedido esteve 'Em Espera' (não é da responsabilidade da DISIA, depende de terceiros — ex.: aquisição de equipamento/material).">
                    <StackPanel>
                        <TextBlock Text="📊" FontSize="20" Margin="0,0,0,4" />
                        <TextBlock x:Name="TxtCardMediaAno" Text="—" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="Tempo Médio Conclusão (Ano)" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"
                        ToolTip="Só pedidos FEITOS este mês (e já concluídos) — ao contrário do cartão do Ano, um pedido de um mês anterior que só agora fica concluído não entra aqui, para não misturar a sua duração toda com o desempenho deste mês. Exclui o tempo em que cada pedido esteve 'Em Espera' (não é da responsabilidade da DISIA, depende de terceiros — ex.: aquisição de equipamento/material).">
                    <StackPanel>
                        <TextBlock Text="📅" FontSize="20" Margin="0,0,0,4" />
                        <TextBlock x:Name="TxtCardMediaMes" Text="—" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="Tempo Médio Conclusão (Mês)" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"
                        ToolTip="O mesmo cálculo do cartão anterior (só pedidos FEITOS no mês, já concluídos, sem contar tempo 'Em Espera'), mas para o mês anterior a este — serve de termo de comparação para saber se o mês corrente está a correr melhor ou pior.">
                    <StackPanel>
                        <TextBlock Text="📆" FontSize="20" Margin="0,0,0,4" />
                        <TextBlock x:Name="TxtCardMediaMesAnterior" Text="—" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="Tempo Médio Conclusão (Mês Anterior)" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="✅" FontSize="20" Margin="0,0,0,4" />
                        <TextBlock x:Name="TxtCardConcluidosAno" Text="0" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="Concluídos este Ano" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <DataGrid x:Name="Grid" CanUserSortColumns="True" MouseDoubleClick="Grid_MouseDoubleClick" RowStyle="{StaticResource DataGridRowClickableStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data" Binding="{Binding DataPedido, StringFormat=dd-MM-yyyy}" Width="Auto" />
                        <DataGridTextColumn Header="Cód. GEPE" Binding="{Binding Escola.CodGEPE}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center" /></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Escola" Binding="{Binding Escola.Nome}" Width="Auto" />
                        <DataGridTextColumn Header="Agrupamento" Binding="{Binding Agrupamento.Nome}" Width="Auto" />
                        <DataGridTextColumn Header="Nº SIGA" Binding="{Binding NumeroSuporteSiga}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center" /></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Razão" Binding="{Binding Razao}" Width="*" />
                        <DataGridTemplateColumn Header="Estado" Width="Auto" SortMemberPath="Estado">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource BadgeRectStyle}"
                                            Background="{Binding CorEstado, Converter={StaticResource HexColorToBrushConverter}}">
                                        <!-- (2.1) Idem: mostrava o nome técnico do enum sem este Converter. -->
                                        <TextBlock Text="{Binding Estado, Converter={StaticResource EstadoPedidoNomeExibicaoConverter}}" Style="{StaticResource BadgeTextStyle}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- A pedido, para se conseguir verificar diretamente quais pedidos entram
                             em cada mês/ano nos cartões "Tempo Médio Conclusão" acima — esses cartões
                             agrupam por DATA DE CONCLUSÃO, não pela data do pedido (coluna "Data"),
                             por isso um pedido feito há meses mas só concluído agora conta para o
                             mês corrente, com a duração toda desde que foi pedido; sem esta coluna,
                             isso não era visível na grelha (ordenada por "Data", não por esta). Em
                             branco para pedidos ainda não concluídos. -->
                        <DataGridTextColumn Header="Data Conclusão" Binding="{Binding DataConclusao, StringFormat=dd-MM-yyyy}" Width="Auto" />
                        <DataGridTemplateColumn Header="Tempo em Aberto" Width="Auto" SortMemberPath="DiasEmAberto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource BadgePillStyle}"
                                            Background="{Binding CorTempoEmAberto, Converter={StaticResource HexColorToBrushConverter}}">
                                        <TextBlock Text="{Binding DiasEmAberto, StringFormat={}{0} dia(s)}" Style="{StaticResource BadgeTextStyle}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <TextBlock Grid.Row="3" Text="💡 Duplo-clique num pedido para ver/editar detalhes ou criar a intervenção correspondente."
                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,8,0,0" />
        </Grid>
    </DockPanel>
</Window>
