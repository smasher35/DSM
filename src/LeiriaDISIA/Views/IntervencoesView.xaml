<UserControl x:Class="LeiriaDISIA.Views.IntervencoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Intervenções" Style="{StaticResource SectionTitleStyle}" FontSize="24" Margin="0,0,20,0" />
                <TextBlock Text="Ano:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="CmbAno" Width="90" SelectionChanged="Filtro_Changed" Margin="0,0,16,0" />
                <TextBlock Text="Mês:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="CmbMes" Width="130" SelectionChanged="Filtro_Changed" Margin="0,0,16,0" />
                <TextBlock Text="Agrupamento:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="CmbAgrupamentoFiltro" Width="220" DisplayMemberPath="Nome" SelectionChanged="Filtro_Changed" />
            </StackPanel>
            <Border Style="{StaticResource CardStyle}">
                <DataGrid x:Name="Grid" Height="600" CanUserSortColumns="True" SelectionChanged="Grid_SelectionChanged" RowStyle="{StaticResource DataGridRowClickableStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd-MM-yyyy}" Width="Auto" />
                        <DataGridTextColumn Header="Cód. GEPE" Binding="{Binding Escola.CodGEPE}" Width="Auto" />
                        <DataGridTextColumn Header="Escola" Binding="{Binding Escola.Nome}" Width="Auto" />
                        <DataGridTextColumn Header="Agrupamento" Binding="{Binding Agrupamento.Nome}" Width="Auto" />
                        <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Nova Intervenção / Detalhe" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Data" FontWeight="SemiBold" />
                    <DatePicker x:Name="DpData" Margin="0,4,0,10" />

                    <TextBlock Text="Escola" FontWeight="SemiBold" />
                    <ComboBox x:Name="CmbEscola" DisplayMemberPath="Nome" Margin="0,4,0,10" />

                    <TextBlock Text="Descrição / Tipo de Intervenção" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtDescricao" AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,4,0,10" />

                    <TextBlock Text="Categorias" FontWeight="SemiBold" />
                    <ItemsControl x:Name="ListaCategorias" Margin="0,4,0,10" />

                    <TextBlock Text="Material Recolhido / Abatido" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtMaterial" Margin="0,4,0,10" />

                    <TextBlock Text="Estado" FontWeight="SemiBold" />
                    <ComboBox x:Name="CmbEstado" Margin="0,4,0,10" />

                    <TextBlock Text="Motivo (se pendente)" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtMotivoPendente" Margin="0,4,0,16" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Click="Guardar_Click" Margin="0,0,8,0" />
                        <Button Content="Novo" Click="Novo_Click" Margin="0,0,8,0" />
                        <Button Content="Eliminar" Click="Eliminar_Click" Background="#FDECEC" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
