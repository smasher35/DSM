<Window x:Class="LeiriaDISIA.Views.ComunicacoesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comunicações — Gestão DISIA" WindowState="Maximized"
        Background="{StaticResource BrushBackground}" FontFamily="Segoe UI">
    <DockPanel Margin="24">
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="🏠 Menu Principal" Style="{StaticResource MenuPrincipalButton}" Click="MenuPrincipal_Click" Margin="0,0,10,0" />
                <Button Content="➕ Nova Ligação" Style="{StaticResource PrimaryButton}" Click="Inserir_Click" Margin="0,0,10,0" />
                <Button Content="📄 Relatório do Módulo" Style="{StaticResource ReportButton}" Click="Relatorio_Click" Margin="0,0,20,0" />
                <CheckBox x:Name="ChkApenasNaoIntegrados" Content="Mostrar apenas não integrados" VerticalAlignment="Center"
                          Checked="ChkApenasNaoIntegrados_Changed" Unchecked="ChkApenasNaoIntegrados_Changed" Margin="0,0,20,0" />
                <TextBox x:Name="TxtPesquisa" Style="{StaticResource SearchTextBox}" Width="280" TextChanged="Filtro_TextChanged"
                         ToolTip="Pesquisar por escola, operadora ou tipo de ligação" />
                <TextBlock Text="Comunicações" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" Margin="30,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Grid de uma só linha "*" em vez de StackPanel, para a DataGrid ocupar sempre todo o
             espaço livre até ao fundo da janela (mesmo padrão do módulo Atividades DISIA — ver
             Views/DisiaWindow.xaml). -->
        <Grid>
            <Border Style="{StaticResource CardStyle}">
                <DataGrid x:Name="Grid" CanUserSortColumns="True" MouseDoubleClick="Grid_MouseDoubleClick" AutoGenerateColumns="False" IsReadOnly="True" RowStyle="{StaticResource DataGridRowClickableStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Escola" Binding="{Binding Escola.Nome}" Width="*" />
                        <DataGridTextColumn Header="Tipo de Ligação" Binding="{Binding TipoLigacao}" Width="Auto" />
                        <DataGridTextColumn Header="Velocidade" Binding="{Binding VelocidadeFibra}" Width="Auto" />
                        <DataGridTextColumn Header="Operadora" Binding="{Binding Operadora}" Width="Auto" />
                        <DataGridTextColumn Header="Nº Contrato" Binding="{Binding NumeroContrato}" Width="Auto" />
                        <DataGridTextColumn Header="Data Instalação" Binding="{Binding DataInstalacao, StringFormat=dd-MM-yyyy}" Width="Auto" />
                        <DataGridCheckBoxColumn Header="Integrado" Binding="{Binding Integrado}" Width="Auto" />
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
