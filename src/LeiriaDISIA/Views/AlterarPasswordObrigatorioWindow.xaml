<Window x:Class="LeiriaDISIA.Views.AlterarPasswordObrigatorioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alteração de Password Obrigatória — Gestão DISIA" Height="480" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BrushPrimary}"
        Closing="Window_Closing">
    <Border Background="White" CornerRadius="16" Margin="24" Padding="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="🔑" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock Text="Alteração de Password Obrigatória" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" />
            <TextBlock Text="A sua password atual é temporária. Defina uma nova password para continuar."
                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,24" />

            <TextBlock Text="Nova Password" FontWeight="SemiBold" />
            <PasswordBox x:Name="TxtNovaPassword" Margin="0,4,0,14" Padding="8" FontSize="14" />

            <TextBlock Text="Confirmar Nova Password" FontWeight="SemiBold" />
            <PasswordBox x:Name="TxtConfirmarNovaPassword" Margin="0,4,0,6" Padding="8" FontSize="14" KeyDown="TxtConfirmarNovaPassword_KeyDown" />

            <TextBlock x:Name="TxtErro" Foreground="#EF4444" FontSize="12" TextWrapping="Wrap"
                       Margin="0,4,0,10" Visibility="Collapsed" />

            <Button x:Name="BtnOk" Content="OK" Style="{StaticResource PrimaryButton}"
                    Padding="0,10" FontSize="14" Margin="0,10,0,0" Click="Ok_Click" />

            <TextBlock Text="A password mínima deve ter 8 caracteres, com maiúscula, minúscula, número e símbolo."
                       FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0" />
        </StackPanel>
    </Border>
</Window>
