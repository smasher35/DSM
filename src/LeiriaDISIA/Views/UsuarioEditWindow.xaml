<Window x:Class="LeiriaDISIA.Views.UsuarioEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Utilizador" Height="660" Width="980" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}"
        MinHeight="600" MinWidth="900" SizeToContent="Manual">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TxtTitulo" Grid.Row="0" Text="Novo Utilizador" Style="{StaticResource SectionTitleStyle}"
                       FontSize="18" Margin="0,0,0,16" />

            <!-- Conteúdo principal em 3 colunas (modo paisagem) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Coluna 1: Avatar -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Avatar" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="12"
                            Background="#F9F9F9">
                        <StackPanel>
                            <Border HorizontalAlignment="Center" Width="100" Height="100" Background="White"
                                    CornerRadius="50" BorderBrush="#E0E0E0" BorderThickness="2" Margin="0,0,0,12"
                                    ClipToBounds="True">
                                <Grid>
                                    <!-- Background placeholder -->
                                    <Ellipse Fill="#E0E0E0" />
                                    <!-- Imagem redimensionada -->
                                    <Image x:Name="AvatarPreview"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <!-- Iniciais como fallback -->
                                    <TextBlock x:Name="AvatarInitialsPreview" Text="?"
                                               FontSize="36" FontWeight="Bold" Foreground="#999999"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Button x:Name="BtnCarregarAvatar" Content="📁 Selecionar Imagem"
                                    Click="CarregarAvatar_Click" HorizontalAlignment="Center"
                                    Background="#3498DB" Foreground="White" BorderBrush="Transparent"
                                    Padding="12,8" FontWeight="SemiBold" Margin="0,0,0,6" Cursor="Hand" />
                            <Button x:Name="BtnRemoverAvatar" Content="🗑️ Remover Avatar" IsEnabled="False"
                                    Click="RemoverAvatar_Click" HorizontalAlignment="Center"
                                    Background="#E74C3C" Foreground="White" BorderBrush="Transparent"
                                    Padding="12,8" FontWeight="SemiBold" Cursor="Hand" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="* Campos de preenchimento obrigatório" FontSize="10.5" FontStyle="Italic"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,14,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Coluna 2: Dados principais -->
                <StackPanel Grid.Column="2">
                    <TextBlock FontWeight="SemiBold">
                        <Run Text="Nome de Utilizador (login)" />
                        <Run Text=" *" Foreground="{StaticResource BrushDanger}" FontWeight="Bold" />
                    </TextBlock>
                    <TextBox x:Name="TxtNomeUtilizador" Margin="0,4,0,12" Padding="6,5" />

                    <TextBlock Text="Nome Completo" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtNomeCompleto" Margin="0,4,0,12" Padding="6,5" />

                    <TextBlock FontWeight="SemiBold">
                        <Run Text="Email" />
                        <Run Text=" *" Foreground="{StaticResource BrushDanger}" FontWeight="Bold" />
                    </TextBlock>
                    <TextBox x:Name="TxtEmail" Margin="0,4,0,4" Padding="6,5" />
                    <TextBlock Text="Utilizado para o envio da notificação de criação de conta."
                               FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,12"
                               TextWrapping="Wrap" />

                    <TextBlock Text="Perfil" FontWeight="SemiBold" />
                    <ComboBox x:Name="CmbPerfil" Margin="0,4,0,14" Padding="6,5" />

                    <CheckBox x:Name="ChkAtivo" Content="Utilizador ativo" IsChecked="True" Margin="0,0,0,4" />
                </StackPanel>

                <!-- Coluna 3: Palavra-passe -->
                <StackPanel Grid.Column="4">
                    <TextBlock x:Name="TxtRotuloPassword" Text="Palavra-passe" FontWeight="SemiBold" />
                    <PasswordBox x:Name="TxtPassword" Margin="0,4,0,6" Padding="6,5" PasswordChanged="TxtPassword_PasswordChanged" />

                    <!-- Barra de força da palavra-passe: 5 segmentos, um por regra cumprida -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border x:Name="SegBar1" Width="46" Height="6" CornerRadius="3" Background="#E5E7EB" Margin="0,0,4,0" />
                        <Border x:Name="SegBar2" Width="46" Height="6" CornerRadius="3" Background="#E5E7EB" Margin="0,0,4,0" />
                        <Border x:Name="SegBar3" Width="46" Height="6" CornerRadius="3" Background="#E5E7EB" Margin="0,0,4,0" />
                        <Border x:Name="SegBar4" Width="46" Height="6" CornerRadius="3" Background="#E5E7EB" Margin="0,0,4,0" />
                        <Border x:Name="SegBar5" Width="46" Height="6" CornerRadius="3" Background="#E5E7EB" />
                    </StackPanel>

                    <!-- Notificação com as regras da palavra-passe, atualizada em tempo real -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="A palavra-passe tem de cumprir todas as regras:" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6" />
                            <TextBlock x:Name="RegraComprimento" Text="○  Mínimo de 8 caracteres" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,2" />
                            <TextBlock x:Name="RegraMaiuscula" Text="○  Pelo menos uma letra maiúscula (A-Z)" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,2" />
                            <TextBlock x:Name="RegraMinuscula" Text="○  Pelo menos uma letra minúscula (a-z)" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,2" />
                            <TextBlock x:Name="RegraNumero" Text="○  Pelo menos um número (0-9)" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,2" />
                            <TextBlock x:Name="RegraSimbolo" Text="○  Pelo menos um símbolo (ex: ! @ # $ % *)" FontSize="11" Foreground="#9CA3AF" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Confirmar Palavra-passe" FontWeight="SemiBold" />
                    <PasswordBox x:Name="TxtConfirmarPassword" Margin="0,4,0,4" Padding="6,5" PasswordChanged="TxtConfirmarPassword_PasswordChanged" />
                    <TextBlock x:Name="TxtFeedbackConfirmacao" FontSize="11" Margin="0,0,0,6" />

                    <TextBlock x:Name="TxtAvisoPassword" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"
                               Text="Deixe ambos os campos em branco para manter a palavra-passe atual." TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- Rodapé com ações -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancelar" Click="Cancelar_Click" Margin="0,0,8,0" Padding="16,8" />
                <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Click="Guardar_Click" Padding="16,8" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
