<Window x:Class="LeiriaDISIA.Views.InputTextoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Introduzir Valor" Width="460" SizeToContent="Height" MinHeight="220"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock x:Name="TxtMensagem" TextWrapping="Wrap" Margin="0,0,0,16" FontSize="14" />
        <TextBox x:Name="TxtInput" Margin="0,0,0,24" Padding="8" FontSize="14" Height="34" VerticalContentAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Click="Cancelar_Click" Margin="0,0,8,0" Padding="14,8" />
            <Button Content="Confirmar" Style="{StaticResource PrimaryButton}" Click="Confirmar_Click" Padding="14,8" />
        </StackPanel>
    </StackPanel>
</Window>
