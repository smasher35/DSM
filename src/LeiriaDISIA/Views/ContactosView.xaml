<UserControl x:Class="LeiriaDISIA.Views.ContactosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Contactos" Style="{StaticResource SectionTitleStyle}" FontSize="24" Margin="0,0,20,0" />
                <TextBox x:Name="TxtPesquisa" Style="{StaticResource SearchTextBox}" Width="260" TextChanged="Filtro_Changed"
                         ToolTip="Pesquisar por nome, escola ou função" />
            </StackPanel>
            <Border Style="{StaticResource CardStyle}">
                <DataGrid x:Name="Grid" Height="600" CanUserSortColumns="True" SelectionChanged="Grid_SelectionChanged" RowStyle="{StaticResource DataGridRowClickableStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="Auto" />
                        <DataGridTextColumn Header="Escola" Binding="{Binding Escola.Nome}" Width="Auto" />
                        <DataGridTextColumn Header="Entidade Externa" Binding="{Binding EntidadeExterna}" Width="Auto" />
                        <DataGridTextColumn Header="Função" Binding="{Binding Funcao}" Width="Auto" />
                        <DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="Auto" />
                        <DataGridTextColumn Header="Telemóvel" Binding="{Binding Telemovel}" Width="Auto" />
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Adicionar / Editar Contacto" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Nome" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtNome" Margin="0,4,0,10" />

                    <TextBlock Text="Escola (opcional)" FontWeight="SemiBold" />
                    <ComboBox x:Name="CmbEscola" DisplayMemberPath="Nome" Margin="0,4,0,10" />

                    <TextBlock Text="Entidade Externa" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtEntidadeExterna" Margin="0,4,0,10" />

                    <TextBlock Text="Função" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtFuncao" Margin="0,4,0,10" />

                    <TextBlock Text="Telefone" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtTelefone" Margin="0,4,0,10" />

                    <TextBlock Text="Telemóvel" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtTelemovel" Margin="0,4,0,10" />

                    <TextBlock Text="Email" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtEmail" Margin="0,4,0,10" />

                    <TextBlock Text="Observações" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtObservacoes" AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,4,0,14" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Click="Guardar_Click" Margin="0,0,8,0" />
                        <Button Content="Novo" Click="Novo_Click" Margin="0,0,8,0" />
                        <Button Content="Eliminar" Click="Eliminar_Click" Background="#FDECEC" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
