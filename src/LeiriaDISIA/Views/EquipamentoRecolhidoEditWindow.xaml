<Window x:Class="LeiriaDISIA.Views.EquipamentoRecolhidoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registo de Recolha" Height="660" Width="460" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}">
    <ScrollViewer Margin="20,20,34,20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock x:Name="TxtTitulo" Text="Registar Recolha" Style="{StaticResource SectionTitleStyle}" FontSize="18" />

            <TextBlock Text="Escola (escolha primeiro, para filtrar o equipamento disponível)" FontWeight="SemiBold" />
            <TextBox x:Name="TxtPesquisaEscola" Style="{StaticResource SearchTextBox}" Margin="0,4,0,4" TextChanged="TxtPesquisaEscola_TextChanged" />
            <ComboBox x:Name="CmbEscola" DisplayMemberPath="Nome" Margin="0,0,0,10" SelectionChanged="CmbEscola_SelectionChanged" />

            <TextBlock Text="Equipamento (disponível para recolha, na escola escolhida)" FontWeight="SemiBold" />
            <Grid Margin="0,4,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtEquipamentoSelecionado" Grid.Column="0" IsReadOnly="True" Background="#F1F5F9" />
                <Button x:Name="BtnEscolherEquipamento" Grid.Column="2" Content="Escolher..." Click="EscolherEquipamento_Click" Padding="10,4" />
            </Grid>

            <TextBlock Text="Data de Recolha (automática — data de registo)" FontWeight="SemiBold" />
            <DatePicker x:Name="DpRecolha" Margin="0,4,0,10" IsEnabled="False" />

            <TextBlock Text="Estado" FontWeight="SemiBold" />
            <ComboBox x:Name="CmbEstado" Margin="0,4,0,10" />

            <TextBlock x:Name="TxtDataEntregaLabel" Text="Data de Entrega" FontWeight="SemiBold" />
            <DatePicker x:Name="DpEntrega" Margin="0,4,0,10" />

            <TextBlock Text="Observações" FontWeight="SemiBold" />
            <TextBox x:Name="TxtObservacoes" AcceptsReturn="True" Height="80" TextWrapping="Wrap" Margin="0,4,0,20" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Click="Cancelar_Click" Margin="0,0,8,0" />
                <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Click="Guardar_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
