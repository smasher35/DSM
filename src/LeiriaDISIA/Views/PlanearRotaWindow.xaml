<Window x:Class="LeiriaDISIA.Views.PlanearRotaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Planear Rota de Intervenções" WindowState="Maximized"
        Background="{StaticResource BrushBackground}" FontFamily="Segoe UI">
    <DockPanel Margin="24">
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🗺️ Planear Rota de Intervenções" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" Margin="0,0,30,0" />

                <TextBlock Text="Data" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                <DatePicker x:Name="DpData" Width="130" SelectedDateChanged="DpData_SelectedDateChanged" Margin="0,0,20,0" />

                <TextBlock Text="Hora de Partida" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="TxtHoraPartida" Text="09:00" Width="60" Margin="0,0,20,0"
                         ToolTip="Formato HH:mm" />

                <TextBlock Text="Limite de Horas da Equipa" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="TxtLimiteHoras" Width="50" Margin="0,0,4,0"
                         ToolTip="Deixe em branco para não aplicar limite. Aceita vírgula ou ponto como separador decimal (ex.: 7 ou 7,5)." />
                <TextBlock Text="h" VerticalAlignment="Center" Margin="0,0,20,0" />

                <CheckBox x:Name="ChkRegressarSede" Content="Regressar à sede no final" IsChecked="True"
                          VerticalAlignment="Center" Margin="0,0,20,0" />

                <Button Content="Fechar" Click="Fechar_Click" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>

            <!-- Coluna esquerda: seleção de pedidos elegíveis -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Pedidos elegíveis para este dia" Style="{StaticResource SectionTitleStyle}"
                               FontSize="14" Margin="0,0,0,8" />

                    <DataGrid x:Name="GridPedidos" Grid.Row="1" AutoGenerateColumns="False" CanUserSortColumns="True"
                              RowStyle="{StaticResource DataGridRowClickableStyle}" MouseDoubleClick="GridPedidos_MouseDoubleClick"
                              ToolTip="Duplo-clique num pedido para editar a respetiva escola, incluindo a morada e coordenadas.">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" Width="36" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selecionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" IsEnabled="{Binding Origem.PodeSerSelecionado}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Escola" Binding="{Binding Pedido.Escola.Nome}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Prioridade" Binding="{Binding Pedido.Prioridade}" Width="Auto" IsReadOnly="True" />
                            <DataGridTextColumn Header="Dist. à Sede" Binding="{Binding Pedido.Escola.DistanciaKmSede, StringFormat={}{0:0.#} km}" Width="Auto" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Estado" Width="220" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource BadgeRectStyle}" Background="{Binding CorEstado, Converter={StaticResource HexColorToBrushConverter}}"
                                                    ToolTip="{Binding Bloqueio}" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding EstadoCurto}" Style="{StaticResource BadgeTextStyle}" />
                                            </Border>
                                            <Button Content="↺ Repor" Margin="8,0,0,0" Padding="8,3" FontSize="10.5"
                                                    Visibility="{Binding PodeRepor, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    ToolTip="Cancelar o plano de rota que ainda não foi realizado e libertar este pedido"
                                                    Click="RepordPedido_Click" VerticalAlignment="Center">
                                                <!-- Mesma linguagem visual dos botões "AdminButtonXxx" (Themes/ModernTheme.xaml —
                                                     fundo colorido, cantos arredondados, sem contorno, escurece ao passar o rato),
                                                     só que com padding/tipo de letra mais pequenos, próprios de um botão inline
                                                     dentro de uma célula de tabela — os estilos existentes são pensados para
                                                     botões maiores e avulsos, e ficavam desproporcionados aqui ao lado do selo. -->
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{StaticResource BrushAdminButtonBlue}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                          TextElement.Foreground="White" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource BrushPrimary}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="🗺️ Calcular Rota" x:Name="BtnCalcularRota" Style="{StaticResource PrimaryButton}" Click="CalcularRota_Click" />
                        <TextBlock x:Name="TxtEstadoCalculo" VerticalAlignment="Center" Margin="12,0,0,0"
                                   FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Coluna do meio: pré-visualização da rota calculada (lista de paragens) -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Pré-visualização da rota" Style="{StaticResource SectionTitleStyle}"
                               FontSize="14" Margin="0,0,0,8" />

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10" x:Name="PainelResumo" Visibility="Collapsed">
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="8" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock x:Name="TxtResumoPedidos" Text="0" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="Pedidos" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" />
                            </StackPanel>
                        </Border>
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="8" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock x:Name="TxtResumoDistancia" Text="0 km" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="Distância" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" />
                            </StackPanel>
                        </Border>
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="8">
                            <StackPanel>
                                <TextBlock x:Name="TxtResumoDuracao" Text="0h" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="Duração Total" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border x:Name="PainelAvisos" Grid.Row="2" Background="{StaticResource BrushDangerBackgroundLight}"
                            CornerRadius="6" Padding="8" Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock x:Name="TxtAvisos" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{StaticResource BrushDangerTextDark}" />
                    </Border>

                    <DataGrid x:Name="GridParagens" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <!-- A linha de regresso à sede não é uma paragem "a sério" — só o troço final de
                                         volta, por isso fica visualmente distinta (itálico, mais clara). -->
                                    <DataTrigger Binding="{Binding EhRegresso}" Value="True">
                                        <Setter Property="FontStyle" Value="Italic" />
                                        <Setter Property="Foreground" Value="Gray" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nº" Binding="{Binding Ordem}" Width="34" />
                            <DataGridTextColumn Header="Escola" Binding="{Binding EscolaNome}" Width="*" />
                            <DataGridTextColumn Header="Dist." Binding="{Binding DistanciaDesdeAnteriorKm, StringFormat={}{0:0.#} km}" Width="Auto" />
                            <DataGridTextColumn Header="Duração" Binding="{Binding DuracaoDesdeAnteriorMinutos, StringFormat={}{0} min}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="4" x:Name="BtnConfirmar" Content="✔ Confirmar e Guardar Plano (gera PDF)"
                            Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" IsEnabled="False" Click="Confirmar_Click" />
                </Grid>
            </Border>

            <!-- Coluna direita: mapa com a rota traçada e as paragens assinaladas, construído a
                 partir das mesmas coordenadas já calculadas em CalcularRota_Click — ver
                 AtualizarMapaRotaAsync em PlanearRotaWindow.xaml.cs. Mesma técnica (WebView2 +
                 Google Maps "embed" sem chave de API) já usada em Views/EscolaEditWindow.xaml para
                 mostrar a localização de uma só escola. -->
            <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Mapa da rota" Style="{StaticResource SectionTitleStyle}"
                               FontSize="14" Margin="0,0,0,8" />

                    <Grid Grid.Row="1">
                        <wv2:WebView2 x:Name="MapaRota" Visibility="Collapsed" />
                        <TextBlock x:Name="TxtMapaRotaIndisponivel" Text="Calcule a rota para ver aqui o mapa com as paragens."
                                   TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="240"
                                   FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
