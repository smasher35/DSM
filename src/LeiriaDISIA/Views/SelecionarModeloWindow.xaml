<Window x:Class="LeiriaDISIA.Views.SelecionarModeloWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selecionar Modelo" Width="480" SizeToContent="Height" MaxHeight="600"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BrushBackground}">
    <StackPanel Margin="20">
        <TextBlock x:Name="TxtTitulo" Text="Selecionar Modelo" Style="{StaticResource SectionTitleStyle}" FontSize="16" Margin="0,0,0,4" />
        <TextBlock Text="Escolha um modelo já criado para preencher automaticamente Marca, Modelo e as suas características — os restantes campos (Nº de Série, Escola, etc.) continuam por preencher."
                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,14" />

        <TextBox x:Name="TxtPesquisa" Style="{StaticResource SearchTextBox}" Margin="0,0,0,10"
                 TextChanged="TxtPesquisa_TextChanged" ToolTip="Pesquisar por nome, marca ou modelo" />

        <ListBox x:Name="ListaModelos" MaxHeight="400" BorderThickness="1" BorderBrush="{StaticResource BrushInputBorder}"
                 SelectionChanged="ListaModelos_SelectionChanged" MouseDoubleClick="ListaModelos_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding RotuloExibicao}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="TxtSemModelos" Text="Ainda não há nenhum modelo criado para este Tipo de Equipamento." TextWrapping="Wrap"
                   FontSize="11" FontStyle="Italic" Foreground="{StaticResource BrushTextSecondary}" Margin="0,10,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Click="Cancelar_Click" Margin="0,0,10,0" />
            <Button x:Name="BtnSelecionar" Content="Selecionar" Style="{StaticResource PrimaryButton}" Click="Selecionar_Click" IsEnabled="False" />
        </StackPanel>
    </StackPanel>
</Window>
