<Window x:Class="LeiriaDISIA.Views.AlterarPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alteração de Palavra-passe Obrigatória" Height="400" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BrushPrimary}">
    <Border Background="White" CornerRadius="16" Margin="24" Padding="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="⚠️ Alteração de Palavra-passe Obrigatória" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource BrushDanger}" HorizontalAlignment="Center" Margin="0,0,0,10" />
            
            <TextBlock Text="Por motivos de segurança, deve alterar a palavra-passe antes de continuar."
                       TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}"
                       HorizontalAlignment="Center" Margin="0,0,0,20" />

            <TextBlock Text="Nova Palavra-passe" FontWeight="SemiBold" Margin="0,0,0,4" />
            <PasswordBox x:Name="TxtNovaPassword" Padding="8" FontSize="14" Margin="0,0,0,14" />

            <TextBlock Text="Confirmar Palavra-passe" FontWeight="SemiBold" Margin="0,0,0,4" />
            <PasswordBox x:Name="TxtConfirmarPassword" Padding="8" FontSize="14" Margin="0,0,0,6"
                         KeyDown="TxtConfirmarPassword_KeyDown" />

            <TextBlock x:Name="TxtErro" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap"
                       Margin="0,4,0,10" Visibility="Collapsed" />

            <Button Content="Alterar Palavra-passe" Style="{StaticResource PrimaryButton}"
                    Click="Alterar_Click" Padding="0,10" Margin="0,10,0,0" FontSize="15" />
        </StackPanel>
    </Border>
</Window>
