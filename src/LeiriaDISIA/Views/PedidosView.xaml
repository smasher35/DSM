<UserControl x:Class="LeiriaDISIA.Views.PedidosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="Pedidos de Intervenção" Style="{StaticResource SectionTitleStyle}" FontSize="24" />
            <Border Style="{StaticResource CardStyle}">
                <DataGrid x:Name="Grid" Height="620" CanUserSortColumns="True" SelectionChanged="Grid_SelectionChanged" RowStyle="{StaticResource DataGridRowClickableStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data" Binding="{Binding DataPedido, StringFormat=dd-MM-yyyy}" Width="Auto" />
                        <DataGridTextColumn Header="Escola" Binding="{Binding Escola.Nome}" Width="*" />
                        <DataGridTextColumn Header="Agrupamento" Binding="{Binding Agrupamento.Nome}" Width="Auto" />
                        <DataGridTextColumn Header="Razão" Binding="{Binding Razao}" Width="Auto" />
                        <!-- (2.1) Sem o Converter, mostrava o nome técnico do enum (ex. "EmAndamento") em vez do
                             nome configurado em Dados Fixos → "Estados dos Pedidos" (ex. "Em Andamento"). -->
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado, Converter={StaticResource EstadoPedidoNomeExibicaoConverter}}" Width="Auto" />
                        <DataGridTextColumn Header="Cód. GEPE" Binding="{Binding Escola.CodGEPE}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Novo Pedido / Detalhe" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Data do Pedido" FontWeight="SemiBold" />
                    <DatePicker x:Name="DpData" Margin="0,4,0,10" />

                    <TextBlock Text="Escola" FontWeight="SemiBold" />
                    <ComboBox x:Name="CmbEscola" DisplayMemberPath="Nome" Margin="0,4,0,4"
                              SelectionChanged="CmbEscola_SelectionChanged" />
                    <TextBlock x:Name="TxtDadosEscola" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"
                               TextWrapping="Wrap" Margin="0,0,0,10" />

                    <TextBlock Text="Solicitante" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtSolicitante" Margin="0,4,0,10" />

                    <TextBlock Text="Contacto do solicitante" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtContacto" Margin="0,4,0,10" />

                    <TextBlock Text="Razão do Pedido" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtRazao" AcceptsReturn="True" Height="70" TextWrapping="Wrap" Margin="0,4,0,10" />

                    <TextBlock Text="Estado" FontWeight="SemiBold" />
                    <!-- (2.1) Ver nota igual em PedidoEditWindow.xaml. -->
                    <ComboBox x:Name="CmbEstado" Margin="0,4,0,10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EstadoPedidoNomeExibicaoConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Motivo (se pendente)" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtMotivoPendente" Margin="0,4,0,14" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Click="Guardar_Click" Margin="0,0,8,0" />
                        <Button Content="Novo" Click="Novo_Click" Margin="0,0,8,0" />
                        <Button Content="Eliminar" Click="Eliminar_Click" Background="#FDECEC" />
                    </StackPanel>

                    <Separator Margin="0,4,0,10" />
                    <Button Content="➜ Criar Intervenção a partir deste pedido" Click="CriarIntervencao_Click"
                            Background="#22C55E" Foreground="White" Padding="10,8" />
                    <TextBlock Text="Ao registar a intervenção correspondente, este pedido passa automaticamente a 'Concluído'."
                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
