<UserControl x:Class="LeiriaDISIA.Views.EquipamentoAbatidoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="Equipamento Abatido" Style="{StaticResource SectionTitleStyle}" FontSize="24" />
            <Border Style="{StaticResource CardStyle}">
                <DataGrid x:Name="Grid" Height="600" CanUserSortColumns="True" SelectionChanged="Grid_SelectionChanged" RowStyle="{StaticResource DataGridRowClickableStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data Abate" Binding="{Binding DataAbate, StringFormat=dd-MM-yyyy}" Width="Auto" />
                        <DataGridTextColumn Header="Equipamento (Nº Série)" Binding="{Binding Equipamento.NumeroSerie}" Width="Auto" />
                        <DataGridTextColumn Header="Cód. GEPE" Binding="{Binding Equipamento.Escola.CodGEPE}" Width="Auto" />
                        <DataGridTextColumn Header="Descrição" Binding="{Binding DescricaoEquipamento}" Width="*" />
                        <DataGridTextColumn Header="Escola/Local" Binding="{Binding EscolaOuLocal}" Width="Auto" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Registar Abate" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Equipamento já cadastrado (opcional)" FontWeight="SemiBold" />
                    <ComboBox x:Name="CmbEquipamento" Margin="0,4,0,10" SelectionChanged="CmbEquipamento_SelectionChanged" />

                    <TextBlock Text="Escola / Local" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtEscolaOuLocal" Margin="0,4,0,10" />

                    <TextBlock Text="Descrição do Equipamento" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtDescricao" AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,4,0,10" />

                    <TextBlock Text="N.º de Série" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtNumeroSerie" Margin="0,4,0,10" />

                    <TextBlock Text="N.º de Inventário" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtNumeroInventario" Margin="0,4,0,10" />

                    <TextBlock Text="Data do Abate" FontWeight="SemiBold" />
                    <DatePicker x:Name="DpAbate" Margin="0,4,0,10" />

                    <TextBlock Text="Status" FontWeight="SemiBold" />
                    <ComboBox x:Name="CmbStatus" IsEditable="True" Margin="0,4,0,10" />

                    <TextBlock Text="Observações" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtObservacoes" AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,4,0,14" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Click="Guardar_Click" Margin="0,0,8,0" />
                        <Button Content="Novo" Click="Novo_Click" Margin="0,0,8,0" />
                        <Button Content="Eliminar" Click="Eliminar_Click" Background="#FDECEC" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
