<Window x:Class="LeiriaDISIA.Views.CategoriasDisiaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Categorias de Atividades DISIA" Height="636" Width="1006" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Cores das Categorias de Atividades DISIA" Style="{StaticResource SectionTitleStyle}" FontSize="18" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,8"
                       Text="Esta janela só altera a cor de cada categoria. Para criar, renomear ou eliminar categorias, use Administração → Dados Fixos → Listas de Valores → &quot;Categorias das Atividades DISIA&quot;." />
            <Border Style="{StaticResource CardStyle}">
                <DataGrid x:Name="Grid" Height="420" SelectionChanged="Grid_SelectionChanged" RowStyle="{StaticResource DataGridRowClickableStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" />
                        <DataGridTemplateColumn Header="Cor" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding CorHex, Converter={StaticResource HexColorToBrushConverter}}"
                                            Width="24" Height="18" CornerRadius="4" BorderBrush="#00000022" BorderThickness="1" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Código" Binding="{Binding CorHex}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="2">
            <TextBlock Text="Alterar Cor" Style="{StaticResource SectionTitleStyle}" FontSize="16" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Nome (apenas leitura)" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtNome" Margin="0,4,0,10" IsReadOnly="True" Background="#F3F4F6" Focusable="False" />

                    <TextBlock Text="Cor (formato #RRGGBB)" FontWeight="SemiBold" />
                    <Grid Margin="0,4,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtCor" Grid.Column="0" />
                        <Border Grid.Column="2" Width="28" Height="28" CornerRadius="4" BorderBrush="#00000033" BorderThickness="1"
                                Background="{Binding ElementName=TxtCor, Path=Text, Converter={StaticResource HexColorToBrushConverter}}" />
                        <Button Grid.Column="4" Content="🎨 Escolher Cor..." Click="EscolherCor_Click" Padding="8,4" />
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Guardar Cor" Style="{StaticResource PrimaryButton}" Click="Guardar_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Button Content="Fechar" Click="Fechar_Click" Margin="0,16,0,0" HorizontalAlignment="Right" />
        </StackPanel>
    </Grid>
</Window>
