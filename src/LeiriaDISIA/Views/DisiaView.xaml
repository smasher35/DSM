<UserControl x:Class="LeiriaDISIA.Views.DisiaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- Painel Esquerdo com Grid e RowDefinitions -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="200" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Linha 0: Título e Filtros -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Atividades na DISIA" Style="{StaticResource SectionTitleStyle}" FontSize="24" Margin="0,0,20,0" />
                <TextBlock Text="Ano:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="CmbAno" Width="90" SelectionChanged="Filtro_Changed" Margin="0,0,16,0" />
                <TextBlock Text="Mês:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="CmbMes" Width="130" SelectionChanged="Filtro_Changed" />
            </StackPanel>

            <!-- Linha 1: Cards KPI -->
            <UniformGrid Grid.Row="1" Columns="3" Rows="2" Margin="0,0,0,16" Background="White">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock x:Name="TxtTotalAno" Text="0" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="Atividades (ano)" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock x:Name="TxtTotalMes" Text="0" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="Atividades (mês)" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="TxtTotalQuantidade" Text="0" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="Total de serviços" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock x:Name="TxtLocalMaisIntervencionado" Text="—" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource BrushPrimary}" TextWrapping="Wrap" />
                        <TextBlock Text="Local mais intervencionado" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock x:Name="TxtCategoriaMaisUtilizada" Text="—" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource BrushPrimary}" TextWrapping="Wrap" />
                        <TextBlock Text="Categoria mais usada" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock x:Name="TxtCategoriaMaisIntervencionada" Text="—" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource BrushPrimary}" TextWrapping="Wrap" />
                        <TextBlock Text="Categoria mais intervencionada" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Linha 2: DataGrid com ScrollViewer -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource CardStyle}">
                    <DataGrid x:Name="Grid" MaxHeight="400" CanUserSortColumns="True" SelectionChanged="Grid_SelectionChanged" RowStyle="{StaticResource DataGridRowClickableStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd-MM-yyyy}" Width="Auto" />
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                            <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria.Nome}" Width="Auto" />
                            <DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="Auto" />
                            <DataGridTextColumn Header="Qtd" Binding="{Binding Quantidade}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="TextAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- Painel Direito com ScrollViewer -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Nova Atividade / Detalhe" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Data" FontWeight="SemiBold" />
                    <DatePicker x:Name="DpData" Margin="0,4,0,10" />

                    <TextBlock Text="Descrição" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtDescricao" AcceptsReturn="True" Height="70" TextWrapping="Wrap" Margin="0,4,0,10" />

                    <TextBlock Text="Categoria" FontWeight="SemiBold" />
                    <ComboBox x:Name="CmbCategoria" DisplayMemberPath="Nome" Margin="0,4,0,10" />

                    <TextBlock Text="Local" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtLocal" Margin="0,4,0,10" />

                    <TextBlock Text="Divisão / Serviço envolvido" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtDivisao" Margin="0,4,0,10" />

                    <TextBlock Text="Suporte prestado" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtSuporte" Margin="0,4,0,10" />

                    <TextBlock Text="Quantidade (nº de vezes)" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtQuantidade" Text="1" Margin="0,4,0,10" />

                    <TextBlock Text="Estado" FontWeight="SemiBold" />
                    <ComboBox x:Name="CmbEstado" Margin="0,4,0,10" />

                    <TextBlock Text="Observações" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtObservacoes" AcceptsReturn="True" Height="50" TextWrapping="Wrap" Margin="0,4,0,14" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Click="Guardar_Click" Margin="0,0,8,0" />
                        <Button Content="Novo" Click="Novo_Click" Margin="0,0,8,0" />
                        <Button Content="Eliminar" Click="Eliminar_Click" Background="#FDECEC" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
