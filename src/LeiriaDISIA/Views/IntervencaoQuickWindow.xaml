<Window x:Class="LeiriaDISIA.Views.IntervencaoQuickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registar Intervenção" Height="620" Width="480" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}">
    <ScrollViewer Margin="20,20,34,20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Registar Intervenção" Style="{StaticResource SectionTitleStyle}" FontSize="20" />

            <TextBlock x:Name="TxtEscolaInfo" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" />

            <TextBlock Text="Data da Intervenção" FontWeight="SemiBold" />
            <DatePicker x:Name="DpData" Margin="0,4,0,10" />

            <TextBlock Text="Descrição / Tipo de Intervenção" FontWeight="SemiBold" />
            <TextBox x:Name="TxtDescricao" AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,4,0,10" />

            <TextBlock Text="Categorias envolvidas (selecione uma ou mais)" FontWeight="SemiBold" />
            <ItemsControl x:Name="ListaCategorias" Margin="0,4,0,10" />

            <TextBlock Text="Material Recolhido / Abatido (opcional)" FontWeight="SemiBold" />
            <TextBox x:Name="TxtMaterial" Margin="0,4,0,10" />

            <TextBlock Text="Estado da Intervenção" FontWeight="SemiBold" />
            <ComboBox x:Name="CmbEstado" Margin="0,4,0,10" />

            <TextBlock Text="Motivo (se pendente)" FontWeight="SemiBold" />
            <TextBox x:Name="TxtMotivoPendente" Margin="0,4,0,16" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Click="Cancelar_Click" Margin="0,0,8,0" />
                <Button Content="Guardar Intervenção" Style="{StaticResource PrimaryButton}" Click="Guardar_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
