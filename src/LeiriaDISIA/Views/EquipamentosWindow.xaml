<Window x:Class="LeiriaDISIA.Views.EquipamentosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Equipamento Informático — Gestão DISIA" WindowState="Maximized"
        Background="{StaticResource BrushBackground}" FontFamily="Segoe UI">
    <DockPanel Margin="24">
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="🏠 Menu Principal" Style="{StaticResource MenuPrincipalButton}" Click="MenuPrincipal_Click" Margin="0,0,10,0" />
                <Button x:Name="BtnInserir" Content="➕ Inserir Equipamento" Style="{StaticResource PrimaryButton}" Click="Inserir_Click" Margin="0,0,10,0" />
                <Button Content="📄 Relatório do Módulo" Style="{StaticResource ReportButton}" Click="Relatorio_Click" Margin="0,0,10,0" />
                <Button Content="🗒️ Folha de Inventário" Style="{StaticResource ReportButton}" Click="FolhaInventario_Click" Margin="0,0,10,0" Background="#FF6423F7" />
                <Button Content="📋 Modelos de Equipamento" Click="ModelosEquipamento_Click" Margin="0,0,30,0"
                        ToolTip="Catálogo de modelos base (Marca, Modelo e características) para reutilizar ao inserir equipamento igual" />
                <TextBox x:Name="TxtPesquisa" Style="{StaticResource SearchTextBox}" Width="280" TextChanged="Filtro_Changed"
                         ToolTip="Pesquisar por nº de série, inventário, tipo, marca ou escola" />
                <TextBlock Text="Equipamentos Informáticos" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" Margin="30,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Grid com 3 linhas: cabeçalho (cartões-resumo + gauges + legendas, dentro de um
             ScrollViewer com scroll próprio — ver ScrollCabecalho_Loaded em
             EquipamentosWindow.xaml.cs) + "*" (DataGrid, com MinHeight garantido) + Auto (dica).
             Antes disto, o cabeçalho tinha 4 linhas "Auto" fixas — em ecrãs mais baixos (ex.:
             portáteis de 13"), o seu tamanho natural ultrapassava facilmente a altura da janela, e
             como linhas "Auto" do Grid nunca cedem espaço a uma linha "*", era sempre a lista de
             equipamento (a única linha "*") que ficava esmagada a poucos pixels, quase invisível.
             Ao dar ao cabeçalho um teto de altura (com scroll próprio) e à lista um mínimo
             garantido, a lista fica sempre legível, com o cabeçalho a aparecer por completo (sem
             scroll) sempre que a janela tiver altura suficiente para tal — sem qualquer mudança
             visual em monitores normais/grandes, onde já cabia tudo. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="180" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="ScrollCabecalho" Grid.Row="0" Background="Transparent"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

            <!-- Linha 1 do painel de resumo: total geral + totais dos principais tipos de
                 equipamento. Os valores são calculados em AtualizarResumo() a partir da MESMA
                 lista já filtrada que alimenta a DataGrid (_visiveis), pelo que respeitam
                 automaticamente a pesquisa/filtro ativo e são recalculados sempre que a lista é
                 recarregada. -->
            <UniformGrid Columns="5" Rows="1" Margin="0,0,0,12">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="📋" FontSize="20" Margin="0,0,0,4" />
                        <TextBlock x:Name="TxtTotalGeral" Text="0" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="Total de Equipamentos" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="🖥️" FontSize="20" Margin="0,0,0,4" />
                        <TextBlock x:Name="TxtTotalSecretaria" Text="0" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="Computadores de Secretária" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="💻" FontSize="20" Margin="0,0,0,4" />
                        <TextBlock x:Name="TxtTotalPortateis" Text="0" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="Computadores Portáteis" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="📶" FontSize="20" Margin="0,0,0,4" />
                        <TextBlock x:Name="TxtTotalAccessPoints" Text="0" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="Access Points" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="🔀" FontSize="20" Margin="0,0,0,4" />
                        <TextBlock x:Name="TxtTotalSwitches" Text="0" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="Switches" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Indicador "equipamento/escola/agrupamento com mais equipamentos intervencionados" —
                 junta o histórico no local (IntervencaoEquipamentos) com o de recolha
                 (EquipamentosRecolhidos) — ver AtualizarMaisIntervencionado. Os três níveis usam
                 sempre a mesma base (intervenções/recolhas por EQUIPAMENTO, nunca intervenções
                 gerais sem equipamento associado — estamos no módulo Equipamentos), só agregada de
                 forma diferente: o total da escola/agrupamento é a SOMA dos totais de cada
                 equipamento (não a contagem de equipamentos distintos) — uma intervenção que tenha
                 tocado em 10 computadores diferentes nessa escola conta 10, porque é isso que fica
                 registado em Intervencao → Equipamentos dessa intervenção. Três cartões lado a lado
                 (em vez de três linhas empilhadas) para aproveitar a largura disponível, tal como a
                 linha de gauges por baixo. Cada cartão tem a sua própria visibilidade: só aparece
                 quando há pelo menos uma intervenção registada a esse nível, para não mostrar uma
                 frase vazia/sem sentido numa base de dados nova (ou, no caso de escola/agrupamento,
                 quando não há nenhuma escola/agrupamento identificável no equipamento visível). -->
            <UniformGrid Columns="3" Rows="1" Margin="0,0,0,12">
                <Border x:Name="PainelMaisIntervencionado" Background="#FDECEC" CornerRadius="8" Padding="10" Margin="0,0,10,0" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔧" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Equipamento com mais intervenções" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                            <Run x:Name="TxtMaisIntervencionado" Text="" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border x:Name="PainelEscolaMaisIntervencionada" Background="#FDECEC" CornerRadius="8" Padding="10" Margin="0,0,10,0" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏫" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Escola com mais equipamentos intervencionados" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                            <Run x:Name="TxtEscolaMaisIntervencionada" Text="" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border x:Name="PainelAgrupamentoMaisIntervencionado" Background="#FDECEC" CornerRadius="8" Padding="10" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏘️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Agrupamento com mais equipamentos intervencionados" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                            <Run x:Name="TxtAgrupamentoMaisIntervencionado" Text="" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Linha 2 do painel de resumo: "Distribuição por Obsolescência", "Sistemas
                 Operativos" e "Armazenamento" lado a lado — gauges com o mesmo estilo/controlo
                 usado em "Distribuição do Parque de Equipamento" no Dashboard
                 (ConstruirGaugePercentagem em DashboardView.xaml.cs), reutilizado aqui tal e qual. -->
            <UniformGrid Columns="3" Rows="1" Margin="0,0,0,12">
                <StackPanel Margin="0,0,10,0">
            <Border x:Name="PainelObsolescenciaNormal" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Distribuição por Obsolescência" Style="{StaticResource SectionTitleStyle}" FontSize="16" />
                    <TextBlock x:Name="TxtTotalObsolescencia" TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"
                               Text="% de equipamento em cada nível de obsolescência" />
                    <UniformGrid Columns="3" Rows="1">
                        <Border Margin="0,0,10,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Atual" Style="{StaticResource KpiLabelStyle}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                <lvc:PieChart x:Name="GaugeObsolescenciaAtual" Height="140" Width="140"
                                              InitialRotation="-225" MaxAngle="270" MinValue="0" MaxValue="100" />
                                <TextBlock x:Name="TxtGaugeObsolescenciaAtual" Text="0 / 0" FontSize="11"
                                           HorizontalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,10,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="A Monitorizar" Style="{StaticResource KpiLabelStyle}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                <lvc:PieChart x:Name="GaugeObsolescenciaMonitorizar" Height="140" Width="140"
                                              InitialRotation="-225" MaxAngle="270" MinValue="0" MaxValue="100" />
                                <TextBlock x:Name="TxtGaugeObsolescenciaMonitorizar" Text="0 / 0" FontSize="11"
                                           HorizontalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" />
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Obsoleto" Style="{StaticResource KpiLabelStyle}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                <lvc:PieChart x:Name="GaugeObsolescenciaObsoleto" Height="140" Width="140"
                                              InitialRotation="-225" MaxAngle="270" MinValue="0" MaxValue="100" />
                                <TextBlock x:Name="TxtGaugeObsolescenciaObsoleto" Text="0 / 0" FontSize="11"
                                           HorizontalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Versão compacta do mesmo painel (Modo Compacto — Administração → Aparência):
                 substitui os 3 gauges grandes (140x140 cada) por 3 barras finas com a percentagem
                 ao lado, para dar à lista de equipamento por baixo o máximo de espaço vertical
                 possível em ecrãs pequenos/portáteis. A escolha entre este painel e o normal (acima)
                 é feita uma vez, no construtor (ver EquipamentosWindow.xaml.cs), consoante
                 Services.JanelaCompactaService.Ativo — nunca os dois ao mesmo tempo. -->
            <Border x:Name="PainelObsolescenciaCompacto" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Distribuição por Obsolescência" Style="{StaticResource SectionTitleStyle}" FontSize="14" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Atual" VerticalAlignment="Center" FontSize="12" />
                        <Grid Grid.Column="1" Height="6" Margin="8,0">
                            <Border Background="#E5E7EB" CornerRadius="3" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ColBarraAtualCheia" Width="0*" />
                                    <ColumnDefinition x:Name="ColBarraAtualVazia" Width="100*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#22C55E" CornerRadius="3" />
                            </Grid>
                        </Grid>
                        <TextBlock x:Name="TxtBarraAtual" Grid.Column="2" Text="0 / 0" FontSize="11"
                                   VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" />
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="A Monitorizar" VerticalAlignment="Center" FontSize="12" />
                        <Grid Grid.Column="1" Height="6" Margin="8,0">
                            <Border Background="#E5E7EB" CornerRadius="3" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ColBarraMonitorizarCheia" Width="0*" />
                                    <ColumnDefinition x:Name="ColBarraMonitorizarVazia" Width="100*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#F59E0B" CornerRadius="3" />
                            </Grid>
                        </Grid>
                        <TextBlock x:Name="TxtBarraMonitorizar" Grid.Column="2" Text="0 / 0" FontSize="11"
                                   VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Obsoleto" VerticalAlignment="Center" FontSize="12" />
                        <Grid Grid.Column="1" Height="6" Margin="8,0">
                            <Border Background="#E5E7EB" CornerRadius="3" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ColBarraObsoletoCheia" Width="0*" />
                                    <ColumnDefinition x:Name="ColBarraObsoletoVazia" Width="100*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#EF4444" CornerRadius="3" />
                            </Grid>
                        </Grid>
                        <TextBlock x:Name="TxtBarraObsoleto" Grid.Column="2" Text="0 / 0" FontSize="11"
                                   VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" />
                    </Grid>
                </StackPanel>
            </Border>
                </StackPanel>

                <!-- "Sistemas Operativos" — % de equipamento com cada sistema operativo
                     (computadores de secretária, portáteis, servidores, e qualquer outro
                     equipamento com o campo "Sistema Operativo" preenchido — ex.: tablets, caso
                     essa característica venha a ficar disponível para esse tipo). Ao contrário da
                     Obsolescência (sempre 3 níveis fixos), o nº de sistemas operativos distintos
                     varia consoante o parque real, por isso os gauges/barras são construídos
                     dinamicamente em código (ver AtualizarDistribuicaoPorCampo em
                     EquipamentosWindow.xaml.cs) em vez de existirem já fixos aqui no XAML — este
                     painel único trata tanto o modo normal (gauges) como o Modo Compacto (barras
                     finas), decidido pelo mesmo Services.JanelaCompactaService.Ativo do construtor.
                     "UniformGrid" à volta dá-lhe a mesma largura que as colunas ao lado. -->
                <Border x:Name="PainelSistemasOperativos" Style="{StaticResource CardStyle}" Margin="10,0,10,0">
                    <StackPanel>
                        <TextBlock x:Name="TxtTituloSistemasOperativos" Text="Sistemas Operativos" Style="{StaticResource SectionTitleStyle}" FontSize="16" />
                        <TextBlock x:Name="TxtTotalSistemasOperativos" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"
                                   Text="% de equipamento com cada sistema operativo" />
                        <TextBlock x:Name="TxtSemSistemasOperativos" TextWrapping="Wrap" FontSize="11" FontStyle="Italic"
                                   Foreground="{StaticResource BrushTextSecondary}" Visibility="Collapsed"
                                   Text="Nenhum equipamento visível tem o Sistema Operativo preenchido." />
                        <WrapPanel x:Name="PainelGaugesSistemaOperativo" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- "Armazenamento" — % de equipamento com cada Tipo de Disco (SSD, HDD, NVMe,
                     etc., os mesmos valores configurados em Administração → Dados Fixos → Tipos de
                     Equipamento → Computador → "Tipo de Disco"). Mesmo mecanismo dinâmico de
                     "Sistemas Operativos" ao lado — ver AtualizarDistribuicaoPorCampo. -->
                <Border x:Name="PainelArmazenamento" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Armazenamento" Style="{StaticResource SectionTitleStyle}" FontSize="16" />
                        <TextBlock x:Name="TxtTotalArmazenamento" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"
                                   Text="% de equipamento com cada tipo de armazenamento" />
                        <TextBlock x:Name="TxtSemArmazenamento" TextWrapping="Wrap" FontSize="11" FontStyle="Italic"
                                   Foreground="{StaticResource BrushTextSecondary}" Visibility="Collapsed"
                                   Text="Nenhum equipamento visível tem o Tipo de Disco preenchido." />
                        <WrapPanel x:Name="PainelGaugesArmazenamento" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="#F1F5F9" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- (2.3) Legenda de Estado -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Estado:" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Ellipse Width="12" Height="12" Fill="#22C55E" Margin="0,0,4,0" />
                        <TextBlock Text="Em Serviço / Reparado" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Ellipse Width="12" Height="12" Fill="#F59E0B" Margin="0,0,4,0" />
                        <TextBlock Text="Recolhido / Aguarda Entrega" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Ellipse Width="12" Height="12" Fill="#6366F1" Margin="0,0,4,0" />
                        <TextBlock Text="Em Reparação" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Ellipse Width="12" Height="12" Fill="#9CA3AF" Margin="0,0,4,0" />
                        <TextBlock Text="Em Armazém" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Ellipse Width="12" Height="12" Fill="#EF4444" Margin="0,0,4,0" />
                        <TextBlock Text="Abatido" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- (2.3) Legenda de Obsolescência — quadrados em vez de bolinhas, alinhada à direita
                         na mesma linha da legenda de Estado -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Obsolescência:" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Rectangle Width="12" Height="12" Fill="#22C55E" Margin="0,0,4,0" />
                        <TextBlock Text="Atual" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Rectangle Width="12" Height="12" Fill="#F59E0B" Margin="0,0,4,0" />
                        <TextBlock Text="A Monitorizar" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Rectangle Width="12" Height="12" Fill="#EF4444" Margin="0,0,4,0" />
                        <TextBlock Text="Obsoleto" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Rectangle Width="12" Height="12" Fill="#94A3B8" Margin="0,0,4,0" />
                        <TextBlock Text="Sem dados suficientes" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <DataGrid x:Name="Grid" CanUserSortColumns="True" AutoGenerateColumns="False" MouseDoubleClick="Grid_MouseDoubleClick" RowStyle="{StaticResource DataGridRowClickableStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nº Série" Binding="{Binding NumeroSerie}" Width="Auto" />
                        <DataGridTextColumn Header="Nº Inventário" Binding="{Binding NumeroInventario}" Width="Auto" />
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="Auto" />
                        <DataGridTextColumn Header="Marca/Modelo" Binding="{Binding Marca}" Width="Auto" />
                        <DataGridTextColumn Header="Localização" Binding="{Binding Escola.Nome}" Width="*" />
                        <DataGridTemplateColumn Header="Estado" Width="Auto" SortMemberPath="Estado">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource BadgePillStyle}"
                                            Background="{Binding CorEstado, Converter={StaticResource HexColorToBrushConverter}}">
                                        <TextBlock Text="{Binding Estado}" Style="{StaticResource BadgeTextStyle}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Obsolescência" Width="Auto" SortMemberPath="Obsolescencia.Classificacao">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource BadgeRectStyle}" ToolTip="{Binding Obsolescencia.Detalhe}">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding Obsolescencia.CorHex}" />
                                        </Border.Background>
                                        <TextBlock Text="{Binding Obsolescencia.Classificacao}" Style="{StaticResource BadgeTextStyle}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <TextBlock Grid.Row="2" Text="💡 Duplo-clique num equipamento para ver/editar os seus detalhes."
                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,8,0,0" />
        </Grid>
    </DockPanel>
</Window>
