<Window x:Class="LeiriaDISIA.Views.HistoricoIntervencoesEscolaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Histórico de Intervenções" SizeToContent="Height" Width="980" MinWidth="800"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BrushBackground}">
    <!-- Reutiliza o mesmo estilo de badges (Categorias/Estado) da grelha principal do módulo
         Intervenções (ver Views/IntervencoesWindow.xaml), para esta janela parecer parte do mesmo
         ecrã, não uma janela à parte com um visual diferente. O PDF gerado a partir daqui reutiliza
         RelatorioService.GerarListaIntervencoes, o mesmo motor profissional já usado em todos os
         outros relatórios "Lista de..." da aplicação — ver Views/HistoricoIntervencoesEscolaWindow.xaml.cs. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TxtTitulo" Text="Histórico de Intervenções" Style="{StaticResource SectionTitleStyle}" FontSize="18" />
            <TextBlock x:Name="TxtResumo" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      MaxHeight="560" RowHeight="NaN" MinRowHeight="34" CanUserSortColumns="True"
                      MouseDoubleClick="Grid_MouseDoubleClick" RowStyle="{StaticResource DataGridRowClickableStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd-MM-yyyy}" Width="Auto" />
                    <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                    <DataGridTemplateColumn Header="Categorias" Width="Auto" SortMemberPath="Categorias.Count">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Categorias}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource BadgeRectStyle}"
                                                    Background="{Binding Categoria.CorHex, Converter={StaticResource HexColorToBrushConverter}}"
                                                    Margin="0,2,6,2">
                                                <TextBlock Text="{Binding Categoria.Nome}" Style="{StaticResource BadgeTextStyle}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Estado" Width="Auto" SortMemberPath="Estado">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource BadgePillStyle}"
                                        Background="{Binding CorEstado, Converter={StaticResource HexColorToBrushConverter}}">
                                    <TextBlock Text="{Binding Estado}" Style="{StaticResource BadgeTextStyle}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="TxtSemIntervencoes" Text="Esta escola ainda não tem nenhuma intervenção registada."
                       TextWrapping="Wrap" FontSize="11" FontStyle="Italic" Foreground="{StaticResource BrushTextSecondary}"
                       VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed" />
            <Button Content="Fechar" Click="Fechar_Click" Margin="0,0,8,0" Padding="16,8" />
            <Button x:Name="BtnGerarPdf" Content="📄 Gerar PDF" Style="{StaticResource PrimaryButton}" Click="GerarPdf_Click" Padding="16,8" />
        </StackPanel>
    </Grid>
</Window>
