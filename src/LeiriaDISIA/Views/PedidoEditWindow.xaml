<Window x:Class="LeiriaDISIA.Views.PedidoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pedido de Intervenção" Height="737" Width="900" MinHeight="620" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}">
    <ScrollViewer Margin="24,20,34,20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock x:Name="TxtTitulo" Text="Novo Pedido de Intervenção" Style="{StaticResource SectionTitleStyle}"
                       FontSize="18" Margin="0,0,0,16" />

            <!-- Layout em modo paisagem: duas colunas lado a lado para se ver tudo sem scroll -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Coluna esquerda: quem pediu e em que escola -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Data do Pedido" FontWeight="SemiBold" />
                    <DatePicker x:Name="DpData" Margin="0,4,0,10" />

                    <TextBlock Text="Escola" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtPesquisaEscola" Style="{StaticResource SearchTextBox}" Margin="0,4,0,6"
                             TextChanged="TxtPesquisaEscola_TextChanged"
                             ToolTip="Pesquisar escola por nome, freguesia ou código GEPE" />
                    <ComboBox x:Name="CmbEscola" DisplayMemberPath="Nome" Margin="0,0,0,4"
                              SelectionChanged="CmbEscola_SelectionChanged" />
                    <TextBlock x:Name="TxtDadosEscola" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"
                               TextWrapping="Wrap" Margin="0,0,0,10" />

                    <TextBlock Text="Nº Suporte SIGA" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtNumeroSuporteSiga" Margin="0,4,0,10" />

                    <TextBlock Text="Solicitante" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtSolicitante" Margin="0,4,0,10" />

                    <TextBlock Text="Contacto do solicitante" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtContacto" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Coluna direita: razão do pedido e estado -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Razão do Pedido" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtRazao" AcceptsReturn="True" Height="180" TextWrapping="Wrap" Margin="0,4,0,10" VerticalScrollBarVisibility="Auto" />

                    <TextBlock Text="Estado" FontWeight="SemiBold" />
                    <!-- (2.1) A ComboBox tem como itens o próprio enum EstadoPedido; sem este
                         ItemTemplate, o WPF mostra o nome técnico do enum (ex. "EmAndamento"),
                         daí as palavras aparecerem coladas. O conversor traduz cada valor para o
                         nome configurado em Administração → Dados Fixos → "Estados dos Pedidos". -->
                    <ComboBox x:Name="CmbEstado" Margin="0,4,0,10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EstadoPedidoNomeExibicaoConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Motivo (se pendente / em espera)" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtMotivoPendente" Margin="0,4,0,14" />

                    <!-- Usados só pelo Planeamento de Rotas: quanto tempo reservar no dia da equipa
                         para esta intervenção, e se ela deve ser incluída mesmo que a rota fique
                         acima do limite de horas definido (ver PlaneamentoRotaService, aviso de
                         excesso de duração). Nenhum dos dois é obrigatório de preencher. -->
                    <TextBlock Text="Duração Estimada da Intervenção (minutos)" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtDuracaoEstimada" Margin="0,4,0,4"
                             ToolTip="Usado para calcular a duração total no Planeamento de Rotas. Deixe em branco para usar a duração padrão (30 min)." />
                    <TextBlock Text="Deixe em branco para usar a duração padrão (30 min)." FontSize="11"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" />

                    <CheckBox x:Name="ChkObrigatorioNaRota" Content="Obrigatório incluir na rota (mesmo acima do limite de horas da equipa)"
                              Margin="0,0,0,10" />

                    <Border x:Name="PainelTempoAberto" Background="#F1F5F9" CornerRadius="8" Padding="10" Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="BolaTempoAberto" Width="14" Height="14" Margin="0,0,8,0" />
                            <TextBlock x:Name="TxtTempoAberto" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Separator Margin="0,16" />
            <Button Content="➜ Criar Intervenção a partir deste pedido" Click="CriarIntervencao_Click"
                    Background="#22C55E" Foreground="White" Padding="10,8" HorizontalAlignment="Left" />
            <TextBlock Text="Ao registar a intervenção correspondente, este pedido passa automaticamente a 'Concluído'."
                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0" />

            <!-- Cancelar/Guardar na última linha, tal como em todas as outras janelas de
                 inserir/editar (ex.: EscolaEditWindow, EquipamentoEditWindow), para manter a
                 coerência visual — o botão "Criar Intervenção" (ação secundária, específica
                 deste ecrã) fica acima, junto à sua nota explicativa. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancelar" Click="Cancelar_Click" Margin="0,0,8,0" />
                <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Click="Guardar_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
