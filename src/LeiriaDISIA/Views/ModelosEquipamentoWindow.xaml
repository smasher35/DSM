<Window x:Class="LeiriaDISIA.Views.ModelosEquipamentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modelos de Equipamento" SizeToContent="Height" Width="1280" MinHeight="640" MinWidth="1100"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}">
    <!-- Catálogo de "modelos base" reutilizáveis (Tipo/Marca/Modelo/características) — ver
         Models/ModeloEquipamento.cs. Escolhido um modelo em Inserir/Editar Equipamento (botão
         "Usar Modelo..." junto ao Tipo), os seus campos são copiados para o formulário, evitando
         escrever os mesmos dados sempre que se insere mais uma unidade igual a uma já existente
         (ex.: um lote de computadores todos com a mesma configuração). SizeToContent + MaxHeight
         (definido em código) seguem o mesmo padrão já usado em EquipamentoEditWindow.xaml, pela
         mesma razão — o painel de características muda de altura consoante o Tipo escolhido. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" MinWidth="640" />
                </Grid.ColumnDefinitions>

                <!-- Coluna esquerda: lista de modelos já criados -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Modelos de Equipamento" Style="{StaticResource SectionTitleStyle}" FontSize="18" Margin="0,0,0,4" />
                    <TextBlock Text="Modelos-base reutilizáveis (Tipo, Marca, Modelo e características) — escolha um a partir de Inserir/Editar Equipamento para preencher automaticamente esses campos, sem os escrever de novo para cada unidade igual."
                               TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,14" />

                    <TextBlock Text="Filtrar por Tipo" FontWeight="SemiBold" />
                    <ComboBox x:Name="CmbFiltroTipo" Margin="0,4,0,10" SelectionChanged="Filtro_Changed" />

                    <TextBox x:Name="TxtPesquisa" Style="{StaticResource SearchTextBox}" Margin="0,0,0,10"
                             TextChanged="Filtro_Changed" ToolTip="Pesquisar por nome, marca ou modelo" />

                    <ListBox x:Name="ListaModelos" MaxHeight="560" BorderThickness="1" BorderBrush="{StaticResource BrushInputBorder}"
                             SelectionChanged="ListaModelos_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding RotuloExibicao}" FontWeight="SemiBold"
                                               Foreground="{Binding CorTexto}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Tipo}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button x:Name="BtnNovo" Content="+ Novo Modelo" Style="{StaticResource PrimaryButton}"
                            Click="Novo_Click" Margin="0,10,0,0" HorizontalAlignment="Stretch" />
                </StackPanel>

                <!-- Coluna direita: formulário de edição — mesma estrutura de "Características
                     Específicas" de EquipamentoEditWindow.xaml, sem os campos próprios de cada
                     unidade física (Nº Série, Aquisição, Localização, Estado, Histórico). -->
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="TxtTituloEdicao" Text="Novo Modelo" Style="{StaticResource SectionTitleStyle}" FontSize="18" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tipo de Equipamento *" FontWeight="SemiBold" />
                            <ComboBox x:Name="CmbTipo" Margin="0,4,0,10" SelectionChanged="CmbTipo_SelectionChanged" />

                            <TextBlock Text="Nome do Modelo (opcional)" FontWeight="SemiBold" />
                            <TextBox x:Name="TxtNome" Margin="0,4,0,10"
                                     ToolTip="Ex.: &quot;HP EliteBook 840 G8 — i5/16GB/512GB SSD&quot;. Deixe em branco para mostrar Marca + Modelo na lista." />

                            <TextBlock Text="Marca" FontWeight="SemiBold" />
                            <TextBox x:Name="TxtMarca" Margin="0,4,0,10" CharacterCasing="Upper" />

                            <TextBlock Text="Modelo" FontWeight="SemiBold" />
                            <TextBox x:Name="TxtModelo" Margin="0,4,0,10" CharacterCasing="Upper" />

                            <CheckBox x:Name="ChkAtivo" Content="Ativo (aparece no seletor de Inserir Equipamento)" IsChecked="True" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Características Específicas" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"
                                       FontSize="11" Margin="0,0,0,10" />

                            <Border x:Name="GrupoComputador" Background="#F1F5F9" CornerRadius="8" Padding="12" Visibility="Collapsed" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Características do Computador" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBlock Text="Processador" FontWeight="SemiBold" />
                                    <ComboBox x:Name="CmbProcessador" IsEditable="True" Margin="0,4,0,10" ToolTip="Ex: Intel Core i5-12400" />

                                    <TextBlock Text="Família / Versão do Processador" FontWeight="SemiBold" />
                                    <TextBox x:Name="TxtFamiliaProcessador" Margin="0,4,0,10" ToolTip="Ex: 12ª Geração, Ryzen 5 5600G" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Tipo de Memória" FontWeight="SemiBold" />
                                            <ComboBox x:Name="CmbTipoMemoria" IsEditable="True" Margin="0,4,4,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Memória (GB)" FontWeight="SemiBold" />
                                            <ComboBox x:Name="CmbMemoriaGB" IsEditable="True" Margin="4,4,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Tipo de Disco" FontWeight="SemiBold" />
                                            <ComboBox x:Name="CmbTipoDisco" IsEditable="True" Margin="0,4,4,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Tamanho do Disco (GB)" FontWeight="SemiBold" />
                                            <ComboBox x:Name="CmbTamanhoDisco" IsEditable="True" Margin="4,4,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Sistema Operativo" FontWeight="SemiBold" />
                                    <ComboBox x:Name="CmbSistemaOperativo" IsEditable="True" Margin="0,4,0,0" ToolTip="Ex: Windows 11 Pro" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="GrupoMonitor" Background="#F1F5F9" CornerRadius="8" Padding="12" Visibility="Collapsed" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Características do Monitor" FontWeight="Bold" Margin="0,0,0,8" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Polegadas" FontWeight="SemiBold" />
                                            <ComboBox x:Name="CmbPolegadas" IsEditable="True" Margin="0,4,4,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Tipo de Painel" FontWeight="SemiBold" />
                                            <ComboBox x:Name="CmbTipoPainel" IsEditable="True" Margin="4,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Resolução" FontWeight="SemiBold" />
                                    <ComboBox x:Name="CmbResolucaoMonitor" IsEditable="True" Margin="0,4,0,0" ToolTip="Ex: 1920x1080" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="GrupoImpressora" Background="#F1F5F9" CornerRadius="8" Padding="12" Visibility="Collapsed" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Características da Impressora" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBlock Text="Tipo" FontWeight="SemiBold" />
                                    <ComboBox x:Name="CmbTipoImpressora" IsEditable="True" Margin="0,4,0,10" />
                                    <CheckBox x:Name="ChkImpressaoCor" Content="Impressão a cor" Margin="0,0,0,10" />
                                    <TextBlock Text="Ligação" FontWeight="SemiBold" />
                                    <ComboBox x:Name="CmbLigacaoImpressora" IsEditable="True" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="GrupoRede" Background="#F1F5F9" CornerRadius="8" Padding="12" Visibility="Collapsed" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Características do Equipamento de Rede" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Nº de Portas" FontWeight="SemiBold" />
                                            <ComboBox x:Name="CmbNumeroPortas" IsEditable="True" Margin="0,4,4,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Velocidade" FontWeight="SemiBold" />
                                            <ComboBox x:Name="CmbVelocidadeRede" IsEditable="True" Margin="4,4,0,0" ToolTip="Ex: 1 Gbps" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="ChkGerivel" Content="Equipamento gerível" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="GrupoCamera" Background="#F1F5F9" CornerRadius="8" Padding="12" Visibility="Collapsed" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Características da Câmara" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBlock Text="Resolução" FontWeight="SemiBold" />
                                    <ComboBox x:Name="CmbResolucaoCamera" IsEditable="True" Margin="0,4,0,10" ToolTip="Ex: 4MP, 1080p" />
                                    <TextBlock Text="Tipo" FontWeight="SemiBold" />
                                    <ComboBox x:Name="CmbTipoCamera" IsEditable="True" Margin="0,4,0,10" />
                                    <CheckBox x:Name="ChkVisaoNoturna" Content="Visão noturna" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="GrupoProjetor" Background="#F1F5F9" CornerRadius="8" Padding="12" Visibility="Collapsed" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Características do Projetor" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBlock Text="Luminosidade (Lumens)" FontWeight="SemiBold" />
                                    <ComboBox x:Name="CmbLuminosidade" IsEditable="True" Margin="0,4,0,10" />
                                    <TextBlock Text="Resolução" FontWeight="SemiBold" />
                                    <ComboBox x:Name="CmbResolucaoProjetor" IsEditable="True" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="GrupoGenerico" Background="#F1F5F9" CornerRadius="8" Padding="12" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Especificações Adicionais" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBox x:Name="TxtEspecificacoesAdicionais" AcceptsReturn="True" Height="90" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </Border>

                            <!-- Mesmo painel dinâmico "Características Adicionais" de
                                 EquipamentoEditWindow.xaml — características definidas pelo
                                 administrador (Administração → Dados Fixos → Tipos de Equipamento
                                 → "Gerir Características deste Grupo...") que não têm campo fixo
                                 próprio acima (ex.: "Norma Wifi", "Nº de Antenas" do tipo "Access
                                 Points / Antena" — sem isto, um modelo desse tipo não conseguia
                                 captar nenhum dos seus campos realmente usados). Só aparece quando
                                 existir pelo menos uma característica ativa definida para o grupo
                                 do Tipo escolhido. -->
                            <Border x:Name="GrupoCaracteristicasAdicionais" Background="#F1F5F9" CornerRadius="8" Padding="12"
                                    Margin="0,12,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Características Adicionais" FontWeight="Bold" Margin="0,0,0,4" />
                                    <TextBlock TextWrapping="Wrap" FontSize="11" FontStyle="Italic"
                                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"
                                               Text="Definidas em Administração → Dados Fixos, para o grupo de características deste Tipo de Equipamento." />
                                    <StackPanel x:Name="PainelCaracteristicasAdicionais" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BtnEliminar" Content="🗑️ Eliminar" Style="{StaticResource AdminButtonRose}"
                    Click="Eliminar_Click" Margin="0,0,8,0" IsEnabled="False" />
            <Button Content="Fechar" Click="Fechar_Click" Margin="0,0,8,0" Padding="16,8" />
            <Button x:Name="BtnGuardar" Content="Guardar" Style="{StaticResource PrimaryButton}" Click="Guardar_Click" Padding="16,8" />
        </StackPanel>
    </Grid>
</Window>
