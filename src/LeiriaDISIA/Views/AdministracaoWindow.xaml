<Window x:Class="LeiriaDISIA.Views.AdministracaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administração — Gestão DISIA" WindowState="Maximized"
        Background="{StaticResource BrushBackground}" FontFamily="Segoe UI" ScrollViewer.VerticalScrollBarVisibility="Disabled">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="24">
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="🏠 Menu Principal" Style="{StaticResource MenuPrincipalButton}" Click="MenuPrincipal_Click" Margin="0,0,10,0" />
                <TextBlock Text="Administração" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
        </Border>

        <TabControl x:Name="TabsAdministracao" Background="Transparent" BorderThickness="0" SelectionChanged="TabsAdministracao_SelectionChanged">

            <!-- ==================== ABA: UTILIZADORES ==================== -->
            <TabItem Header="👤 Utilizadores" Style="{StaticResource AdminTabItem}">
                <!-- Grid com linhas Auto (título/legenda) + "*" (DataGrid) + Auto (botões/dica),
                     em vez de StackPanel, para a lista de utilizadores ocupar sempre todo o
                     espaço livre até ao fundo da janela (mesmo padrão do módulo Atividades DISIA
                     — ver Views/DisiaWindow.xaml). -->
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Gestão de Utilizadores e Perfis" Style="{StaticResource SectionTitleStyle}" Margin="0,0,16,0" />
                        <Button Content="➕ Novo Utilizador" Style="{StaticResource PrimaryButton}" Click="NovoUtilizador_Click" />
                    </StackPanel>
                    <!-- Legenda de estados -->
                    <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" Fill="#22C55E" Margin="0,0,4,0" />
                            <TextBlock Text="Ativo" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <Ellipse Width="12" Height="12" Fill="#EF4444" Margin="0,0,4,0" />
                            <TextBlock Text="Inativo" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                        <DataGrid x:Name="GridUtilizadores" MouseDoubleClick="GridUtilizadores_MouseDoubleClick" RowStyle="{StaticResource DataGridRowClickableStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Utilizador" Binding="{Binding NomeUtilizador}" Width="Auto" />
                                    <DataGridTextColumn Header="Nome Completo" Binding="{Binding NomeCompleto}" Width="*" />
                                    <DataGridTextColumn Header="Perfil" Binding="{Binding Perfil}" Width="Auto" />
                                    <DataGridTemplateColumn Header="Estado" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource BadgePillStyle}"
                                                        Background="{Binding Ativo, Converter={StaticResource BooleanToColorConverter}}">
                                                    <TextBlock Text="{Binding Ativo, Converter={StaticResource BooleanToStatusConverter}}" Style="{StaticResource BadgeTextStyle}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Último Login" Binding="{Binding UltimoLogin, StringFormat=dd-MM-yyyy HH:mm}" Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>
                    </Border>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="🔑 Repor Password" Style="{StaticResource AdminButtonOrange}" Click="ReporPassword_Click" Margin="0,0,8,0" />
                        <Button Content="Editar Utilizador Selecionado" Style="{StaticResource AdminButtonBlue}" Click="EditarUtilizador_Click" Margin="0,0,8,0" />
                        <Button Content="Eliminar Utilizador Selecionado" Click="EliminarUtilizador_Click" Background="#EF4444" Foreground="White" Padding="14,8" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Grid.Row="4" Text="💡 Utilizadores com perfil 'Utilizador' não têm acesso a este módulo de Administração."
                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,10,0,0" TextWrapping="Wrap" />
                </Grid>
            </TabItem>

            <!-- ==================== ABA: BASE DE DADOS ==================== -->
            <TabItem Header="🗄️ Base de Dados" Style="{StaticResource AdminTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Localizações" FontWeight="Bold" Margin="0,0,0,8" />

                            <TextBlock Text="Base de Dados Principal" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtCaminhoDb" IsReadOnly="True" Margin="0,0,0,6" Padding="6" Background="#F1F5F9" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Content="Abrir no Explorador" Style="{StaticResource AdminButtonBlue}" Click="AbrirLocalizacao_Click" Margin="0,0,8,0" />
                                <Button Content="Copiar caminho" Style="{StaticResource AdminButtonBlue}" Click="CopiarCaminho_Click" />
                            </StackPanel>

                            <TextBlock Text="Backups Automáticos" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtCaminhoBackups" IsReadOnly="True" Margin="0,0,0,6" Padding="6" Background="#F1F5F9" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Abrir no Explorador" Style="{StaticResource AdminButtonBlue}" Click="AbrirPastaBackups_Click" Margin="0,0,8,0" />
                                <Button Content="Copiar caminho" Style="{StaticResource AdminButtonBlue}" Click="CopiarCaminhoBackups_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="ChkBackupAutomatico" Content="Backups automáticos ao fechar a aplicação"
                                          Click="ChkBackupAutomatico_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Cópia de Segurança (Backup)" FontWeight="Bold" Margin="0,0,0,8" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"
                                       Text="Cria uma cópia integral da base de dados atual, num local à escolha. A aplicação também pode criar automaticamente um backup para a pasta de backups por omissão sempre que é encerrada (ver acima)." />
                            <Button Content="Fazer Backup Agora" Style="{StaticResource PrimaryButton}" Click="Backup_Click" Padding="16,10" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Restaurar Backup" FontWeight="Bold" Margin="0,0,0,8" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"
                                       Text="Substitui todos os dados atuais pelos de um ficheiro de backup. Não pode ser desfeito." />
                            <Button Content="Restaurar a partir de um ficheiro..." Style="{StaticResource AdminButtonGreenDark}" Click="Restaurar_Click" Padding="16,10" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" BorderBrush="{StaticResource BrushDanger}" BorderThickness="1.5">
                        <StackPanel>
                            <TextBlock Text="Zona de Perigo" FontWeight="Bold" Foreground="{StaticResource BrushDanger}" Margin="0,0,0,8" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"
                                       Text="Apaga permanentemente TODOS os dados (exceto os utilizadores). Recomenda-se um backup antes." />
                            <Button Content="Apagar Toda a Base de Dados" Click="ApagarTudo_Click" Padding="16,10" HorizontalAlignment="Left"
                                    Background="{StaticResource BrushDanger}" Foreground="White" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== ABA: DADOS FIXOS ==================== -->
            <TabItem Header="🧩 Dados Fixos" Style="{StaticResource AdminTabItem}">
                <!-- Layout responsivo para as duas resoluções suportadas (FHD 1920×1080 e UHD
                     2560×1440): colunas com Star sizing + MinWidth/MaxWidth (em vez de larguras
                     fixas), para a coluna esquerda ("Lista de Valores") caber sempre os títulos
                     completos dos botões de cores, a coluna central ocupar automaticamente todo o
                     espaço restante em qualquer resolução, e a coluna direita ("Adicionar/Editar
                     Valor") ficar ligeiramente mais estreita, sem nunca cortar os seus controlos.
                     GridSplitters mantidos, para quem quiser ajustar manualmente. -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.24*" MinWidth="440" MaxWidth="560" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" MinWidth="480" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="0.17*" MinWidth="320" MaxWidth="400" />
                    </Grid.ColumnDefinitions>

                    <!-- Coluna 1: seletor de grupo -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Listas de Valores" Style="{StaticResource SectionTitleStyle}" FontSize="16" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,8"
                                   Text="Estas listas alimentam as sugestões dos combos de equipamento (processador, memória, tipo, etc.). Também pode escrever um valor novo diretamente no campo, mesmo que não esteja nesta lista. As listas de Categorias e Estados são também geridas aqui: os nomes ficam aqui, as cores alteram-se nos botões abaixo." />
                        <Border Style="{StaticResource CardStyle}">
                            <ListBox x:Name="ListaGrupos" BorderThickness="0" Height="260"
                                     DisplayMemberPath="Rotulo" SelectionChanged="ListaGrupos_SelectionChanged" />
                        </Border>

                        <!-- Cores das Categorias (esquerda) e Cores dos Estados (direita), lado a lado.
                             Largura da coluna aumentada (460px) e legendas dos botões com
                             TextWrapping="Wrap" para os títulos completos ("Categorias de Atividades
                             DISIA", "Estados das Intervenções", etc.) nunca ficarem cortados. -->
                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cores das Categorias" Style="{StaticResource SectionTitleStyle}" FontSize="16" Margin="0,0,0,4" />
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,8"
                                           Text="Estes botões servem apenas para escolher a cor de cada categoria. Para criar, renomear ou eliminar categorias, use a lista de valores correspondente, acima." />
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <Button Style="{StaticResource AdminButtonBlue}" Click="CategoriasIntervencao_Click" Margin="0,0,0,8" HorizontalAlignment="Stretch" MinHeight="40">
                                            <TextBlock Text="Categorias de Intervenção" TextWrapping="Wrap" TextAlignment="Center" />
                                        </Button>
                                        <Button Style="{StaticResource AdminButtonBlue}" Click="CategoriasDisia_Click" HorizontalAlignment="Stretch" MinHeight="40">
                                            <TextBlock Text="Categorias de Atividades DISIA" TextWrapping="Wrap" TextAlignment="Center" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cores dos Estados" Style="{StaticResource SectionTitleStyle}" FontSize="16" Margin="0,0,0,4" />
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,8"
                                           Text="Estes botões servem apenas para escolher a cor de cada estado. Para renomear um estado, use a lista de valores correspondente, acima." />
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <Button Style="{StaticResource AdminButtonLightBlue}" Click="EstadosIntervencao_Click" Margin="0,0,0,8" HorizontalAlignment="Stretch" MinHeight="40">
                                            <TextBlock Text="Estados das Intervenções" TextWrapping="Wrap" TextAlignment="Center" />
                                        </Button>
                                        <Button Style="{StaticResource AdminButtonLightBlue}" Click="EstadosPedido_Click" Margin="0,0,0,8" HorizontalAlignment="Stretch" MinHeight="40">
                                            <TextBlock Text="Estados dos Pedidos" TextWrapping="Wrap" TextAlignment="Center" />
                                        </Button>
                                        <Button Style="{StaticResource AdminButtonLightBlue}" Click="EstadosEquipamento_Click" HorizontalAlignment="Stretch" MinHeight="40">
                                            <TextBlock Text="Estados dos Equipamentos" TextWrapping="Wrap" TextAlignment="Center" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                    </ScrollViewer>

                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Background="Transparent" ResizeBehavior="PreviousAndNext" ShowsPreview="True" />

                    <!-- Coluna 2: valores do grupo selecionado. Ocupa toda a largura restante ("*").
                         GridValores com MaxHeight moderado (era ilimitado) para libertar altura extra
                         para a grelha de Características, por baixo, que passa a mostrar mais linhas. -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="220" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="TxtTituloGrupo" Grid.Row="0" Text="Selecione uma lista à esquerda" Style="{StaticResource SectionTitleStyle}" FontSize="16" />

                        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                            <DataGrid x:Name="GridValores" SelectionChanged="GridValores_SelectionChanged" RowStyle="{StaticResource DataGridRowClickableStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Valor" Binding="{Binding Valor}" Width="*" />
                                    <DataGridTextColumn x:Name="ColGrupoCaracteristicasValores" Header="Características" Binding="{Binding GrupoCaracteristicas}" Width="Auto" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="ColOrdemValores" Header="Ordem" Binding="{Binding Ordem}" Width="Auto" />
                                    <DataGridCheckBoxColumn x:Name="ColAtivoValores" Header="Ativo" Binding="{Binding Ativo}" Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- (1.1) Só visível para o grupo "Tipos de Equipamento": lista as características
                             específicas já definidas para o grupo de características selecionado (à direita),
                             substituindo a antiga janela separada "Gerir Características deste Grupo...". -->
                        <StackPanel x:Name="PainelCaracteristicasGrupo" Grid.Row="2" Visibility="Collapsed" Margin="0,20,0,0">

                            <TextBlock x:Name="TxtTituloCaracteristicasGrupo" Text="Características do Grupo" Style="{StaticResource SectionTitleStyle}" FontSize="16"
                                       ToolTip="Estas características aparecem em Inserir/Editar Equipamento, na secção &quot;Características Adicionais&quot;, sempre que o Tipo de Equipamento escolhido pertencer a este grupo." />
                            <Border Style="{StaticResource CardStyle}">
                                <DataGrid x:Name="GridCaracteristicas" MaxHeight="460" MinHeight="220" AutoGenerateColumns="False" IsReadOnly="True"
                                          SelectionChanged="GridCaracteristicas_SelectionChanged" RowStyle="{StaticResource DataGridRowClickableStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" />
                                        <DataGridTextColumn Header="Valor por Omissão" Binding="{Binding ValorPorOmissao}" Width="*" />
                                        <DataGridTextColumn Header="Ordem" Binding="{Binding Ordem}" Width="Auto" />
                                        <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Ativo}" Width="Auto" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Background="Transparent" ResizeBehavior="PreviousAndNext" ShowsPreview="True" />

                    <!-- Coluna 3: formulário de edição -->
                    <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="Adicionar / Editar Valor" Style="{StaticResource SectionTitleStyle}" FontSize="16" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock x:Name="TxtAvisoGrupoLigado" TextWrapping="Wrap" FontSize="11" FontStyle="Italic"
                                           Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" Visibility="Collapsed"
                                           Text="Este é o nome oficial, também usado nas listas de seleção dos formulários. A cor associada altera-se no respetivo botão de cores, na secção &quot;Categorias&quot;/&quot;Estados&quot; à esquerda." />

                                <TextBlock Text="Valor" FontWeight="SemiBold" />
                                <TextBox x:Name="TxtValor" Margin="0,4,0,10" />

                                <!-- (1.1) Só visível para o grupo "Tipos de Equipamento": associa este tipo a um
                                     dos blocos de características específicas do formulário de Equipamento. Fica
                                     ligado ao registo, por isso sobrevive a alterações posteriores do nome. Para
                                     gerir as características do grupo em si, use a secção "Adicionar / Editar
                                     Característica", em baixo. -->
                                <StackPanel x:Name="PainelGrupoCaracteristicas" Visibility="Collapsed">
                                    <TextBlock Text="Características Específicas"
                                               ToolTip="Escolha um grupo existente ou escreva o nome de um grupo novo (ex.: &quot;Energia&quot;) para o criar. Determina os campos específicos mostrados no formulário de Equipamento para este tipo. Continua correto mesmo que renomeie o valor acima."
                                               FontWeight="SemiBold" />
                                    <ComboBox x:Name="CmbGrupoCaracteristicas" Margin="0,4,0,10"
                                              IsEditable="True" IsTextSearchEnabled="True" />
                                </StackPanel>

                                <StackPanel x:Name="PainelOrdem">
                                    <TextBlock Text="Ordem de apresentação" FontWeight="SemiBold" />
                                    <TextBox x:Name="TxtOrdem" Margin="0,4,0,10" />
                                </StackPanel>

                                <CheckBox x:Name="ChkAtivo" Content="Ativo (aparece nos combos)" IsChecked="True" Margin="0,4,0,16" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Click="GuardarValor_Click" Margin="0,0,8,0" />
                                    <Button x:Name="BtnNovoValor" Content="Novo" Click="NovoValor_Click" Margin="0,0,8,0" />
                                    <Button x:Name="BtnEliminarValor" Content="Eliminar" Click="EliminarValor_Click" Background="#FDECEC" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- (1.3) Só visível para o grupo "Tipos de Equipamento": gestão inline das
                             características específicas de um grupo (ex.: "Computador", "Energia"), com a
                             mesma filosofia da lista à esquerda — uma combo escolhe o grupo, a grelha acima
                             mostra os itens desse grupo, e este cartão cria/edita/elimina o item selecionado. -->
                        <StackPanel x:Name="PainelAdicionarCaracteristica" Visibility="Collapsed" Margin="0,20,0,0">
                            <TextBlock Text="Adicionar / Editar Característica" Style="{StaticResource SectionTitleStyle}" FontSize="16" />
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Grupo de Características" FontWeight="SemiBold"
                                               ToolTip="Preenchido automaticamente ao selecionar um Tipo de Equipamento acima — mas também pode escolher/escrever aqui outro grupo diretamente, mesmo sem nenhum Tipo selecionado." />
                                    <ComboBox x:Name="CmbGrupoCaracteristicasPainel" Margin="0,4,0,10"
                                              IsEditable="True" IsTextSearchEnabled="True"
                                              SelectionChanged="CmbGrupoCaracteristicasPainel_SelectionChanged"
                                              LostFocus="CmbGrupoCaracteristicasPainel_LostFocus" />

                                    <TextBlock Text="Nome" FontWeight="SemiBold" />
                                    <TextBox x:Name="TxtNomeCaracteristica" Margin="0,4,0,10" />

                                    <!-- Dados Fixos v2: por omissão a característica é partilhada por todos os
                                         Tipos deste grupo (ex.: "Processador" em Secretária/Portátil/Servidor).
                                         Só faz sentido restringir a um Tipo específico quando esse Tipo já
                                         tiver sido definido em Dados Fixos → Tipos de Equipamento. -->
                                    <TextBlock Text="Aplica-se apenas a (opcional)" FontWeight="SemiBold"
                                               ToolTip="Deixe em 'Todos os tipos deste grupo' para a característica ser partilhada por todos os Tipos de Equipamento deste grupo (ex.: Processador em Secretária/Portátil/Servidor). Escolha um Tipo específico para a tornar exclusiva dele (ex.: Autonomia da Bateria só em Portátil)." />
                                    <ComboBox x:Name="CmbTipoEspecificoCaracteristica" Margin="0,4,0,10"
                                              DisplayMemberPath="Rotulo" SelectedValuePath="Id" />

                                    <!-- Dados Fixos v2: torna esta característica uma "característica-filha", que só
                                         aparece depois de se escolher, na característica-pai, uma opção que a abra
                                         (configurado em "Gerir Valores desta Característica..." da característica-pai). -->
                                    <TextBlock Text="É subtipo de (opcional)" FontWeight="SemiBold"
                                               ToolTip="Deixe em 'Nenhuma — característica independente' para esta característica aparecer sempre. Escolha outra característica para esta só aparecer depois de se escolher, nessa característica-pai, uma opção configurada para a abrir (ex.: 'Memória (GB)' é subtipo de 'Tipo de Memória')." />
                                    <ComboBox x:Name="CmbCaracteristicaPai" Margin="0,4,0,10"
                                              DisplayMemberPath="Nome" SelectedValuePath="Id" />

                                    <TextBlock Text="Valor por Omissão (opcional)" FontWeight="SemiBold"
                                               ToolTip="A combo sugere valores já usados nesta característica. Para gerir essa lista, guarde primeiro a característica e use o botão abaixo." />
                                    <ComboBox x:Name="CmbValorPorOmissaoCaracteristica" Margin="0,4,0,6"
                                              IsEditable="True" IsTextSearchEnabled="True" />
                                    <Button x:Name="BtnGerirValoresCaracteristica" Content="📋 Gerir Valores desta Característica..."
                                            Click="GerirValoresCaracteristica_Click" HorizontalAlignment="Left" Margin="0,0,0,10" IsEnabled="False" />

                                    <TextBlock Text="Ordem de apresentação" FontWeight="SemiBold" />
                                    <TextBox x:Name="TxtOrdemCaracteristica" Margin="0,4,0,10" />

                                    <CheckBox x:Name="ChkAtivoCaracteristica" Content="Ativo (aparece no formulário)" IsChecked="True" Margin="0,4,0,16" />

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Click="GuardarCaracteristica_Click" Margin="0,0,8,0" />
                                        <Button x:Name="BtnNovaCaracteristica" Content="Novo" Click="NovaCaracteristica_Click" Margin="0,0,8,0" />
                                        <Button x:Name="BtnEliminarCaracteristica" Content="Eliminar" Click="EliminarCaracteristica_Click" Background="#FDECEC" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>


            <!-- ==================== ABA: APARÊNCIA ==================== -->
            <TabItem Header="🎨 Aparência" Style="{StaticResource AdminTabItem}">
                <StackPanel Margin="0,16,0,0" MaxWidth="480" HorizontalAlignment="Left">
                    <TextBlock Text="Tema Visual" Style="{StaticResource SectionTitleStyle}" FontSize="18" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,16"
                               Text="Escolha entre o modo claro e o modo escuro. A alteração é aplicada de imediato e é recordada da próxima vez que abrir a aplicação." />
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                        <StackPanel>
                            <RadioButton x:Name="RadioTemaClaro" Content="☀️ Modo Claro" GroupName="Tema"
                                         FontSize="15" Margin="0,0,0,14" Checked="RadioTemaClaro_Checked" />
                            <RadioButton x:Name="RadioTemaEscuro" Content="🌙 Modo Escuro" GroupName="Tema"
                                         FontSize="15" Checked="RadioTemaEscuro_Checked" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Tamanho das Janelas" Style="{StaticResource SectionTitleStyle}" FontSize="18" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,16"
                               Text="Normal usa sempre o tamanho original das janelas de edição (Escola, Equipamento, Intervenção, Atividade DISIA), pensado para um monitor normal. Modo Compacto adapta automaticamente essas janelas à área de trabalho disponível — útil em portáteis com ecrãs pequenos (ex.: 13&quot;), onde o tamanho original pode não caber e deixar botões como &quot;Guardar&quot; ou fechar a janela inacessíveis. Em monitores onde o tamanho original já cabe, o Modo Compacto não muda nada. Só tem efeito nas próximas janelas a abrir — não nas que já estiverem abertas." />
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                        <StackPanel>
                            <RadioButton x:Name="RadioTamanhoNormal" Content="🖥️ Normal — monitor de tamanho normal" GroupName="TamanhoJanelas"
                                         FontSize="15" Margin="0,0,0,14" Checked="RadioTamanhoNormal_Checked" />
                            <RadioButton x:Name="RadioTamanhoCompacto" Content="💻 Modo Compacto — portátil / ecrã pequeno" GroupName="TamanhoJanelas"
                                         FontSize="15" Checked="RadioTamanhoCompacto_Checked" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Versão da Aplicação" Style="{StaticResource SectionTitleStyle}" FontSize="18" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,16"
                               Text="Defina o texto da versão que aparece na barra lateral do menu principal." />
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Texto da versão" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtVersaoApp" Margin="0,0,0,12" ToolTip="Ex: 1.2 — 2026" />
                            <Button Content="💾 Guardar Versão" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                    Click="GuardarVersao_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ==================== ABA: INTELIGÊNCIA ARTIFICIAL LOCAL ==================== -->
            <TabItem Header="🤖 IA Local" Style="{StaticResource AdminTabItem}">
                <StackPanel Margin="0,16,0,0" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Modelo de IA Local" Style="{StaticResource SectionTitleStyle}" FontSize="18" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,16"
                               Text="Usada para gerar rascunhos variados da Reflexão Crítica do Relatório Mensal (módulo Relatórios), adaptados aos dados reais de cada mês. Corre inteiramente neste computador — nenhum dado sai da aplicação nem é enviado para qualquer serviço na internet. É necessário descarregar manualmente, uma única vez, um ficheiro de modelo no formato GGUF (ex: Phi-3-mini-4k-instruct, cerca de 2 a 4GB) e indicar aqui o caminho do ficheiro." />

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Ficheiro do modelo (.gguf)" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtCaminhoModeloIa" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0"
                                         VerticalAlignment="Center" ToolTip="Caminho completo do ficheiro .gguf atualmente configurado" />
                                <Button Grid.Column="1" Content="📂 Procurar..." Click="ProcurarModeloIa_Click" />
                            </Grid>
                            <TextBlock x:Name="TxtEstadoModeloIa" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnTestarModeloIa" Content="🧪 Testar Modelo" Style="{StaticResource PrimaryButton}"
                                        Click="TestarModeloIa_Click" Margin="0,0,8,0"
                                        ToolTip="Carrega o modelo e pede-lhe uma frase curta, só para confirmar que está tudo a funcionar. Pode demorar até 1-2 minutos." />
                                <Button Content="🗑️ Remover Configuração" Style="{StaticResource AdminButtonRose}" Click="RemoverModeloIa_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Onde obter um modelo" Style="{StaticResource SectionTitleStyle}" FontSize="15" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"
                               Text="Em huggingface.co, procure por 'Phi-3-mini-4k-instruct GGUF' (ou outro modelo em português/multilingue à sua escolha) e descarregue uma versão quantizada (ex: nome do ficheiro a terminar em 'Q4_K_M.gguf' — bom equilíbrio entre qualidade e velocidade em CPU). Guarde o ficheiro num local acessível (ex: a pasta sugerida abaixo) e escolha-o com o botão 'Procurar...' acima." />
                    <TextBlock x:Name="TxtPastaSugeridaIa" TextWrapping="Wrap" FontSize="11" FontFamily="Consolas"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,0" />
                </StackPanel>
            </TabItem>

            <!-- ==================== ABA: EMAIL (SMTP) ==================== -->
            <TabItem Header="📧 Email (SMTP)" Style="{StaticResource AdminTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Servidor de Email (SMTP)" Style="{StaticResource SectionTitleStyle}" FontSize="18" Margin="0,0,10,0" />
                        <Button Content="❓ Como configurar" Style="{StaticResource InfoButton}" Click="AjudaSmtp_Click" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,16"
                               Text="Dados do servidor usado para enviar a notificação automática de criação de conta aos novos utilizadores. Sem esta configuração preenchida, os utilizadores são criados na mesma, mas o email não é enviado." />

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Servidor SMTP" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtSmtpServidor" Margin="0,0,0,2" Padding="6" ToolTip="Ex: smtp.gmail.com" />
                            <TextBlock Text="Ex: smtp.gmail.com (Gmail), smtp.office365.com (Outlook/Microsoft 365)"
                                       FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,14" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Utilizador SMTP" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox x:Name="TxtSmtpUtilizador" Padding="6" ToolTip="Normalmente o endereço de email completo" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Porta" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox x:Name="TxtSmtpPorta" Padding="6" ToolTip="Ex: 587 (com SSL/TLS)" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Palavra-passe SMTP" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <PasswordBox x:Name="TxtSmtpPassword" Margin="0,0,0,2" Padding="6" />
                            <TextBlock Text="No Gmail e na maioria dos serviços não é a palavra-passe normal da conta — é uma &quot;palavra-passe de aplicação&quot; gerada à parte. Ver botão &quot;Como configurar&quot; acima."
                                       FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,14" TextWrapping="Wrap" />

                            <CheckBox x:Name="ChkSmtpSsl" Content="Usar ligação segura (SSL/TLS)" IsChecked="True" Margin="0,0,0,18" />

                            <TextBlock Text="Nome do remetente" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtSmtpNomeRemetente" Margin="0,0,0,2" Padding="6" ToolTip="Nome apresentado ao destinatário" />
                            <TextBlock Text="Ex: DISIA - Câmara Municipal de Leiria"
                                       FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,14" />

                            <TextBlock Text="Email do remetente" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtSmtpEmailRemetente" Margin="0,0,0,2" Padding="6" ToolTip="Tem de corresponder à conta configurada acima" />
                            <TextBlock Text="Tem de ser o mesmo endereço da conta usada no campo &quot;Utilizador SMTP&quot;."
                                       FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,18" />

                            <StackPanel Orientation="Horizontal">
                                <Button Content="💾 Guardar Configuração" Style="{StaticResource PrimaryButton}"
                                        Click="GuardarSmtp_Click" Padding="16,10" Margin="0,0,8,0" />
                                <Button Content="✉️ Enviar Email de Teste..." Style="{StaticResource AdminButtonBlue}"
                                        Click="TestarSmtp_Click" Padding="16,10" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#F1F5F9" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="💡 A usar o Gmail como servidor?" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"
                                       Text="Servidor: smtp.gmail.com · Porta: 587 · SSL/TLS: ativo. A palavra-passe tem de ser uma 'Palavra-passe de aplicação' (não a password normal da conta) — clique em 'Como configurar' para o passo a passo." />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== ABA: OBSOLESCÊNCIA DE EQUIPAMENTO ==================== -->
            <TabItem Header="🖥️ Obsolescência" Style="{StaticResource AdminTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Índice de Obsolescência de Equipamento" Style="{StaticResource SectionTitleStyle}" FontSize="18" Margin="0,0,10,0" />
                        <Button Content="❓ Como funciona o cálculo" Style="{StaticResource InfoButton}" Click="AjudaObsolescencia_Click" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,16"
                               Text="Cada equipamento recebe um score de 0 a 100, combinando a idade, a memória RAM, o tipo de disco e a geração aproximada do processador. Os pesos abaixo definem quanto cada critério pesa no resultado final - ajuste-os conforme o que for mais relevante para a DISIA." />

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Pesos dos Critérios (%)" FontWeight="Bold" Margin="0,0,0,4" />
                            <TextBlock x:Name="TxtSomaPesos" Text="Soma atual: 100%" FontSize="11"
                                       Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Idade do Equipamento" FontWeight="SemiBold" />
                                    <TextBox x:Name="TxtPesoIdade" Margin="0,4,0,0" Padding="6" TextChanged="PesoObsolescencia_TextChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Memória RAM" FontWeight="SemiBold" />
                                    <TextBox x:Name="TxtPesoRam" Margin="0,4,0,0" Padding="6" TextChanged="PesoObsolescencia_TextChanged" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Tipo de Disco" FontWeight="SemiBold" />
                                    <TextBox x:Name="TxtPesoDisco" Margin="0,4,0,0" Padding="6" TextChanged="PesoObsolescencia_TextChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Geração do Processador" FontWeight="SemiBold" />
                                    <TextBox x:Name="TxtPesoProcessador" Margin="0,4,0,0" Padding="6" TextChanged="PesoObsolescencia_TextChanged" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="RAM, Disco e Processador só se aplicam a computadores de secretária, portáteis e servidores. Para os restantes tipos de equipamento (monitores, impressoras, rede, câmaras, projetores), o peso da Idade passa automaticamente a 100%."
                                       FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Limiares de Classificação" FontWeight="Bold" Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="A partir de que score (%) fica &quot;A Monitorizar&quot;" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBox x:Name="TxtLimiarMonitorizar" Margin="0,4,0,0" Padding="6" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="A partir de que score (%) fica &quot;Obsoleto&quot;" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBox x:Name="TxtLimiarObsoleto" Margin="0,4,0,0" Padding="6" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Content="💾 Guardar Configuração" Style="{StaticResource PrimaryButton}"
                            Click="GuardarObsolescencia_Click" Padding="16,10" HorizontalAlignment="Left" Margin="0,0,0,16" />

                    <Border Background="#F1F5F9" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="💡 Onde ver o resultado" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"
                                       Text="A classificação (Atual / A Monitorizar / Obsoleto) aparece como uma bolinha colorida na lista de Equipamento Informático, e o total de equipamento &quot;Obsoleto&quot; é mostrado como indicador no Dashboard." />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== ABA: IMPORTAÇÃO DE DADOS ==================== -->
            <TabItem Header="📥 Importação de Dados" Style="{StaticResource AdminTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                <Grid MaxWidth="1560" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="620" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="480" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <!-- ============ COLUNA ESQUERDA: Escolas e Intervenções (por fases) ============ -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Escolas e Intervenções" Style="{StaticResource SectionTitleStyle}" FontSize="16" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,16"
                                   Text="A importação é feita por fases. Comece sempre pelos Agrupamentos e Escolas antes de importar intervenções." />

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Fase 1 — Agrupamentos e Escolas" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button Content="❓ Como deve estar o ficheiro" Style="{StaticResource InfoButton}" Click="AjudaAgrupamentosEscolas_Click" />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"
                                           Text="Importa a aba 'Agrupamentos' (sempre primeiro) e a aba 'Escolas' de um ficheiro Excel (.xlsx), associando cada escola ao respetivo agrupamento pela coluna 'Cod. Agrupamento'. Escolas sem código de agrupamento ficam sem agrupamento associado. Nunca duplica registos já existentes." />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Importar Agrupamentos + Escolas..." Style="{StaticResource PrimaryButton}"
                                            Click="ImportarAgrupamentosEscolas_Click" Padding="16,10" Margin="0,0,8,0" />
                                    <Button Content="⬇️ Template Excel" Style="{StaticResource AdminButtonGreenDark}" Padding="12,6" Click="TemplateAgrupamentosEscolas_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Fase 2 — Equipamento" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button Content="❓ Como deve estar o ficheiro" Style="{StaticResource InfoButton}" Click="AjudaEquipamento_Click" />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"
                                           Text="Importa o inventário de equipamento informático (uma linha por equipamento, com Nº Série, Nº Inventário, Tipo, Marca, Modelo e Escola). Nunca duplica registos já existentes (chave: Nº Série)." />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Importar Equipamento..." Style="{StaticResource AdminButtonTeal}" Click="ImportarEquipamento_Click" Padding="16,10" Margin="0,0,8,0" />
                                    <Button Content="⬇️ Template Excel" Style="{StaticResource AdminButtonGreenDark}" Padding="12,6" Click="TemplateEquipamento_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Fase 3 — Intervenções (Modelo de Importação)" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button Content="❓ Como deve estar o ficheiro" Style="{StaticResource InfoButton}" Click="AjudaIntervencoesDedicado_Click" />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"
                                           Text="Importa intervenções a partir do 'Modelo de Importação de Intervenções' (uma linha por intervenção, com Data, Escola, Código GEPE opcional, Descrição, Categorias, Material Recolhido/Abatido, Estado e Motivo Pendente). Ideal para começar a registar as intervenções mês a mês. Nunca duplica registos já existentes." />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Importar Intervenções (Modelo)..." Style="{StaticResource AdminButtonPurple}" Click="ImportarIntervencoesDedicado_Click" Padding="16,10" Margin="0,0,8,0" />
                                    <Button Content="⬇️ Template Excel" Style="{StaticResource AdminButtonGreenDark}" Padding="12,6" Click="TemplateIntervencoes_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Fase 4 — Equipamento Abatido" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button Content="❓ Como deve estar o ficheiro" Style="{StaticResource InfoButton}" Click="AjudaEquipamentoAbatido_Click" />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"
                                           Text="Importa registos de equipamento abatido, associando-os ao equipamento já existente no inventário pelo Nº Série. Nunca duplica registos já existentes (chave: Nº Série + Data de Abate)." />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Importar Equipamento Abatido..." Style="{StaticResource AdminButtonOrange}" Click="ImportarEquipamentoAbatido_Click" Padding="16,10" Margin="0,0,8,0" />
                                    <Button Content="⬇️ Template Excel" Style="{StaticResource AdminButtonGreenDark}" Padding="12,6" Click="TemplateEquipamentoAbatido_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Fase 5 — Equipamento Recolhido" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button Content="❓ Como deve estar o ficheiro" Style="{StaticResource InfoButton}" Click="AjudaEquipamentoRecolhido_Click" />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"
                                           Text="Importa registos de equipamento recolhido para as instalações da DISIA, associando-os ao equipamento já existente no inventário pelo Nº Série. Nunca duplica registos já existentes (chave: Nº Série + Data de Recolha)." />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Importar Equipamento Recolhido..." Style="{StaticResource AdminButtonRose}" Click="ImportarEquipamentoRecolhido_Click" Padding="16,10" Margin="0,0,8,0" />
                                    <Button Content="⬇️ Template Excel" Style="{StaticResource AdminButtonGreenDark}" Padding="12,6" Click="TemplateEquipamentoRecolhido_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ COLUNA DO MEIO: Dados DISIA (independente de escolas) ============ -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Dados DISIA" Style="{StaticResource SectionTitleStyle}" FontSize="16" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,16"
                                   Text="Dados que não estão associados a escolas nem a intervenções — apenas às atividades gerais da DISIA." />

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Atividades da DISIA" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button Content="❓ Como deve estar o ficheiro" Style="{StaticResource InfoButton}" Click="AjudaAtividadesDisia_Click" />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"
                                           Text="Importa as atividades desempenhadas na DISIA a partir do ficheiro serviços_disia.xlsx. Cada registo inclui data, descrição, categoria, local, serviço envolvido, suporte prestado e quantidade de vezes que o serviço foi prestado. Nunca duplica registos já existentes." />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Importar Atividades DISIA..." Style="{StaticResource AdminButtonBlue}" Click="ImportarAtividadesDisia_Click" Padding="16,10" Margin="0,0,8,0" />
                                    <Button Content="⬇️ Template Excel" Style="{StaticResource AdminButtonGreenDark}" Padding="12,6" Click="TemplateAtividadesDisia_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Comunicações" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button Content="❓ Como deve estar o ficheiro" Style="{StaticResource InfoButton}" Click="AjudaComunicacoes_Click" />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"
                                           Text="Importa as ligações de comunicações (fibra e outras) dos jardins-escola, integrados ou não, associando cada linha à respetiva escola. Regista/atualiza sempre pela combinação Escola + Nº Contrato." />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Importar Comunicações..." Style="{StaticResource AdminButtonIndigo}" Click="ImportarComunicacoes_Click" Padding="16,10" Margin="0,0,8,0" />
                                    <Button Content="⬇️ Template Excel" Style="{StaticResource AdminButtonGreenDark}" Padding="12,6" Click="TemplateComunicacoes_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ COLUNA DIREITA: Importar Tudo ============ -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Importar Tudo" Style="{StaticResource SectionTitleStyle}" FontSize="16" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,16"
                                   Text="Importa todas as fases de uma só vez, a partir de um único ficheiro Excel com uma aba por fase — o mesmo formato produzido por &quot;Exportar Tudo&quot; (aba Exportar Dados), para que a importação fique normalizada com a exportação. Respeita a ordem de dependências entre fases automaticamente." />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Button Content="📦 Importar Tudo..." Style="{StaticResource AdminButtonGreenDark}"
                                        Click="ImportarTudo_Click" Padding="16,10" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== ABA: EXPORTAR DADOS ==================== -->
            <TabItem Header="📤 Exportar Dados" Style="{StaticResource AdminTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="Exportar Dados" Style="{StaticResource SectionTitleStyle}" FontSize="16" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,16"
                               Text="Gera ficheiros Excel (.xlsx) com os dados atuais, no mesmo formato de cabeçalhos usado na Importação — a operação inversa: em vez de trazer dados de um Excel para a aplicação, tira um retrato dos dados da aplicação para um Excel." />

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Tudo num só ficheiro" FontWeight="Bold" Margin="0,0,0,8" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"
                                       Text="Exporta todas as fases de uma só vez, cada uma para a sua própria aba dentro do mesmo ficheiro Excel." />
                            <Button Content="Exportar Tudo..." Style="{StaticResource PrimaryButton}" Click="ExportarTudo_Click" Padding="16,10" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Por fase" FontWeight="Bold" Margin="0,0,0,8" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"
                                       Text="Exporta apenas os dados de uma fase específica, um ficheiro por botão." />
                            <StackPanel>
                                <Button Content="Fase 1 — Agrupamentos + Escolas..." Style="{StaticResource AdminButtonBlue}" Click="ExportarAgrupamentosEscolas_Click" Padding="14,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,8" />
                                <Button Content="Fase 2 — Equipamento..." Style="{StaticResource AdminButtonTeal}" Click="ExportarEquipamento_Click" Padding="14,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,8" />
                                <Button Content="Fase 3 — Intervenções..." Style="{StaticResource AdminButtonPurple}" Click="ExportarIntervencoes_Click" Padding="14,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,8" />
                                <Button Content="Fase 4 — Equipamento Abatido..." Style="{StaticResource AdminButtonOrange}" Click="ExportarEquipamentoAbatido_Click" Padding="14,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,8" />
                                <Button Content="Fase 5 — Equipamento Recolhido..." Style="{StaticResource AdminButtonRose}" Click="ExportarEquipamentoRecolhido_Click" Padding="14,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,8" />
                                <Button Content="Atividades DISIA..." Style="{StaticResource AdminButtonIndigo}" Click="ExportarAtividadesDisia_Click" Padding="14,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,8" />
                                <Button Content="Comunicações..." Style="{StaticResource AdminButtonIndigo}" Click="ExportarComunicacoes_Click" Padding="14,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== ABA: ESCOLAS DESATIVADAS ==================== -->
            <TabItem x:Name="TabEscolasDesativadas" Header="🏫 Escolas Desativadas" Style="{StaticResource AdminTabItem}">
                <Grid Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Reativar Escolas" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,12"
                                   Text="As escolas listadas abaixo estão no estado &quot;Desativada&quot; e não aparecem nas listas gerais da aplicação. Clique no botão verde para as repor como Ativas. (Escolas &quot;Em Obras&quot; ou noutros estados continuam visíveis normalmente; o estado altera-se na ficha da própria escola, em Escolas → duplo-clique → Estado da Escola.)" />
                        <Border Style="{StaticResource CardStyle}">
                            <DataGrid x:Name="GridEscolasDesativadas" Height="550">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Cód." Binding="{Binding CodEscola}" Width="Auto" />
                                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" />
                                    <DataGridTextColumn Header="Localidade" Binding="{Binding Localidade}" Width="Auto" />
                                    <DataGridTextColumn Header="Agrupamento" Binding="{Binding Agrupamento.Nome}" Width="Auto" />
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="Auto" />
                                    <DataGridTemplateColumn Header="Ação" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✓ Reativar" Background="#22C55E" Foreground="White" Padding="12,6" FontWeight="SemiBold"
                                                        Click="ReativarEscola_Click" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <TextBlock x:Name="TxtEscolasDesativadasCount" Text="Total: 0 escolas desativadas" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ==================== ABA: ELIMINAR REGISTOS ==================== -->
            <TabItem x:Name="TabEliminarRegistos" Header="🗑️ Eliminar Registos" Style="{StaticResource AdminTabItem}">
                <Grid Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Eliminar Registos de Tabelas" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,12"
                                   Text="⚠️ Esta área permite eliminar diretamente linhas de qualquer tabela de dados da aplicação (Agrupamentos, Escolas, Equipamentos, Intervenções, etc.). A eliminação é definitiva e não pode ser desfeita. Se um registo tiver outros dados dependentes associados (ex.: uma escola com intervenções), a eliminação é recusada para não corromper os dados — elimine primeiro esses registos dependentes." />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Tabela:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                            <ComboBox x:Name="CmbTabelaEliminar" Width="260" DisplayMemberPath="Rotulo" SelectionChanged="CmbTabelaEliminar_SelectionChanged" />
                            <Button Content="🔄 Atualizar" Style="{StaticResource AdminButtonBlue}" Click="AtualizarTabelaEliminar_Click" Margin="12,0,0,0" />
                        </StackPanel>

                        <Border Style="{StaticResource CardStyle}">
                            <DataGrid x:Name="GridEliminarRegistos" Height="420" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Extended" SelectionUnit="FullRow" />
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock x:Name="TxtEliminarRegistosCount" Text="0 registos" VerticalAlignment="Center"
                                       Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,16,0" />
                            <Button Content="🗑️ Eliminar Selecionados" Background="#EF4444" Foreground="White" Padding="14,8"
                                    FontWeight="SemiBold" Click="EliminarRegistosSelecionados_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="🔐 Segurança" Style="{StaticResource AdminTabItem}">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="420" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" MinWidth="420" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Política de Palavras-passe" Style="{StaticResource SectionTitleStyle}" FontSize="18" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,12"
                                   Text="Aplica-se à criação/edição de utilizadores em Administração e à alteração da própria palavra-passe." />
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Mínimo de caracteres" FontWeight="SemiBold" />
                                <TextBox x:Name="TxtPoliticaMinCaracteres" Width="120" HorizontalAlignment="Left" Margin="0,4,0,14" />

                                <CheckBox x:Name="ChkPoliticaMaiuscula" Content="Exigir pelo menos uma letra maiúscula (A-Z)" Margin="0,0,0,8" />
                                <CheckBox x:Name="ChkPoliticaMinuscula" Content="Exigir pelo menos uma letra minúscula (a-z)" Margin="0,0,0,8" />
                                <CheckBox x:Name="ChkPoliticaNumero" Content="Exigir pelo menos um número (0-9)" Margin="0,0,0,8" />
                                <CheckBox x:Name="ChkPoliticaSimbolo" Content="Exigir pelo menos um símbolo (! @ # $ % *)" Margin="0,0,0,14" />

                                <Button Content="Guardar política" Style="{StaticResource AdminButtonGreenDark}"
                                        Click="GuardarPoliticaPassword_Click" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tentativas de Login" Style="{StaticResource SectionTitleStyle}" FontSize="18" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,12"
                                   Text="Após o número de tentativas falhadas indicado, a conta é bloqueada automaticamente e só pode ser reativada por um administrador em Administração → Utilizadores." />
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Número máximo de tentativas (0 = desativado)" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBox x:Name="TxtTentativasLoginMaximo" Width="120" HorizontalAlignment="Left" Margin="0,4,0,14" />
                                <Button Content="Guardar" Style="{StaticResource AdminButtonGreenDark}"
                                        Click="GuardarTentativasLogin_Click" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Sessão" Style="{StaticResource SectionTitleStyle}" FontSize="18" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,12"
                                   Text="Termina a sessão automaticamente (fecha todas as janelas e volta ao ecrã de login) ao fim do tempo de inatividade indicado, em qualquer parte da aplicação." />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="ChkSessaoInatividade" Content="Terminar sessão automaticamente por inatividade" Margin="0,0,0,12" />
                                <TextBlock Text="Minutos de inatividade" FontWeight="SemiBold" />
                                <TextBox x:Name="TxtSessaoMinutos" Width="120" HorizontalAlignment="Left" Margin="0,4,0,14" />
                                <Button Content="Guardar" Style="{StaticResource AdminButtonGreenDark}"
                                        Click="GuardarSessao_Click" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabSistema" Header="💻 Sistema" Style="{StaticResource AdminTabItem}">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="420" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" MinWidth="420" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Informação da Aplicação" Style="{StaticResource SectionTitleStyle}" FontSize="18" Margin="0,0,0,12" />
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Versão da aplicação" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TxtVersaoAplicacao" Grid.Column="1" Foreground="{StaticResource BrushPrimary}" FontWeight="SemiBold" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Versão do .NET" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TxtVersaoDotNet" Grid.Column="1" Foreground="{StaticResource BrushPrimary}" FontWeight="SemiBold" />
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Sistema operativo" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TxtSistemaOperativo" Grid.Column="1" Foreground="{StaticResource BrushPrimary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Grid>

                                <TextBlock Text="Diretório de instalação" FontWeight="SemiBold" />
                                <TextBox x:Name="TxtDiretorioInstalacao" IsReadOnly="True" Margin="0,4,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Abrir no Explorador" Style="{StaticResource AdminButtonBlue}"
                                            Click="AbrirDiretorioInstalacao_Click" Margin="0,0,8,0" />
                                    <Button Content="Copiar caminho" Click="CopiarDiretorioInstalacao_Click" Padding="10,6" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Estado Atual" Style="{StaticResource SectionTitleStyle}" FontSize="18" Margin="0,0,0,12" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Modelo de IA" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border x:Name="BadgeModeloIa" Grid.Column="1" Style="{StaticResource BadgePillStyle}" HorizontalAlignment="Left">
                                        <TextBlock x:Name="TxtModeloIa" Style="{StaticResource BadgeTextStyle}" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Sessão iniciada por" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TxtSessaoIniciadaPor" Grid.Column="1" TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Memória em uso" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TxtMemoriaEmUso" Grid.Column="1" />
                                </Grid>
                                <Button Content="Atualizar" Style="{StaticResource AdminButtonBlue}"
                                        Click="AtualizarEstadoSistema_Click" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Diretórios e Espaço em Disco" Style="{StaticResource SectionTitleStyle}" FontSize="18" Margin="0,0,0,12" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Pasta de dados da aplicação" FontWeight="SemiBold" />
                                <TextBox x:Name="TxtPastaDados" IsReadOnly="True" Margin="0,4,0,10" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Button Content="Abrir no Explorador" Style="{StaticResource AdminButtonBlue}"
                                            Click="AbrirPastaDados_Click" Margin="0,0,8,0" />
                                    <Button Content="Copiar caminho" Click="CopiarPastaDados_Click" Padding="10,6" />
                                </StackPanel>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tamanho da pasta de dados" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="TxtTamanhoPastaDados" Grid.Column="1" Foreground="{StaticResource BrushPrimary}" FontWeight="SemiBold" />
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Espaço livre em disco" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="TxtEspacoLivre" Grid.Column="1" Foreground="{StaticResource BrushPrimary}" FontWeight="SemiBold" />
                                </Grid>

                                <Button Content="Atualizar" Style="{StaticResource AdminButtonBlue}"
                                        Click="AtualizarDiretoriosDisco_Click" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabAuditoria" Header="📋 Auditoria" Style="{StaticResource AdminTabItem}">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Auditoria" Style="{StaticResource SectionTitleStyle}" FontSize="18" Margin="0,0,0,12" />

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <UniformGrid Columns="4" Rows="1">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Pesquisar" FontWeight="SemiBold" />
                                    <TextBox x:Name="TxtAuditoriaPesquisa" Margin="0,4,0,0" TextChanged="FiltroAuditoriaTexto_Changed" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Ação" FontWeight="SemiBold" />
                                    <ComboBox x:Name="CmbAuditoriaAcao" Margin="0,4,0,0" SelectionChanged="FiltroAuditoriaCombo_Changed" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Resultado" FontWeight="SemiBold" />
                                    <ComboBox x:Name="CmbAuditoriaResultado" Margin="0,4,0,0" SelectionChanged="FiltroAuditoriaCombo_Changed" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="De — Até" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <DatePicker x:Name="DpAuditoriaDe" Width="130" SelectedDateChanged="FiltroAuditoriaData_Changed" />
                                        <DatePicker x:Name="DpAuditoriaAte" Width="130" Margin="8,0,0,0" SelectedDateChanged="FiltroAuditoriaData_Changed" />
                                    </StackPanel>
                                </StackPanel>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Limpar filtros" Click="LimparFiltrosAuditoria_Click" Padding="12,6" Margin="0,0,8,0" />
                                <Button Content="Atualizar" Style="{StaticResource AdminButtonBlue}" Click="AtualizarAuditoria_Click" Padding="12,6" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                        <DataGrid x:Name="GridAuditoria" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data/Hora" Binding="{Binding DataHora, StringFormat=dd-MM-yyyy HH:mm:ss}" Width="Auto" />
                                <DataGridTextColumn Header="Utilizador" Binding="{Binding Utilizador}" Width="Auto" />
                                <DataGridTextColumn Header="Ação" Binding="{Binding Acao}" Width="Auto" />
                                <DataGridTextColumn Header="Detalhe" Binding="{Binding Detalhe}" Width="*" />
                                <DataGridTemplateColumn Header="Resultado" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource BadgePillStyle}"
                                                    Background="{Binding CorResultado, Converter={StaticResource HexColorToBrushConverter}}">
                                                <TextBlock Text="{Binding Resultado}" Style="{StaticResource BadgeTextStyle}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
