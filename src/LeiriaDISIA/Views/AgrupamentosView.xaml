<UserControl x:Class="LeiriaDISIA.Views.AgrupamentosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="Agrupamentos de Escolas" Style="{StaticResource SectionTitleStyle}" FontSize="24" />
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <DataGrid x:Name="Grid" Height="300" CanUserSortColumns="True" SelectionChanged="Grid_SelectionChanged" RowStyle="{StaticResource DataGridRowClickableStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding CodAgrupamento}" Width="Auto" />
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" />
                        <DataGridTextColumn Header="Nº Escolas" Binding="{Binding TotalEscolas}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock x:Name="TxtTituloEscolas" Text="Escolas do agrupamento selecionado" Style="{StaticResource SectionTitleStyle}" FontSize="16" Margin="0,0,16,0" />
                <Button x:Name="BtnAdicionarEscola" Content="+ Adicionar escola a este agrupamento"
                        Click="AdicionarEscola_Click" IsEnabled="False" />
            </StackPanel>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <DataGrid x:Name="GridEscolas" Height="220" CanUserSortColumns="True" MouseDoubleClick="GridEscolas_MouseDoubleClick" RowStyle="{StaticResource DataGridRowClickableStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Escola" Binding="{Binding Nome}" Width="*" />
                            <DataGridTextColumn Header="Cod. GEPE" Binding="{Binding CodGEPE}" Width="Auto" />
                            <DataGridTextColumn Header="Localidade" Binding="{Binding Localidade}" Width="Auto" />
                            <DataGridTextColumn Header="Freguesia" Binding="{Binding Freguesia}" Width="Auto" />
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="Auto" />
                            <DataGridTemplateColumn Header="Estado" Width="Auto" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource BadgePillStyle}" Background="{Binding CorEstado, Converter={StaticResource HexColorToBrushConverter}}">
                                            <TextBlock Text="{Binding Estado}" Style="{StaticResource BadgeTextStyle}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="💡 Duplo-clique numa escola para ver/editar os seus detalhes."
                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <TextBlock Text="Adicionar / Editar" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Código do Agrupamento" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtCodigo" Margin="0,4,0,12" />

                    <TextBlock Text="Nome do Agrupamento" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtNome" Margin="0,4,0,12" />

                    <TextBlock Text="Observações" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtObservacoes" Margin="0,4,0,16" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Click="Guardar_Click" Margin="0,0,8,0" />
                        <Button Content="Novo" Click="Novo_Click" Margin="0,0,8,0" />
                        <Button Content="Eliminar" Click="Eliminar_Click" Background="#FDECEC" />
                    </StackPanel>

                    <Separator Margin="0,16" />
                    <Button Content="Gerar relatório de agrupamentos" Style="{StaticResource ReportButton}" Click="GerarRelatorio_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
