<Window x:Class="LeiriaDISIA.Views.RelatoriosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relatórios — Gestão DISIA" WindowState="Maximized"
        Background="{StaticResource BrushBackground}" FontFamily="Segoe UI">
    <DockPanel Margin="24">
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="🏠 Menu Principal" Style="{StaticResource MenuPrincipalButton}" Click="MenuPrincipal_Click" Margin="0,0,10,0" />
                <TextBlock Text="Relatórios" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
        </Border>

        <TabControl Background="Transparent" BorderThickness="0">

            <!-- ==================== TEMA: RELATÓRIO DE ATIVIDADES (WORD) ==================== -->
            <TabItem Header="📄 Relatório de Atividades" Style="{StaticResource AdminTabItem}">
                <DockPanel Margin="0,16,0,0" LastChildFill="True">

                    <!-- Secção única: Relatório Mensal de Atividades (dados comuns ao Word e ao PDF) -->
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Relatório Mensal de Atividades" Style="{StaticResource SectionTitleStyle}" FontSize="16" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,12"
                                   Text="Relatório mensal de atividades (intervenções nas escolas + atividades da DISIA). Preencha os dados uma única vez e gere o relatório no formato pretendido: Word (.docx), no formato do relatório modelo, ou PDF profissional completo (capa, sumário/índice, gráficos, gestão da plataforma SIGA e reflexão crítica)." />
                    </StackPanel>

                    <!-- Nota de rodapé -->
                    <TextBlock DockPanel.Dock="Bottom" Text="O Ano e Mês escolhidos nesta aba também são usados nos separadores &quot;Intervenções&quot; e &quot;Atividades da DISIA&quot;, nos botões &quot;Mês Escolhido&quot;."
                               TextWrapping="Wrap" FontSize="11" FontStyle="Italic" Foreground="{StaticResource BrushTextSecondary}" Margin="0,10,0,0" />

                    <!-- (5.1.3) Linha de botões ancorada ao fundo da janela -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="📄 Gerar Relatório Mensal (.docx)" Style="{StaticResource ReportButton}"
                                Click="GerarMensal_Click" Padding="16,10" Margin="0,0,12,0" />
                        <Button Content="📕 Gerar Relatório Mensal (.pdf)" Style="{StaticResource PrimaryButton}"
                                Click="GerarMensalPdf_Click" Padding="16,10" />
                    </StackPanel>

                    <!-- (5.1.3) Linha de dados: ocupa o resto da altura disponível da janela -->
                    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <!-- Layout em modo paisagem: os quatro blocos lado a lado -->
                        <Border Style="{StaticResource CardStyle}" VerticalAlignment="Stretch">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="420"/>  <!-- Bloco 1: Dados Gerais -->
                                    <ColumnDefinition Width="Auto"/> <!-- Separador -->
                                    <ColumnDefinition Width="440"/>  <!-- Bloco 2: Plataforma SIGA -->
                                    <ColumnDefinition Width="Auto"/> <!-- Separador -->
                                    <ColumnDefinition Width="*"/>    <!-- Bloco 3: Reflexão Crítica (preenche o espaço restante) -->
                                    <ColumnDefinition Width="Auto"/> <!-- Separador -->
                                    <ColumnDefinition Width="200"/>  <!-- Bloco 4: Relatório Anual -->
                                </Grid.ColumnDefinitions>

                                <!-- Bloco 1: Dados Gerais -->
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="Dados Gerais" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,8" />

                                    <TextBlock Text="Ano" FontWeight="SemiBold" />
                                    <ComboBox x:Name="CmbAno" Margin="0,4,0,10" SelectionChanged="CmbAnoMes_SelectionChanged" />

                                    <TextBlock Text="Mês" FontWeight="SemiBold" />
                                    <ComboBox x:Name="CmbMes" Margin="0,4,0,10" SelectionChanged="CmbAnoMes_SelectionChanged" />

                                    <TextBlock Text="Autor" FontWeight="SemiBold" />
                                    <TextBox x:Name="TxtAutor" Text="Paulo Miguel Nunes Penicheiro" Margin="0,4,0,10" />

                                    <TextBlock Text="Divisão" FontWeight="SemiBold" />
                                    <TextBox x:Name="TxtDivisao" Text="DISIA – Divisão de Sistemas de Informação e Aplicações" Margin="0,4,0,10" TextWrapping="Wrap" />

                                    <TextBlock Text="Telefone" FontWeight="SemiBold" />
                                    <TextBox x:Name="TxtTelefone" Margin="0,4,0,10" />

                                    <TextBlock Text="Email" FontWeight="SemiBold" />
                                    <TextBox x:Name="TxtEmail" Margin="0,4,0,0" />
                                </StackPanel>

                                <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="#E2E8F0" Margin="0,0,20,0" />

                                <!-- Bloco 2: Plataforma SIGA + imagens -->
                                <StackPanel Grid.Column="2" Margin="0,0,20,0">
                                    <TextBlock Text="Plataforma SIGA — dados do mês" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,8" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <StackPanel Margin="0,0,14,0" Width="130">
                                            <TextBlock Text="Total Alt. Tipificação" FontSize="11" FontWeight="SemiBold" />
                                            <TextBox x:Name="TxtTotalTipificacao" Margin="0,4,0,0" TextAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,14,0" Width="130">
                                            <TextBlock Text="Total Estado de Tickets" FontSize="11" FontWeight="SemiBold" />
                                            <TextBox x:Name="TxtTotalEstadoTickets" Margin="0,4,0,0" TextAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Width="130">
                                            <TextBlock Text="Total Alt. Passwords" FontSize="11" FontWeight="SemiBold" />
                                            <TextBox x:Name="TxtTotalPasswords" Margin="0,4,0,0" HorizontalAlignment="Center" Width="126" TextAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <StackPanel Width="130">
                                            <TextBlock Text="Total Utilizadores Criados" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBox x:Name="TxtTotalUtilizadoresCriados" Margin="0,4,0,0" TextAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Os dois botões de imagem passam a ficar um por baixo do outro (em vez de lado a
                                         lado): quando o título da 1ª imagem era mais comprido, o 2º botão "deslizava"
                                         para a direita e o bloco ficava desalinhado. -->
                                    <StackPanel Margin="0,0,0,0">
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="Imagem: Pedidos SIGA" FontSize="11" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                                <Button Content="🖼️ Anexar Imagem..." Style="{StaticResource AdminButtonOrange}" HorizontalAlignment="Left" Click="AnexarImagemPedidosSiga_Click" />
                                            </StackPanel>
                                            <TextBlock x:Name="TxtNomeImagemPedidos" Text="(nenhuma imagem anexada)" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Imagem: Workflows SIGA" FontSize="11" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                                <Button Content="🖼️ Anexar Imagem..." Style="{StaticResource AdminButtonOrange}" HorizontalAlignment="Left" Click="AnexarImagemWorkflowSiga_Click" />
                                            </StackPanel>
                                            <TextBlock x:Name="TxtNomeImagemWorkflow" Text="(nenhuma imagem anexada)" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="3" BorderThickness="1,0,0,0" BorderBrush="#E2E8F0" Margin="0,0,20,0" />

                                <!-- Bloco 3: Reflexão Crítica — preenche verticalmente todo o espaço disponível -->
                                <DockPanel Grid.Column="4" LastChildFill="True" VerticalAlignment="Stretch" ClipToBounds="True">

                                    <!-- Cabeçalho fixo no topo -->
                                    <StackPanel DockPanel.Dock="Top">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Reflexão Crítica" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Button x:Name="BtnGerarRascunhoIA" Content="🤖 Gerar com IA Local" Style="{StaticResource AdminButtonIndigo}"
                                                    Click="GerarRascunhoReflexaoIA_Click" Margin="0,0,8,0"
                                                    ToolTip="Gera um texto variado e adaptado aos dados reais do mês, usando um modelo de IA que corre inteiramente neste computador (ver Administração → Inteligência Artificial Local)." />
                                            <Button Content="📋 Rascunho Rápido (modelo fixo)" Style="{StaticResource AdminButtonOrange}" Click="GerarRascunhoReflexao_Click" Margin="0,0,8,0"
                                                    ToolTip="Preenche a partir de um modelo de texto fixo (mais rápido, mas sempre com frases muito parecidas de mês para mês)." />
                                            <Button Content="🗑️ Limpar Rascunhos" Style="{StaticResource AdminButtonRose}" Click="LimparRascunhosReflexao_Click" />
                                        </StackPanel>
                                        <TextBlock x:Name="TxtEstadoRascunhoIA" TextWrapping="Wrap" FontSize="10.5" FontStyle="Italic"
                                                   Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,4" Visibility="Collapsed" />
                                        <TextBlock TextWrapping="Wrap" FontSize="10.5" FontStyle="Italic" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"
                                                   Text="'Gerar com IA Local' corre um modelo de linguagem inteiramente neste computador (nenhum dado sai da aplicação), produzindo um texto diferente e adaptado a cada mês; a primeira utilização pode demorar mais tempo, pois carrega o modelo para memória. 'Rascunho Rápido' usa um modelo de texto fixo, instantâneo mas repetitivo. Reveja e ajuste sempre o texto antes de gerar o relatório." />

                                    </StackPanel>

                                    <!-- Grid com 4 campos que partilham igualmente o espaço vertical restante -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Balanço Geral do Mês" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <TextBox Grid.Row="1" x:Name="TxtBalancoGeral" Margin="0,0,0,6" AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" TextAlignment="Justify" />

                                        <TextBlock Grid.Row="2" Text="Principais Desafios e Constrangimentos" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <TextBox Grid.Row="3" x:Name="TxtDesafios" Margin="0,0,0,6" AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" TextAlignment="Justify" />

                                        <TextBlock Grid.Row="4" Text="Propostas de Melhoria para os Próximos Meses" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <TextBox Grid.Row="5" x:Name="TxtPropostas" Margin="0,0,0,6" AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" TextAlignment="Justify" />

                                        <TextBlock Grid.Row="6" Text="Nota Final" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <TextBox Grid.Row="7" x:Name="TxtNotaFinal" Margin="0,0,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" TextAlignment="Center" />
                                    </Grid>

                                </DockPanel>

                                <Border Grid.Column="5" BorderThickness="1,0,0,0" BorderBrush="#E2E8F0" Margin="20,0,20,0" />

                                <!-- Bloco 4: Relatório Anual (ao lado da Reflexão Crítica) -->
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Relatório Anual" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}"
                                               TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Text="Resumo anual, agregando os totais de todos os meses do ano selecionado (usa o Ano escolhido acima)."
                                               TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" />
                                    <Button Content="Gerar Relatório Anual (.docx)" Style="{StaticResource ReportButton}"
                                            Click="GerarAnual_Click" Padding="8,10"
                                            HorizontalAlignment="Stretch" />
                                </StackPanel>

                            </Grid>
                        </Border>
                    </ScrollViewer>

                </DockPanel>
            </TabItem>

            <!-- ==================== TEMA: INTERVENÇÕES ==================== -->
            <TabItem Header="🏫 Escolas e Agrupamentos" Style="{StaticResource AdminTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                <WrapPanel Orientation="Horizontal">

                    <Border Style="{StaticResource CardStyle}" Width="300" Margin="0,0,16,16">
                        <StackPanel>
                            <TextBlock Text="Lista de Escolas" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,4" />
                            <TextBlock Text="Todas as escolas e jardins de infância, por agrupamento."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" Height="46" />
                            <Button Content="📋 Gerar PDF" Style="{StaticResource PrimaryButton}" Click="GerarListaEscolas_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Width="300" Margin="0,0,16,16">
                        <StackPanel>
                            <TextBlock Text="Lista de Agrupamentos" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,4" />
                            <TextBlock Text="Agrupamentos, contactos e nº de escolas de cada um."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" Height="46" />
                            <Button Content="📋 Gerar PDF" Style="{StaticResource PrimaryButton}" Click="GerarListaAgrupamentos_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Width="300" Margin="0,0,16,16">
                        <StackPanel>
                            <TextBlock Text="Resumo de Infraestrutura" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,4" />
                            <TextBlock Text="Cobertura de Fibra, CCTV e VPN, por agrupamento."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" Height="46" />
                            <Button Content="📊 Gerar PDF" Style="{StaticResource PrimaryButton}" Click="GerarResumoInfraestrutura_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <!-- (5.2.1) Novo relatório: Códigos GEPE -->
                    <Border Style="{StaticResource CardStyle}" Width="300" Margin="0,0,16,16">
                        <StackPanel>
                            <TextBlock Text="Códigos GEPE" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,4" />
                            <TextBlock Text="Código da escola, nome, agrupamento e código GEPE de cada estabelecimento."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" Height="46" />
                            <Button Content="📋 Gerar PDF" Style="{StaticResource PrimaryButton}" Click="GerarListaCodigosGepe_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                </WrapPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== TEMA: ATIVIDADES DA DISIA ==================== -->
            <TabItem Header="🖥️ Equipamento" Style="{StaticResource AdminTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                <WrapPanel Orientation="Horizontal">

                    <Border Style="{StaticResource CardStyle}" Width="300" Margin="0,0,16,16">
                        <StackPanel>
                            <TextBlock Text="Lista de Equipamentos - Inventário" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,4" />
                            <TextBlock Text="Inventário agrupado por Agrupamento e Escola, com subtotais e classificação de obsolescência."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" Height="46" />
                            <Button Content="📋 Gerar PDF" Style="{StaticResource PrimaryButton}" Click="GerarListaEquipamento_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Width="300" Margin="0,0,16,16">
                        <StackPanel>
                            <TextBlock Text="Resumo de Obsolescência" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,4" />
                            <TextBlock Text="Classificação por nível e por tipo de equipamento."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" Height="46" />
                            <Button Content="📊 Gerar PDF" Style="{StaticResource PrimaryButton}" Click="GerarResumoObsolescencia_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Width="300" Margin="0,0,16,16">
                        <StackPanel>
                            <TextBlock Text="Equipamento Abatido" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,4" />
                            <TextBlock Text="Histórico de equipamento abatido, doado ou reciclado."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" Height="46" />
                            <Button Content="📋 Gerar PDF" Style="{StaticResource PrimaryButton}" Click="GerarListaEquipamentoAbatido_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Width="300" Margin="0,0,16,16">
                        <StackPanel>
                            <TextBlock Text="Equipamento Recolhido" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,4" />
                            <TextBlock Text="Equipamento recolhido das escolas para intervenção."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" Height="46" />
                            <Button Content="📋 Gerar PDF" Style="{StaticResource PrimaryButton}" Click="GerarListaEquipamentoRecolhido_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Width="300" Margin="0,0,16,16">
                        <StackPanel>
                            <TextBlock Text="Pesquisa Avançada de Equipamento" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,4" />
                            <TextBlock Text="Filtre por tipo, marca, características (RAM, disco, polegadas, etc.) com comparadores (=, &gt;, &lt;...) antes de gerar o PDF."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" Height="46" />
                            <Button Content="🔍 Pesquisa Avançada..." Style="{StaticResource PrimaryButton}" Click="PesquisaAvancadaEquipamento_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                </WrapPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== TEMA: COMUNICAÇÕES E CONTACTOS ==================== -->
            <TabItem Header="📋 Pedidos de Intervenção" Style="{StaticResource AdminTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                <WrapPanel Orientation="Horizontal">

                    <Border Style="{StaticResource CardStyle}" Width="300" Margin="0,0,16,16">
                        <StackPanel>
                            <TextBlock Text="Lista de Pedidos" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,4" />
                            <TextBlock Text="Todos os pedidos submetidos pelas escolas, incluindo os em aberto."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" Height="46" />
                            <Button Content="📋 Gerar PDF" Style="{StaticResource PrimaryButton}" Click="GerarListaPedidos_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Width="300" Margin="0,0,16,16">
                        <StackPanel>
                            <TextBlock Text="Resumo por Estado" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,4" />
                            <TextBlock Text="Gráfico por estado e escolas com mais pedidos submetidos."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" Height="46" />
                            <Button Content="📊 Gerar PDF" Style="{StaticResource PrimaryButton}" Click="GerarResumoPedidosPorEstado_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                </WrapPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== TEMA: ESCOLAS E AGRUPAMENTOS ==================== -->
            <TabItem Header="🔧 Intervenções" Style="{StaticResource AdminTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                <WrapPanel Orientation="Horizontal">

                    <!-- Lista Total -->
                    <Border Style="{StaticResource CardStyle}" Width="300" Margin="0,0,16,16">
                        <StackPanel>
                            <TextBlock Text="Lista de Intervenções" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,4" />
                            <TextBlock Text="Todas as intervenções técnicas, com resumo visual por agrupamento no início do documento."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" Height="46" />
                            <Button Content="📋 Ano" Style="{StaticResource PrimaryButton}" Click="GerarListaIntervencoesAno_Click" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                            <Button Content="📋 Todos os Anos" Click="GerarListaIntervencoesTodas_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <!-- Mês Corrente -->
                    <Border Style="{StaticResource CardStyle}" Width="300" Margin="0,0,16,16">
                        <StackPanel>
                            <TextBlock Text="Mês Corrente" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,4" />
                            <TextBlock Text="Lista das intervenções do mês em curso, com um clique."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" Height="46" />
                            <Button Content="📅 Gerar PDF" Style="{StaticResource PrimaryButton}" Click="GerarListaIntervencoesMesCorrente_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <!-- Período à Escolha -->
                    <Border Style="{StaticResource CardStyle}" Width="300" Margin="0,0,16,16">
                        <StackPanel>
                            <TextBlock Text="Período à Escolha" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,4" />
                            <TextBlock Text="Intervenções registadas entre duas datas à sua escolha."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" Height="46" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Início" FontSize="10.5" FontWeight="SemiBold" />
                                    <DatePicker x:Name="DpPeriodoInicio" Width="128" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Fim" FontSize="10.5" FontWeight="SemiBold" />
                                    <DatePicker x:Name="DpPeriodoFim" Width="128" />
                                </StackPanel>
                            </StackPanel>
                            <Button Content="📆 Gerar PDF" Style="{StaticResource PrimaryButton}" Click="GerarListaIntervencoesPeriodo_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <!-- Resumo por Agrupamento -->
                    <Border Style="{StaticResource CardStyle}" Width="300" Margin="0,0,16,16">
                        <StackPanel>
