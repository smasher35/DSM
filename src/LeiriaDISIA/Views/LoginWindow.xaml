<Window x:Class="LeiriaDISIA.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar Sessão — Gestão DISIA" Height="440" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BrushPrimary}">
    <Border Background="White" CornerRadius="16" Margin="24" Padding="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="DISIA" FontSize="30" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Município de Leiria" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                       HorizontalAlignment="Center" Margin="0,2,0,24" />

            <TextBlock Text="Utilizador" FontWeight="SemiBold" />
            <TextBox x:Name="TxtUtilizador" Margin="0,4,0,14" Padding="8" FontSize="14" />

            <TextBlock Text="Palavra-passe" FontWeight="SemiBold" />
            <Grid Margin="0,4,0,6">
                <!-- PasswordBox não expõe o texto por Binding nem permite trocar a máscara em
                     runtime — por isso a alternância "mostrar/ocultar" usa uma segunda caixa
                     (TextBox, sem máscara) sobreposta na mesma célula da Grid, e só uma das duas
                     fica visível de cada vez (ver MostrarPassword_Click em LoginWindow.xaml.cs). -->
                <PasswordBox x:Name="TxtPassword" Padding="8,8,36,8" FontSize="14" KeyDown="TxtPassword_KeyDown" />
                <TextBox x:Name="TxtPasswordVisivel" Padding="8,8,36,8" FontSize="14" KeyDown="TxtPassword_KeyDown"
                         Visibility="Collapsed" />
                <Button x:Name="BtnMostrarPassword" Content="👁" FontSize="14" Cursor="Hand"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                        Padding="4,2" Background="Transparent" BorderThickness="0"
                        Click="MostrarPassword_Click" ToolTip="Mostrar palavra-passe" />
            </Grid>

            <TextBlock x:Name="TxtErro" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap"
                       Margin="0,4,0,10" Visibility="Collapsed" />

            <Button Content="Entrar" Style="{StaticResource PrimaryButton}" Click="Entrar_Click"
                    Padding="0,10" Margin="0,10,0,0" FontSize="15" />

            <TextBlock Text="Utilizador inicial: admin / admin123" FontSize="10"
                       Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,16,0,0" />
        </StackPanel>
    </Border>
</Window>
