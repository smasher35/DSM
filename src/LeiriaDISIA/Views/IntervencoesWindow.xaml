<Window x:Class="LeiriaDISIA.Views.IntervencoesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Intervenções — Gestão DISIA" WindowState="Maximized"
        Background="{StaticResource BrushBackground}" FontFamily="Segoe UI">
    <DockPanel Margin="24">
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="🏠 Menu Principal" Style="{StaticResource MenuPrincipalButton}" Click="MenuPrincipal_Click" Margin="0,0,10,0" />
                <Button x:Name="BtnInserir" Content="➕ Inserir Intervenção" Style="{StaticResource PrimaryButton}" Click="Inserir_Click" Margin="0,0,10,0" />
                <Button Content="📄 Importar Intervenção PDF" Style="{StaticResource AdminButtonIndigo}" Click="ImportarPdf_Click" Margin="0,0,10,0" />
                <Button Content="📄 Relatório do Módulo" Style="{StaticResource ReportButton}" Click="Relatorio_Click" Margin="0,0,30,0" />
                <TextBlock Text="Ano:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="CmbAno" Width="90" SelectionChanged="Filtro_Changed" Margin="0,0,16,0" VerticalAlignment="Center" />
                <TextBlock Text="Mês:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="CmbMes" Width="130" SelectionChanged="Filtro_Changed" Margin="0,0,16,0" VerticalAlignment="Center" />
                <TextBlock Text="Agrupamento:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="CmbAgrupamentoFiltro" Width="220" DisplayMemberPath="Nome" SelectionChanged="Filtro_Changed" Margin="0,0,30,0" VerticalAlignment="Center" />
                <TextBox x:Name="TxtPesquisa" Style="{StaticResource SearchTextBox}" Width="280" TextChanged="Filtro_TextChanged"
                         ToolTip="Pesquisar por escola, descrição ou tipo de intervenção" />
                <TextBlock Text="Intervenções" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" Margin="30,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Grid com linhas Auto (resumo + legendas) + "*" (DataGrid) + Auto (dica), em vez de
             StackPanel, para a lista de intervenções ocupar sempre todo o espaço livre até ao
             fundo da janela (mesmo padrão do módulo Atividades DISIA — ver Views/DisiaWindow.xaml). -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- "Categoria/Agrupamento/Escola mais intervencionada do ano" — reage ao Ano
                 escolhido no filtro acima (não ao Mês/Agrupamento/pesquisa: mostra sempre o ano
                 inteiro escolhido, para se conseguir ver o panorama anual independentemente do que
                 estiver filtrado na grelha por baixo) — ver AtualizarResumoIntervencoes em
                 IntervencoesWindow.xaml.cs. Três cartões lado a lado, mesmo padrão do destaque
                 "mais intervencionado" do módulo Equipamento Informático (ver
                 Views/EquipamentosWindow.xaml), para aproveitar a largura disponível. Cada cartão
                 tem a sua própria visibilidade: só aparece quando há pelo menos uma intervenção
                 nesse ano (ou, no caso do agrupamento, quando alguma intervenção do ano tem
                 agrupamento associado). -->
            <UniformGrid Grid.Row="0" Columns="3" Rows="1" Margin="0,0,0,12">
                <Border x:Name="PainelCategoriaMaisIntervencionada" Background="#FDECEC" CornerRadius="8" Padding="10" Margin="0,0,10,0" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔧" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Categoria mais intervencionada do ano" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="TxtCategoriaMaisIntervencionada" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="PainelAgrupamentoMaisIntervencionadoAno" Background="#FDECEC" CornerRadius="8" Padding="10" Margin="0,0,10,0" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏘️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Agrupamento mais intervencionado do ano" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="TxtAgrupamentoMaisIntervencionadoAno" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="PainelEscolaMaisIntervencionadaAno" Background="#FDECEC" CornerRadius="8" Padding="10" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏫" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Escola mais intervencionada do ano" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="TxtEscolaMaisIntervencionadaAno" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- "Intervenções por Categoria" — Total Anual (mesmo Ano do filtro acima) e Mês
                 Corrente (sempre o mês atual, DateTime.Today — não o Mês escolhido no filtro
                 acima, para ficar sempre "o que se passou este mês", tal como os cartões
                 equivalentes do Dashboard). % de cada categoria sobre o total de
                 categorias-em-intervenções do período (uma intervenção pode ter mais do que uma
                 categoria — ver Intervencao.Categorias — por isso a soma das percentagens não
                 corresponde ao nº de intervenções, mas sim ao nº de categorias registadas).
                 Gauges (modo normal) ou barras finas (Modo Compacto) construídos dinamicamente em
                 código — ver AtualizarGaugesCategoria em IntervencoesWindow.xaml.cs — mesmo
                 mecanismo de "Sistemas Operativos"/"Armazenamento" no módulo Equipamento
                 Informático. -->
            <UniformGrid Grid.Row="1" Columns="2" Rows="1" Margin="0,0,0,12">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Intervenções por Categoria — Total Anual" Style="{StaticResource SectionTitleStyle}" FontSize="16" />
                        <TextBlock x:Name="TxtTotalCategoriaAno" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"
                                   Text="% de cada categoria sobre o total do ano" />
                        <TextBlock x:Name="TxtSemCategoriaAno" TextWrapping="Wrap" FontSize="11" FontStyle="Italic"
                                   Foreground="{StaticResource BrushTextSecondary}" Visibility="Collapsed"
                                   Text="Nenhuma intervenção com categoria registada este ano." />
                        <WrapPanel x:Name="PainelGaugesCategoriaAno" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Intervenções por Categoria — Mês Corrente" Style="{StaticResource SectionTitleStyle}" FontSize="16" />
                        <TextBlock x:Name="TxtTotalCategoriaMes" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"
                                   Text="% de cada categoria sobre o total do mês corrente" />
                        <TextBlock x:Name="TxtSemCategoriaMes" TextWrapping="Wrap" FontSize="11" FontStyle="Italic"
                                   Foreground="{StaticResource BrushTextSecondary}" Visibility="Collapsed"
                                   Text="Nenhuma intervenção com categoria registada este mês." />
                        <WrapPanel x:Name="PainelGaugesCategoriaMes" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="8" Padding="10">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="12" Height="12" Fill="#22C55E" Margin="0,0,4,0" />
                        <TextBlock Text="Fechada" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Ellipse Width="12" Height="12" Fill="#EF4444" Margin="0,0,4,0" />
                        <TextBlock Text="Pendente" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Ellipse Width="12" Height="12" Fill="#F59E0B" Margin="0,0,4,0" />
                        <TextBlock Text="Em Progresso" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Ellipse Width="12" Height="12" Fill="#6366F1" Margin="0,0,4,0" />
                        <TextBlock Text="Em Espera (aguarda equipamento)" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Ellipse Width="12" Height="12" Fill="#9CA3AF" Margin="0,0,4,0" />
                        <TextBlock Text="Cancelada" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <!-- (4.1) Legenda dos quadrados de cor da coluna "Categorias" da grelha, junto da legenda de estados -->
                <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="8" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Categorias:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" />
                        <ItemsControl x:Name="LegendaCategorias">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                        <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2"
                                                   Fill="{Binding CorHex, Converter={StaticResource HexColorToBrushConverter}}" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding Nome}" VerticalAlignment="Center" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                <DataGrid x:Name="Grid" CanUserSortColumns="True" MouseDoubleClick="Grid_MouseDoubleClick"
                          RowHeight="NaN" MinRowHeight="34" RowStyle="{StaticResource DataGridRowClickableStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd-MM-yyyy}" Width="Auto" />
                        <DataGridTextColumn Header="Cód. GEPE" Binding="{Binding Escola.CodGEPE}" Width="Auto" />
                        <DataGridTextColumn Header="Escola" Binding="{Binding Escola.Nome}" Width="Auto" />
                        <DataGridTextColumn Header="Agrupamento" Binding="{Binding Agrupamento.Nome}" Width="Auto" />
                        <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                        <DataGridTemplateColumn Header="Categorias" Width="Auto" SortMemberPath="Categorias.Count">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- (3.1) Coluna mais larga e com o nome de cada categoria junto do
                                         quadrado colorido (coerente com a legenda e com os outros módulos).
                                         Se o total ultrapassar a largura da coluna, o WrapPanel passa as
                                         restantes categorias para a linha seguinte, dentro da própria célula,
                                         e a linha da grelha cresce em altura automaticamente (ver RowHeight/
                                         MinRowHeight na DataGrid). -->
                                    <ItemsControl ItemsSource="{Binding Categorias}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource BadgeRectStyle}"
                                                        Background="{Binding Categoria.CorHex, Converter={StaticResource HexColorToBrushConverter}}"
                                                        Margin="0,2,6,2">
                                                    <TextBlock Text="{Binding Categoria.Nome}" Style="{StaticResource BadgeTextStyle}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Estado" Width="Auto" SortMemberPath="Estado">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource BadgePillStyle}"
                                            Background="{Binding CorEstado, Converter={StaticResource HexColorToBrushConverter}}">
                                        <TextBlock Text="{Binding Estado}" Style="{StaticResource BadgeTextStyle}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <TextBlock Grid.Row="4" Text="💡 Duplo-clique numa intervenção para ver/editar detalhes ou imprimir o relatório em PDF."
                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,8,0,0" />
        </Grid>
    </DockPanel>
</Window>
