<Window x:Class="LeiriaDISIA.Views.EscolaEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Detalhes da Escola" Height="964" Width="1764" MinHeight="760" MinWidth="1480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource BrushBackground}">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitulo" Grid.Row="0" Text="Detalhes da Escola" Style="{StaticResource SectionTitleStyle}" FontSize="20" Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <!-- Larguras ajustadas: coluna 1 "Identificação" reduzida ainda mais (0.65* em vez de
                 0.8*, já que tem bastante menos campos que a coluna 2) e coluna 4 "Equipamento
                 Informático" aumentada (de 360 para 420), para dar mais espaço à lista de
                 equipamento — a largura da janela foi ajustada em conformidade, para nenhuma
                 coluna ficar cortada. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.65*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- ===================== COLUNA 1 — Identificação ===================== -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Identificação" Style="{StaticResource SectionTitleStyle}" FontSize="14" Margin="0,0,0,6" />

                    <TextBlock Text="Código da Escola (atribuído automaticamente)" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtCodEscola" Margin="0,4,0,10" IsReadOnly="True" Background="#F1F5F9" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Código DGRHE" FontWeight="SemiBold" />
                            <TextBox x:Name="TxtCodDgrhe" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Código GEPE" FontWeight="SemiBold" />
                            <TextBox x:Name="TxtCodGepe" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Nome da Escola" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtNome" Margin="0,4,0,10" />

                    <TextBlock Text="Nome alternativo / abreviado" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtNomeAlternativo" Margin="0,4,0,10" />

                    <TextBlock Text="Agrupamento" FontWeight="SemiBold" />
                    <ComboBox x:Name="CmbAgrupamento" DisplayMemberPath="Nome" Margin="0,4,0,4" />
                    <TextBlock Text="Selecione '(Sem Agrupamento)' se a escola ainda não estiver associada a nenhum."
                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap" />

                    <TextBlock Text="Tipo de Estabelecimento" FontWeight="SemiBold" />
                    <ComboBox x:Name="CmbTipo" Margin="0,4,0,10" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nº Alunos" FontWeight="SemiBold" />
                            <TextBox x:Name="TxtNumAlunos" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Nº Salas" FontWeight="SemiBold" />
                            <TextBox x:Name="TxtNumSalas" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Estado da Escola" FontWeight="SemiBold" />
                    <ComboBox x:Name="CmbEstado" Margin="0,4,0,10" />

                    <CheckBox x:Name="ChkIntegrado" Content="Integrado (JI integrado num edifício de escola básica)"
                              Margin="0,4,0,4" ToolTip="Apenas disponível para Jardins de Infância. JIs integrados não contam para o total de edifícios." />
                </StackPanel>
            </ScrollViewer>

            <!-- ===================== COLUNA 2 — Contactos, Ligações e Coordenadas ===================== -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Contactos e Localização" Style="{StaticResource SectionTitleStyle}" FontSize="14" Margin="0,0,0,6" />

                    <TextBlock Text="Morada" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtMorada" Margin="0,4,0,10" TextChanged="TxtMorada_TextChanged" />

                    <TextBlock Text="Código Postal" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtCodigoPostal" Margin="0,4,0,10" MaxLength="8"
                             ToolTip="Ex.: 2400-000 — ajuda muito a precisão do cálculo de distância" />

                    <!-- Planeamento de Rotas: distância rodoviária até à sede do Município, calculada
                         sob pedido explícito (nunca automaticamente) — ver Services/Rotas. -->
                    <Border Background="#F1F5F9" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📍 Distância à Sede do Município:" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtDistanciaSede" Text="ainda não calculada" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="TxtDataCalculoDistancia" Text="" FontSize="10"
                                       Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnRecalcularDistancia" Content="🔄 Recalcular Distância" FontSize="11"
                                        Padding="8,4" Click="RecalcularDistancia_Click" />
                                <TextBlock x:Name="TxtEstadoRecalculo" VerticalAlignment="Center" Margin="8,0,0,0"
                                           FontSize="10" Foreground="{StaticResource BrushTextSecondary}" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Localidade" FontWeight="SemiBold" />
                            <TextBox x:Name="TxtLocalidade" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Freguesia" FontWeight="SemiBold" />
                            <TextBox x:Name="TxtFreguesia" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Telefone" FontWeight="SemiBold" />
                            <TextBox x:Name="TxtTelefone" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Email" FontWeight="SemiBold" />
                            <TextBox x:Name="TxtEmail" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Latitude" FontWeight="SemiBold" />
                            <TextBox x:Name="TxtLatitude" Margin="0,4,0,0" ToolTip="Ex: 39.7437" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Longitude" FontWeight="SemiBold" />
                            <TextBox x:Name="TxtLongitude" Margin="0,4,0,0" ToolTip="Ex: -8.8071" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Preenchidas automaticamente ao clicar em &quot;🔄 Atualizar Mapa&quot;, ou introduza-as manualmente."
                               FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,14" TextWrapping="Wrap" />

                    <TextBlock Text="Ligações e Equipamento" Style="{StaticResource SectionTitleStyle}" FontSize="14" Margin="0,0,0,6" />

                    <CheckBox x:Name="ChkFibra" Content="Tem internet por fibra" Margin="0,4,0,4" />
                    <StackPanel x:Name="PanelVelocidadeFibra" Margin="22,0,0,8">
                        <TextBlock Text="Velocidade contratada" FontWeight="SemiBold" FontSize="12" />
                        <ComboBox x:Name="CmbVelocidadeFibra" Margin="0,4,0,0" IsEditable="True" Width="220" HorizontalAlignment="Left" />
                    </StackPanel>
                    <CheckBox x:Name="ChkCCTV" Content="Tem CCTV instalado" Margin="0,4" />
                    <CheckBox x:Name="ChkVPN" Content="Tem VPN configurada" Margin="0,4" />
                    <CheckBox x:Name="ChkBiblioteca" Content="Tem biblioteca" Margin="0,4,0,10" />

                    <TextBlock Text="Observações" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtObservacoes" AcceptsReturn="True" Height="90" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Margin="0,4,0,10" />
                </StackPanel>
            </ScrollViewer>

            <!-- ===================== COLUNA 3 — Fotografia e Mapa ===================== -->
            <StackPanel Grid.Column="4">
                <TextBlock Text="Fotografia da Escola" Style="{StaticResource SectionTitleStyle}" FontSize="14" Margin="0,0,0,6" />
                <Border Background="#F1F5F9" Height="190" CornerRadius="8" Margin="0,0,0,8">
                    <Image x:Name="ImgEscola" Stretch="Uniform" Margin="4" />
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Button Content="Escolher Imagem..." Click="EscolherImagem_Click" Margin="0,0,8,0" />
                    <Button Content="Remover Imagem" Click="RemoverImagem_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Localização no Mapa" Style="{StaticResource SectionTitleStyle}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="🔄 Atualizar Mapa" Click="AtualizarMapa_Click" Padding="8,4" FontSize="11" />
                </StackPanel>
                <Border Background="#F1F5F9" Height="260" CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <wv2:WebView2 x:Name="MapaEscola" />
                        <TextBlock x:Name="TxtMapaIndisponivel" Text="Sem coordenadas ou morada suficientes para mostrar o mapa."
                                   TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Margin="20" Foreground="{StaticResource BrushTextSecondary}" Visibility="Collapsed" />
                    </Grid>
                </Border>
                <TextBlock Text="O mapa usa as coordenadas (Latitude/Longitude) se estiverem preenchidas; caso contrário, usa a Morada/Localidade."
                           FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- ===================== COLUNA 4 — Equipamento Informático da Escola ===================== -->
            <StackPanel Grid.Column="6">
                <TextBlock Text="Equipamento Informático" Style="{StaticResource SectionTitleStyle}" FontSize="14" Margin="0,0,0,6" />
                <TextBlock x:Name="TxtTotalEquipamento" Text="0 equipamentos" FontSize="11"
                           Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8" />

                <DataGrid x:Name="GridEquipamento" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" GridLinesVisibility="Horizontal"
                          MinRowHeight="46" EnableRowVirtualization="False"
                          Height="520" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Equipamento" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Tipo}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap">
                                            <Run Text="{Binding Marca}" /> <Run Text="{Binding Modelo}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding NumeroSerie, StringFormat='Nº Série: {0}'}" FontSize="10.5"
                                                   Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Estado}" FontSize="10.5" FontStyle="Italic" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="TxtSemEquipamento" TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}"
                           FontSize="11" Margin="0,8,0,0" Visibility="Collapsed"
                           Text="Esta escola ainda não tem equipamento informático registado." />
                <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,10,0,0"
                           Text="Para adicionar, editar ou mover equipamento, use o módulo &quot;Equipamento Informático&quot;." />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancelar" Click="Cancelar_Click" Margin="0,0,8,0" Padding="16,6" />
            <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Click="Guardar_Click" Padding="16,6" />
        </StackPanel>
    </Grid>
</Window>
